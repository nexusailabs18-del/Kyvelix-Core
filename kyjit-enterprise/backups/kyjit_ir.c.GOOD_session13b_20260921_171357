/* ============================================================
 * Layer 2: Blocks
 * ============================================================ */

KyBlock *kyir_block_create(KyGraph *g) {
    if (!g) return NULL;

    KyBlock *b = (KyBlock *)calloc(1, sizeof(KyBlock));
    if (!b) return NULL;

    b->id = g->block_count;
    b->node_capacity = 16;
    b->nodes = (KyNode **)calloc(b->node_capacity, sizeof(KyNode *));

    if (g->block_count >= g->block_capacity) {
        uint32_t new_cap = g->block_capacity * 2;
        KyBlock **new_arr = (KyBlock **)realloc(g->blocks, new_cap * sizeof(KyBlock *));
        if (!new_arr) { free(b->nodes); free(b); return NULL; }
        g->blocks = new_arr;
        g->block_capacity = new_cap;
    }
    g->blocks[g->block_count++] = b;

    return b;
}

void kyir_block_add_node(KyBlock *b, KyNode *n) {
    /* session9b_terminator_insert */
    /* session12b_auto_terminator */
    if (!b || !n) return;
    if (b->num_nodes >= b->node_capacity) {
        uint32_t new_cap = b->node_capacity ? b->node_capacity * 2 : 16;
        KyNode **new_arr = (KyNode **)realloc(b->nodes, new_cap * sizeof(KyNode *));
        if (!new_arr) return;
        b->nodes = new_arr;
        b->node_capacity = new_cap;
    }

    /* If this block already has a terminator (IF, JUMP, or RETURN),
     * inserting after it would place the node in unreachable code.
     * Insert BEFORE the terminator instead, so all nodes in the
     * block remain reachable. */
    if (b->terminator) {
        uint32_t term_pos = b->num_nodes;
        for (uint32_t i = 0; i < b->num_nodes; i++) {
            if (b->nodes[i] == b->terminator) { term_pos = i; break; }
        }
        if (term_pos < b->num_nodes) {
            for (uint32_t i = b->num_nodes; i > term_pos; i--) {
                b->nodes[i] = b->nodes[i - 1];
            }
            b->nodes[term_pos] = n;
            b->num_nodes++;
            n->block = b;
            return;
        }
    }

    b->nodes[b->num_nodes++] = n;
    n->block = b;

    /* Auto-register terminators. Any block that receives a RETURN, IF,
     * or JUMP as its last node will treat that node as its terminator
     * for future insert-before-terminator logic. This removes the
     * burden on the caller to manually set b->terminator. */
    if (n->opcode == IR_RETURN || n->opcode == IR_IF || n->opcode == IR_JUMP) {
        b->terminator = n;
    }
}

void kyir_block_add_successor(KyBlock *b, KyBlock *succ) {
    if (!b || !succ) return;
    if (b->num_successors >= b->num_succ_capacity) {
        uint16_t new_cap = b->num_succ_capacity ? (uint16_t)(b->num_succ_capacity * 2) : 4;
        KyBlock **new_arr = (KyBlock **)realloc(b->successors, new_cap * sizeof(KyBlock *));
        if (!new_arr) return;
        b->successors = new_arr;
        b->num_succ_capacity = new_cap;
    }
    b->successors[b->num_successors++] = succ;
}

void kyir_block_add_predecessor(KyBlock *b, KyBlock *pred) {
    if (!b || !pred) return;
    if (b->num_predecessors >= b->num_pred_capacity) {
        uint16_t new_cap = b->num_pred_capacity ? (uint16_t)(b->num_pred_capacity * 2) : 4;
        KyBlock **new_arr = (KyBlock **)realloc(b->predecessors, new_cap * sizeof(KyBlock *));
        if (!new_arr) return;
        b->predecessors = new_arr;
        b->num_pred_capacity = new_cap;
    }
    b->predecessors[b->num_predecessors++] = pred;
}

void kyir_block_set_terminator(KyBlock *b, KyNode *n) {
    if (!b || !n) return;
    /* Terminator is the last node in the block */
    kyir_block_add_node(b, n);
}

void kyir_block_print(const KyBlock *b) {
    if (!b) return;
    printf("  b%-3u [%u nodes, %u succ, %u pred]\n",
           b->id, b->num_nodes, b->num_successors, b->num_predecessors);
}

/* ============================================================
 * Layer 3: Dominator Tree
 *
 * Uses the iterative Cooper-Harvey-Kennedy algorithm:
 *   1. Postorder DFS to number blocks
 *   2. Intersect function using postorder numbers
 *   3. Iterate until fixed point
 * ============================================================ */

static uint32_t *g_rpo_num = NULL;
static uint32_t *g_rpo = NULL;
static uint32_t  g_rpo_count = 0;

static void postorder_dfs(KyBlock *b, int *visited, uint32_t *temp_order, uint32_t *temp_count) {
    if (!b || visited[b->id]) return;
    visited[b->id] = 1;
    for (uint16_t i = 0; i < b->num_successors; i++) {
        postorder_dfs(b->successors[i], visited, temp_order, temp_count);
    }
    temp_order[(*temp_count)++] = b->id;
}

/* ============================================================
 * CFG Construction (Phase 2, Session 13a)
 *
 * Populates each block's successors[] and predecessors[] arrays by
 * walking terminators and matching IR_LABEL targets.
 *
 * The IR has labels as IR_LABEL nodes. Each block records an
 * entry_label (the label at its start). This pass:
 *   1. Builds a map: IR_LABEL node id -> block containing that label.
 *   2. For each block's terminator:
 *        IR_IF   -> 2 successors (then-label's block, else-label's block)
 *        IR_JUMP -> 1 successor (target-label's block)
 *        IR_RETURN -> 0 successors
 *   3. Adds deduplicated edges.
 *
 * Idempotent: clears existing successors/predecessors arrays first.
 * Must run BEFORE kyir_domtree_build, which walks these edges.
 * ============================================================ */
void kyir_cfg_build(KyGraph *g) {
    if (!g || g->block_count == 0) return;

    /* label_id -> block */
    KyBlock **label_to_block = (KyBlock **)calloc(g->node_count, sizeof(KyBlock *));
    if (!label_to_block) return;

    /* Pass 1a: entry_label is authoritative for its block. kyir_build_if
     * and kyir_build_jump set the successor block's entry_label to a
     * label whose IR_LABEL node physically lives in the *predecessor*
     * block (the builder adds the node before closing). Indexing by
     * node membership alone would point those edges back at the
     * predecessor (a skipped self-loop) and lose the branch. */
    for (uint32_t bi = 0; bi < g->block_count; bi++) {
        KyBlock *b = g->blocks[bi];
        if (!b) continue;
        if (b->entry_label && b->entry_label->id < g->node_count) {
            label_to_block[b->entry_label->id] = b;
        }
    }

    /* Pass 1b: any IR_LABEL node not claimed by an entry_label is a
     * mid-block label (else body, or a label emitted after the block
     * already had one). Index it by containing block. */
    for (uint32_t bi = 0; bi < g->block_count; bi++) {
        KyBlock *b = g->blocks[bi];
        if (!b) continue;
        for (uint32_t ni = 0; ni < b->num_nodes; ni++) {
            KyNode *n = b->nodes[ni];
            if (!n || n->opcode != IR_LABEL) continue;
            if (n->id < g->node_count && label_to_block[n->id] == NULL) {
                label_to_block[n->id] = b;
            }
        }
    }

    /* Pass 2: reset successors/predecessors, then rebuild */
    for (uint32_t bi = 0; bi < g->block_count; bi++) {
        KyBlock *b = g->blocks[bi];
        if (!b) continue;
        b->num_successors = 0;
        b->num_predecessors = 0;
    }

    for (uint32_t bi = 0; bi < g->block_count; bi++) {
        KyBlock *B = g->blocks[bi];
        if (!B) continue;
        KyNode *t = B->terminator;
        if (!t) continue;

        KyBlock *targets[2] = { NULL, NULL };
        uint32_t n_targets = 0;

        if (t->opcode == IR_IF) {
            if (t->num_values >= 3) {
                KyNode *tl = t->value_inputs[1];
                KyNode *el = t->value_inputs[2];
                if (tl && tl->opcode == IR_LABEL && tl->id < g->node_count)
                    targets[n_targets++] = label_to_block[tl->id];
                if (el && el->opcode == IR_LABEL && el->id < g->node_count)
                    targets[n_targets++] = label_to_block[el->id];
            }
        } else if (t->opcode == IR_JUMP) {
            if (t->num_values >= 1) {
                KyNode *tl = t->value_inputs[0];
                if (tl && tl->opcode == IR_LABEL && tl->id < g->node_count)
                    targets[n_targets++] = label_to_block[tl->id];
            }
        }
        /* IR_RETURN and others: no successors */

        for (uint32_t k = 0; k < n_targets; k++) {
            KyBlock *T = targets[k];
            if (!T || T == B) continue;   /* skip self-loops for now */

            /* Dedup: skip if already present */
            int already = 0;
            for (uint32_t s = 0; s < B->num_successors; s++) {
                if (B->successors[s] == T) { already = 1; break; }
            }
            if (!already) {
                kyir_block_add_successor(B, T);
                kyir_block_add_predecessor(T, B);
            }
        }
    }

    free(label_to_block);
}

KyDomTree *kyir_domtree_build(KyGraph *g) {
    if (!g || g->block_count == 0) return NULL;

    KyDomTree *dt = (KyDomTree *)calloc(1, sizeof(KyDomTree));
    if (!dt) return NULL;

    dt->num_blocks = g->block_count;
    dt->idom = (KyBlock **)calloc(g->block_count, sizeof(KyBlock *));
    dt->dom_depth = (uint32_t *)calloc(g->block_count, sizeof(uint32_t));
    dt->postorder = (uint32_t *)calloc(g->block_count, sizeof(uint32_t));
    dt->postorder_num = (uint32_t *)calloc(g->block_count, sizeof(uint32_t));

    /* 1. Postorder DFS from entry block */
    int *visited = (int *)calloc(g->block_count, sizeof(int));
    uint32_t *temp = (uint32_t *)calloc(g->block_count, sizeof(uint32_t));
    uint32_t temp_count = 0;
    postorder_dfs(g->blocks[0], visited, temp, &temp_count);
    free(visited);

    /* Convert postorder to RPO (reverse postorder) */
    /* RPO[0] = entry (highest number) */
    for (uint32_t i = 0; i < temp_count; i++) {
        uint32_t block_id = temp[temp_count - 1 - i];
        dt->postorder[i] = block_id;
        dt->postorder_num[block_id] = i;
        /* RPO 0 is entry, RPO 1 is next, etc. */
    }
    free(temp);

    /* Set RPO numbers: entry = 0, higher = later */
    g_rpo = dt->postorder;
    g_rpo_num = dt->postorder_num;
    g_rpo_count = temp_count;

    /* 2. Initialize idom: entry has self, others NULL */
    dt->idom[g->blocks[0]->id] = g->blocks[0];
    dt->dom_depth[g->blocks[0]->id] = 0;

    /* 3. Iterate intersect until fixed point */
    int changed = 1;
    int iterations = 0;
    while (changed && iterations < 1000) {
        changed = 0;
        iterations++;
        /* Process in RPO (skip entry) */
        for (uint32_t i = 1; i < g_rpo_count; i++) {
            KyBlock *b = g->blocks[g_rpo[i]];
            if (!b) continue;

            KyBlock *new_idom = NULL;
            for (uint16_t j = 0; j < b->num_predecessors; j++) {
                KyBlock *pred = b->predecessors[j];
                if (!dt->idom[pred->id]) continue;

                if (!new_idom) {
                    new_idom = pred;
                } else {
                    /* Cooper-Harvey-Kennedy intersect */
                    KyBlock *a = new_idom;
                    KyBlock *c = pred;
                    int guard = 0;
                    while (a != c && guard < 10000) {
                        guard++;
                        while (dt->postorder_num[a->id] > dt->postorder_num[c->id]) {
                            if (!dt->idom[a->id] || dt->idom[a->id] == a) break;
                            a = dt->idom[a->id];
                        }
                        while (dt->postorder_num[c->id] > dt->postorder_num[a->id]) {
                            if (!dt->idom[c->id] || dt->idom[c->id] == c) break;
                            c = dt->idom[c->id];
                        }
                    }
                    new_idom = a;
                }
            }
            if (new_idom && dt->idom[b->id] != new_idom) {
                dt->idom[b->id] = new_idom;
                dt->dom_depth[b->id] = dt->dom_depth[new_idom->id] + 1;
                changed = 1;
            }
        }
    }

    return dt;
}

void kyir_domtree_destroy(KyDomTree *dt) {
    if (!dt) return;
    free(dt->idom);
    free(dt->dom_depth);
    free(dt->postorder);
    free(dt->postorder_num);
    free(dt);
}

int kyir_domtree_dominates(KyDomTree *dt, KyBlock *a, KyBlock *b) {
    if (!dt || !a || !b) return 0;
    if (a == b) return 1;

    KyBlock *cur = b;
    uint32_t guard = 0;
    while (cur && cur != a && guard++ < 10000) {
        KyBlock *next = dt->idom[cur->id];
        if (!next || next == cur) break;  /* reached root or self-loop */
        cur = next;
    }
    return cur == a;
}

KyBlock *kyir_domtree_lca(KyDomTree *dt, KyBlock *a, KyBlock *b) {
    if (!dt || !a || !b) return NULL;
    if (a == b) return a;

    /* Walk up from a until it dominates b */
    uint32_t guard = 0;
    while (!kyir_domtree_dominates(dt, a, b) && guard++ < 10000) {
        KyBlock *next = dt->idom[a->id];
        if (!next || next == a) return NULL;
        a = next;
    }
    return (guard < 10000) ? a : NULL;
}


/* ============================================================
 * Layer 5: IR Builder
 * ============================================================ */

KyIRBuilder *kyir_builder_create(KyGraph *g) {
    if (!g) return NULL;

    KyIRBuilder *b = (KyIRBuilder *)calloc(1, sizeof(KyIRBuilder));
    if (!b) return NULL;

    b->graph = g;
    b->var_capacity = 64;
    b->var_nodes = (KyNode **)calloc(b->var_capacity, sizeof(KyNode *));

    /* Find the memory_start node created by kyir_graph_create and
     * initialize the effect chain head. Every subsequent load/store
     * will chain off this. */
    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (n && n->opcode == IR_MEMORY_START) {
            b->current_memory = n;
            break;
        }
    }

    return b;
}

void kyir_builder_destroy(KyIRBuilder *b) {
    if (!b) return;
    free(b->var_nodes);
    free(b->loop_stack);
    free(b);
}

void kyir_builder_set_block(KyIRBuilder *b, KyBlock *block) {
    if (!b || !block) return;
    b->current_block = block;
}

KyNode *kyir_builder_get_var(KyIRBuilder *b, uint32_t var_id) {
    if (!b || var_id >= b->num_vars) return NULL;
    return b->var_nodes[var_id];
}

void kyir_builder_set_var(KyIRBuilder *b, uint32_t var_id, KyNode *value) {
    if (!b) return;
    if (var_id >= b->var_capacity) {
        uint32_t new_cap = b->var_capacity;
        while (new_cap <= var_id) new_cap *= 2;
        KyNode **new_arr = (KyNode **)realloc(b->var_nodes, new_cap * sizeof(KyNode *));
        if (!new_arr) return;
        b->var_nodes = new_arr;
        b->var_capacity = new_cap;
    }
    b->var_nodes[var_id] = value;
    if (var_id >= b->num_vars) b->num_vars = var_id + 1;
}

KyNode *kyir_build_const(KyIRBuilder *b, int64_t value) {
    return kyir_const_i64(b->graph, value);
}

