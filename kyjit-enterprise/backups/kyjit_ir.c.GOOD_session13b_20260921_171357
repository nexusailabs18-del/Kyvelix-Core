/* Generic two-input bitwise/shift op builder.
 * Note: rhs of a shift is treated as a value_input (may be a constant
 * node or a parameter). The selector checks that it's constant. */
static KyNode *kyir_make_binop(KyGraph *g, KyIROpcode op,
                               KyNode *a, KyNode *b) {
    if (!g || !a || !b) return NULL;
    KyNode *n = kyir_node_create(g, op);
    if (!n) return NULL;
    n->type = KYIR_TYPE_INT64;
    kyir_node_add_value_input(n, a);
    kyir_node_add_value_input(n, b);
    kyir_node_add_use(a, n);
    kyir_node_add_use(b, n);
    return n;
}

static KyNode *kyir_make_unop(KyGraph *g, KyIROpcode op, KyNode *a) {
    if (!g || !a) return NULL;
    KyNode *n = kyir_node_create(g, op);
    if (!n) return NULL;
    n->type = KYIR_TYPE_INT64;
    kyir_node_add_value_input(n, a);
    kyir_node_add_use(a, n);
    return n;
}

