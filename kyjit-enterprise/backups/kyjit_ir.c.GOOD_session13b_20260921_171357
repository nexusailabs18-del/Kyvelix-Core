void kyir_ssa_destroy(KySSAContext *ssa) {
    if (!ssa) return;
    if (ssa->var_defs) {
        for (uint32_t i = 0; i < ssa->num_vars; i++) {
            free(ssa->var_defs[i].defs);
        }
        free(ssa->var_defs);
    }
    free(ssa->phis);
    free(ssa);
}

