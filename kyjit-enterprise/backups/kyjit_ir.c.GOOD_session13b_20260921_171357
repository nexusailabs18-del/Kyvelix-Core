KyNode *kyir_const_i64(KyGraph *g, int64_t value) {
    KyNode *n = kyir_node_create(g, IR_CONST_I64);
    if (!n) return NULL;
    n->type = KYIR_TYPE_INT64;
    n->constant.i64 = value;
    return n;
}

/* Build an IR_SYSCALL node: syscall number + up to 6 args.
 * NULL args are skipped (the emitter only moves provided args). */
KyNode *kyir_syscall(KyGraph *g, KyNode *nr,
                     KyNode *a0, KyNode *a1, KyNode *a2,
                     KyNode *a3, KyNode *a4, KyNode *a5) {
    if (!g || !nr) return NULL;

    KyNode *n = kyir_node_create(g, IR_SYSCALL);
    if (!n) return NULL;

    n->flags |= KYIR_FLAG_HAS_SIDE_EFFECT;
    n->type = KYIR_TYPE_INT64;

    kyir_node_add_value_input(n, nr);
    kyir_node_add_use(nr, n);

    KyNode *args[6] = { a0, a1, a2, a3, a4, a5 };
    for (int i = 0; i < 6; i++) {
        if (!args[i]) continue;
        kyir_node_add_value_input(n, args[i]);
        kyir_node_add_use(args[i], n);
    }

    return n;
}

