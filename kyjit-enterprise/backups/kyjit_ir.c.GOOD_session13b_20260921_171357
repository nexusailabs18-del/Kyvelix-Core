void kyir_node_print(const KyNode *n) {
    if (!n) return;
    printf("  n%-4u %-14s", n->id, opcode_name((KyIROpcode)n->opcode));

    if (n->flags & KYIR_FLAG_CONSTANT) {
        if (n->opcode == IR_CONST_I64 || n->opcode == IR_CONST_I32) {
            printf(" = %lld", (long long)n->constant.i64);
        } else if (n->opcode == IR_CONST_F32 || n->opcode == IR_CONST_F64) {
            printf(" = %f", n->constant.f64);
        }
    }

    printf("  [in: %u/%u/%u, out: %u]\n",
           n->num_values, n->num_controls, n->num_effects, n->num_uses);
}

void kyir_graph_print(const KyGraph *g) {
    if (!g) return;
    printf("Graph: %u nodes, %u blocks\n", g->node_count, g->block_count);
    for (uint32_t i = 0; i < g->node_count; i++) {
        kyir_node_print(g->nodes[i]);
    }
}

