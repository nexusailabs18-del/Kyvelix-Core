    if (!ssa) return NULL;

    ssa->graph = g;
    ssa->domtree = dt;
    ssa->num_vars = 64;

    ssa->var_defs = (void *)calloc(ssa->num_vars, sizeof(*ssa->var_defs));
    for (uint32_t i = 0; i < ssa->num_vars; i++) {
        ssa->var_defs[i].capacity = 8;
