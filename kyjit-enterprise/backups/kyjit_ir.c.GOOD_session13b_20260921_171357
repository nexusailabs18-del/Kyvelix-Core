/* ============================================================
 * Graph
 * ============================================================ */

KyGraph *kyir_graph_create(void) {
    KyGraph *g = (KyGraph *)calloc(1, sizeof(KyGraph));
    if (!g) return NULL;

    g->node_capacity = 1024;
    g->nodes = (KyNode **)calloc(g->node_capacity, sizeof(KyNode *));
    if (!g->nodes) { free(g); return NULL; }

    g->block_capacity = 64;
    g->blocks = (KyBlock **)calloc(g->block_capacity, sizeof(KyBlock *));
    if (!g->blocks) { free(g->nodes); free(g); return NULL; }

    /* Create start and end nodes */
    g->start = kyir_node_create(g, IR_START);
    g->end   = kyir_node_create(g, IR_END);

    /* Create memory state bookends — the effect chain's anchors.
     * Every load/store will chain off memory_start; the last one
     * feeds into memory_end. For Session 1 we only create the nodes;
     * later sessions thread them through the selector and add
     * load-after-store elimination. */
    KyNode *mem_start = kyir_node_create(g, IR_MEMORY_START);
    KyNode *mem_end   = kyir_node_create(g, IR_MEMORY_END);
    (void)mem_start;
    (void)mem_end;

    return g;
}

void kyir_graph_destroy(KyGraph *g) {
    if (!g) return;

    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n) continue;
        free(n->value_inputs);
        free(n->control_inputs);
        free(n->effect_inputs);
        free(n->uses);
        free(n);
    }
    for (uint32_t i = 0; i < g->block_count; i++) {
        KyBlock *b = g->blocks[i];
        if (!b) continue;
        free(b->successors);
        free(b->predecessors);
        free(b->nodes);
        free(b);
    }
    free(g->nodes);
    free(g->blocks);
    free(g);
}

/* ============================================================
 * Nodes
 * ============================================================ */

KyNode *kyir_node_create(KyGraph *g, KyIROpcode opcode) {
    if (!g) return NULL;

    KyNode *n = (KyNode *)calloc(1, sizeof(KyNode));
    if (!n) return NULL;

    n->id = g->node_count;
    n->opcode = (uint16_t)opcode;
    n->type = KYIR_TYPE_UNKNOWN;
    n->reg = -1;
    n->stack_slot = -1;

    /* Set default flags based on opcode */
    switch (opcode) {
        case IR_START:
        case IR_END:
        case IR_IF:
        case IR_LOOP:
        case IR_MERGE:
        case IR_RETURN:
        case IR_JUMP:
        case IR_THROW:
        /* Memory bookends are non-value nodes. Marking them as CONTROL
         * makes kyx64_linearize skip vreg creation for them, which
         * prevents their phantom vregs from shifting the allocation
         * order for real nodes (which caused parameter/div interference). */
        case IR_MEMORY_START:
        case IR_MEMORY_END:
            n->flags |= KYIR_FLAG_CONTROL;
            break;
        case IR_STORE:
        case IR_STORE_FIELD:
        case IR_STORE_ELEMENT:
        case IR_CALL:
        case IR_CALL_DIRECT:
        case IR_CALL_INDIRECT:
        case IR_CALL_RUNTIME:
        case IR_NEW_OBJECT:
        case IR_NEW_ARRAY:
        case IR_NEW_CLOSURE:
            n->flags |= KYIR_FLAG_HAS_SIDE_EFFECT;
            break;
        case IR_CONST_I32:
        case IR_CONST_I64:
        case IR_CONST_F32:
        case IR_CONST_F64:
        case IR_CONST_NULL:
        case IR_CONST_UNDEF:
        case IR_CONST_TRUE:
        case IR_CONST_FALSE:
            n->flags |= KYIR_FLAG_CONSTANT;
            break;
        default:
            break;
    }

    /* Grow nodes array */
    if (g->node_count >= g->node_capacity) {
        uint32_t new_cap = g->node_capacity * 2;
        KyNode **new_arr = (KyNode **)realloc(g->nodes, new_cap * sizeof(KyNode *));
        if (!new_arr) { free(n); return NULL; }
        g->nodes = new_arr;
        g->node_capacity = new_cap;
    }
    g->nodes[g->node_count++] = n;

    return n;
}

void kyir_node_add_value_input(KyNode *n, KyNode *input) {
    if (!n || !input) return;
    KyNode **new_arr = (KyNode **)realloc(n->value_inputs,
                                            (n->num_values + 1) * sizeof(KyNode *));
    if (!new_arr) return;
    n->value_inputs = new_arr;
    n->value_inputs[n->num_values++] = input;
}

void kyir_node_add_control_input(KyNode *n, KyNode *input) {
    if (!n || !input) return;
    KyNode **new_arr = (KyNode **)realloc(n->control_inputs,
                                            (n->num_controls + 1) * sizeof(KyNode *));
    if (!new_arr) return;
    n->control_inputs = new_arr;
    n->control_inputs[n->num_controls++] = input;
}

void kyir_node_add_effect_input(KyNode *n, KyNode *input) {
    if (!n || !input) return;
    KyNode **new_arr = (KyNode **)realloc(n->effect_inputs,
                                            (n->num_effects + 1) * sizeof(KyNode *));
    if (!new_arr) return;
    n->effect_inputs = new_arr;
    n->effect_inputs[n->num_effects++] = input;
}

void kyir_node_add_use(KyNode *n, KyNode *use) {
    if (!n || !use) return;
    if (n->num_uses >= n->use_capacity) {
        uint16_t new_cap = n->use_capacity ? (uint16_t)(n->use_capacity * 2) : 4;
        KyNode **new_arr = (KyNode **)realloc(n->uses, new_cap * sizeof(KyNode *));
        if (!new_arr) return;
        n->uses = new_arr;
        n->use_capacity = new_cap;
    }
    n->uses[n->num_uses++] = use;
}

