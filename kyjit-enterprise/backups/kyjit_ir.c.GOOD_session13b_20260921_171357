KyNode *kyir_build_load_field(KyIRBuilder *b, KyNode *obj, int32_t offset) {
    /* session1_chain */
    /* session4_load_advances */
    if (!b || !obj) return NULL;
    KyNode *ld = kyir_node_create(b->graph, IR_LOAD_FIELD);
    if (!ld) return NULL;
    kyir_node_add_value_input(ld, obj);
    kyir_node_add_use(obj, ld);
    ld->constant.i64 = offset;
    ld->type = KYIR_TYPE_INT64;

    /* Effect chain: this load depends on the current memory state.
     * Loads don't MODIFY memory, but we still advance b->current_memory
     * to this load. Two consecutive loads then chain load2 -> load1,
     * which lets find_matching_load (GVN) walk backward and find the
     * earlier identical load. */
    if (b->current_memory) {
        kyir_node_add_effect_input(ld, b->current_memory);
        kyir_node_add_use(b->current_memory, ld);
    }
    b->current_memory = ld;

    if (b->current_block) kyir_block_add_node(b->current_block, ld);
    return ld;
}

KyNode *kyir_build_store_field(KyIRBuilder *b, KyNode *obj, int32_t offset,
                               KyNode *value) {
    /* session1_chain */
    if (!b || !obj || !value) return NULL;
    KyNode *st = kyir_node_create(b->graph, IR_STORE_FIELD);
    if (!st) return NULL;
    kyir_node_add_value_input(st, obj);
    kyir_node_add_value_input(st, value);
    kyir_node_add_use(obj, st);
    kyir_node_add_use(value, st);
    st->constant.i64 = offset;

    /* Effect chain: this store depends on the current memory state.
     * Stores MODIFY memory, so after this store, b->current_memory
     * becomes this node — subsequent loads/stores chain off it. */
    if (b->current_memory) {
        kyir_node_add_effect_input(st, b->current_memory);
        kyir_node_add_use(b->current_memory, st);
    }
    b->current_memory = st;

    if (b->current_block) kyir_block_add_node(b->current_block, st);
    return st;
}

/* ============================================================
 * Branching builders (Phase 2, Session 5)
 *
 * The IR representation:
 *   IR_LABEL  — marks a point in the control flow. Target of jumps.
 *   IR_JUMP   — unconditional jump to an IR_LABEL.
 *   IR_IF     — conditional jump: evaluates cond, jumps to one of
 *               two labels.
 *
 * During kyx64_select:
 *   - Each IR_LABEL gets a fresh KyX64Label. The label's numeric id
 *     is stored in the node's `reg` field.
 *   - IR_JUMP and IR_IF read the target label node's `reg` to find
 *     the KyX64Label.
 * ============================================================ */

/* Forward declaration for block management helper */
static void     kyir_builder_close_block(KyIRBuilder *b, KyNode *terminator);

KyNode *kyir_build_label(KyIRBuilder *b) {
    /* session6_label_entry */
    if (!b) return NULL;
    KyNode *n = kyir_node_create(b->graph, IR_LABEL);
    if (!n) return NULL;
    n->flags |= KYIR_FLAG_CONTROL;
    n->reg = -1;   /* label id assigned during select */
    if (b->current_block) {
        /* If this block has no entry_label yet, this label becomes it.
         * Otherwise this label appears mid-block (e.g. else body of an
         * if) and marks the start of a successor region. */
        if (!b->current_block->entry_label) {
            b->current_block->entry_label = n;
        }
        kyir_block_add_node(b->current_block, n);
    }
    return n;
}

KyNode *kyir_build_jump(KyIRBuilder *b, KyNode *label) {
    /* session6_jump_close */
    if (!b || !label) return NULL;
    if (label->opcode != IR_LABEL) return NULL;
    KyNode *n = kyir_node_create(b->graph, IR_JUMP);
    if (!n) return NULL;
    n->flags |= KYIR_FLAG_CONTROL;
    kyir_node_add_value_input(n, label);
    kyir_node_add_use(label, n);
    if (b->current_block) kyir_block_add_node(b->current_block, n);
    /* Close current block: this jump terminates it. */
    kyir_builder_close_block(b, n);
    /* Start a new block for the code after this point (unreachable
     * from here, but syntactically next in the stream). */
    KyBlock *next = kyir_builder_new_block(b);
    if (next) next->entry_label = label;   /* new block starts at jump target */
    return n;
}

KyNode *kyir_build_jump_no_open(KyIRBuilder *b, KyNode *label) {
    if (!b || !label) return NULL;
    if (label->opcode != IR_LABEL) return NULL;

    KyNode *n = kyir_node_create(b->graph, IR_JUMP);
    if (!n) return NULL;
    n->flags |= KYIR_FLAG_CONTROL;
    kyir_node_add_value_input(n, label);
    kyir_node_add_use(label, n);
    if (b->current_block) kyir_block_add_node(b->current_block, n);

    /* Close current block, but do NOT open a new one. The caller is
     * responsible for entering the next block (typically via
     * kyir_builder_enter_block) — this avoids the orphan block that
     * kyir_build_jump produces when a frontend wants to build the
     * else block next instead of falling through to the jump target. */
    if (b->current_block) {
        b->current_block->terminator = n;
    }
    return n;
}

KyNode *kyir_build_if(KyIRBuilder *b, KyNode *cond,
                      KyNode *then_label, KyNode *else_label) {
    /* session6_if_close */
    if (!b || !cond || !then_label || !else_label) return NULL;
    if (then_label->opcode != IR_LABEL) return NULL;
    if (else_label->opcode != IR_LABEL) return NULL;
    KyNode *n = kyir_node_create(b->graph, IR_IF);
    if (!n) return NULL;
    n->flags |= KYIR_FLAG_CONTROL;
    kyir_node_add_value_input(n, cond);
    kyir_node_add_value_input(n, then_label);
    kyir_node_add_value_input(n, else_label);
    kyir_node_add_use(cond, n);
    kyir_node_add_use(then_label, n);
    kyir_node_add_use(else_label, n);
    if (b->current_block) kyir_block_add_node(b->current_block, n);
    /* Close current block: the IF terminates it. */
    kyir_builder_close_block(b, n);
    /* Start a new block. Since jz goes to else and jmp goes to then,
     * the fallthrough block after the IF is where the "then" body
     * begins — which the caller wires up by adding the then_label
     * next (or by using kyir_builder_new_block explicitly). */
    KyBlock *next = kyir_builder_new_block(b);
    if (next) next->entry_label = then_label;
    return n;
}

/* ============================================================
 * Block management (Phase 2, Session 6)
 *
 * Every time a terminator is emitted (IF, JUMP, RETURN), the
 * current block is closed and a new block is started. The new
 * block becomes the current one, and its entry_label points at
 * the IR_LABEL that will be emitted next.
 *
 * kyx64_select walks b->graph->blocks[] in creation order, which
 * matches emission order for forward-branch control flow.
 * ============================================================ */

static void kyir_builder_close_block(KyIRBuilder *b, KyNode *terminator) {
    if (!b || !b->current_block) return;
    b->current_block->terminator = terminator;
}

KyBlock *kyir_builder_new_block(KyIRBuilder *b) {
    if (!b) return NULL;
    KyBlock *blk = kyir_block_create(b->graph);
    if (!blk) return NULL;
    b->current_block = blk;
    return blk;
}

/* Enter a new block whose entry_label is `label`. Use this instead of
 * kyir_builder_new_block when the new block is the target of a branch
 * (then / else / join / loop-header). The IR_LABEL node must already
 * exist; the caller is still responsible for adding the label node to
 * the block via kyir_block_add_node if the frontend wants the label
 * physically emitted at that position.
 *
 * Why this exists: kyir_build_if and kyir_build_jump create a new
 * block and set its entry_label, but the label's IR_LABEL node stays
 * in whatever block it was created in. This function lets a frontend
 * say "start emitting here, and this label marks it" without needing
 * to reach into the block struct by hand. */
KyBlock *kyir_builder_enter_block(KyIRBuilder *b, KyNode *label) {
    if (!b) return NULL;
    KyBlock *blk = kyir_builder_new_block(b);
    if (!blk) return NULL;
    if (label && label->opcode == IR_LABEL) {
        blk->entry_label = label;
    }
    return blk;
}

KyNode *kyir_build_return(KyIRBuilder *b, KyNode *value) {
    /* session6_return_close */
    if (!b || !value) return NULL;
    KyNode *ret = kyir_node_create(b->graph, IR_RETURN);
    if (!ret) return NULL;
    kyir_node_add_value_input(ret, value);
    kyir_node_add_use(value, ret);
    if (b->current_control) {
        kyir_node_add_control_input(ret, b->current_control);
    }
    if (b->current_block) {
        kyir_block_add_node(b->current_block, ret);
        kyir_builder_close_block(b, ret);
    }
    return ret;
}


/* ============================================================
 * Layer 6: Optimizations
 * ============================================================ */

/* ---------- Utility: replace uses of one node with another ---------- */

void kyir_node_remove_use(KyNode *n, KyNode *use) {
    if (!n || !use) return;
    for (uint16_t i = 0; i < n->num_uses; i++) {
        if (n->uses[i] == use) {
            n->uses[i] = n->uses[n->num_uses - 1];
            n->num_uses--;
            return;
        }
    }
}

void kyir_node_replace_uses(KyGraph *g, KyNode *old_node, KyNode *new_node) {
    if (!g || !old_node || !new_node) return;

    /* Update all uses of old_node to use new_node */
    for (uint16_t u = 0; u < old_node->num_uses; u++) {
        KyNode *user = old_node->uses[u];
        if (!user) continue;

        /* Replace in value_inputs */
        for (uint16_t i = 0; i < user->num_values; i++) {
            if (user->value_inputs[i] == old_node) {
                user->value_inputs[i] = new_node;
                kyir_node_add_use(new_node, user);
            }
        }
        /* Replace in control_inputs */
        for (uint16_t i = 0; i < user->num_controls; i++) {
            if (user->control_inputs[i] == old_node) {
                user->control_inputs[i] = new_node;
            }
        }
        /* Replace in effect_inputs */
        for (uint16_t i = 0; i < user->num_effects; i++) {
            if (user->effect_inputs[i] == old_node) {
                user->effect_inputs[i] = new_node;
            }
        }
    }
    old_node->num_uses = 0;
}

/* Replace all uses of old_node with new_node. If new_node has no block
 * yet and old_node does, place new_node in old_node's block. This is
 * the correct placement for any pass that creates a fresh node as a
 * substitute for an existing one: the fresh node runs where the old
 * one ran, so it belongs in the same block.
 *
 * Any optimization pass that does `new = kyir_const_i64(g, v);
 * kyir_node_replace_uses(g, old, new);` should call this instead. It
 * also marks old_node dead. */
void kyir_replace_with_fresh(KyGraph *g, KyNode *old_node, KyNode *new_node) {
    if (!g || !old_node || !new_node) return;
    if (!new_node->block && old_node->block) {
        kyir_block_add_node(old_node->block, new_node);
    }
    kyir_node_replace_uses(g, old_node, new_node);
    old_node->flags |= KYIR_FLAG_DEAD;
}

int kyir_node_is_constant(const KyNode *n) {
    return n && (n->flags & KYIR_FLAG_CONSTANT);
}

int64_t kyir_node_const_i64(const KyNode *n) {
    if (!n) return 0;
    if (n->opcode == IR_CONST_I32) return (int64_t)n->constant.i32;
    return n->constant.i64;
}

/* ---------- Constant Folding ---------- */

/* session11d_constfold_fixed
 *
 * Constant folding — full coverage.
 *
 *   - Binary ops with both inputs constant: ADD, SUB, MUL, DIV, MOD,
 *     AND, OR, XOR, SHL, SHR, SAR, all comparisons
 *   - Unary ops with constant input: NEG, NOT
 *
 * Guard: skip DIV/MOD by zero.
 *
 * Iterates to fixed point inside the caller (kyir_optimize). Each call
 * to this function does one pass; new constants created by one fold
 * may enable additional folds on the next iteration.
 */
int kyir_opt_constfold(KyGraph *g) {
    if (!g) return 0;
    int changed = 0;

    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n) continue;
        if (n->flags & KYIR_FLAG_DEAD) continue;
        if (n->flags & KYIR_FLAG_HAS_SIDE_EFFECT) continue;
        if (n->flags & KYIR_FLAG_CONTROL) continue;

        int64_t result = 0;
        int folded = 0;

        if (n->num_values == 2) {
            KyNode *a = n->value_inputs[0];
            KyNode *b = n->value_inputs[1];
            if (!kyir_node_is_constant(a) || !kyir_node_is_constant(b)) continue;

            int64_t va = kyir_node_const_i64(a);
            int64_t vb = kyir_node_const_i64(b);

            switch (n->opcode) {
                case IR_ADD_I32:
                case IR_ADD_I64: result = va + vb; folded = 1; break;
                case IR_SUB_I32:
                case IR_SUB_I64: result = va - vb; folded = 1; break;
                case IR_MUL_I32:
                case IR_MUL_I64: result = va * vb; folded = 1; break;
                case IR_DIV_I32:
                case IR_DIV_I64: if (vb != 0) { result = va / vb; folded = 1; } break;
                case IR_MOD_I32:
                case IR_MOD_I64: if (vb != 0) { result = va % vb; folded = 1; } break;
                case IR_AND: result = va & vb; folded = 1; break;
                case IR_OR:  result = va | vb; folded = 1; break;
                case IR_XOR: result = va ^ vb; folded = 1; break;
                case IR_SHL: result = va << (vb & 63); folded = 1; break;
                case IR_SHR: result = (int64_t)((uint64_t)va >> (vb & 63)); folded = 1; break;
                case IR_SAR: result = va >> (vb & 63); folded = 1; break;
                case IR_CMP_EQ: result = (va == vb) ? 1 : 0; folded = 1; break;
                case IR_CMP_NE: result = (va != vb) ? 1 : 0; folded = 1; break;
                case IR_CMP_LT: result = (va <  vb) ? 1 : 0; folded = 1; break;
                case IR_CMP_LE: result = (va <= vb) ? 1 : 0; folded = 1; break;
                case IR_CMP_GT: result = (va >  vb) ? 1 : 0; folded = 1; break;
                case IR_CMP_GE: result = (va >= vb) ? 1 : 0; folded = 1; break;
                default: break;
            }
        } else if (n->num_values == 1) {
            KyNode *a = n->value_inputs[0];
            if (!kyir_node_is_constant(a)) continue;
            int64_t va = kyir_node_const_i64(a);

            switch (n->opcode) {
                case IR_NEG_I32:
                case IR_NEG_I64: result = -va; folded = 1; break;
                case IR_NOT:     result = ~va; folded = 1; break;
                default: break;
            }
        } else {
            continue;
        }

        if (folded) {
            KyNode *c = kyir_const_i64(g, result);
            if (!c) continue;
            kyir_replace_with_fresh(g, n, c);
            changed++;
        }
    }
    return changed;
}

/* ---------- Algebraic Simplify ---------- */

static int is_const_zero(KyNode *n) {
    return kyir_node_is_constant(n) && kyir_node_const_i64(n) == 0;
}

static int is_const_one(KyNode *n) {
    return kyir_node_is_constant(n) && kyir_node_const_i64(n) == 1;
}

/* session11d_algebraic_fixed
 *
 * Algebraic simplification — full identity set.
 *
 *   ADD:  x + 0  → x        (either side)
 *   SUB:  x - 0  → x,  x - x → 0
 *   MUL:  x * 0  → 0,  x * 1 → x
 *   AND:  x & 0  → 0,  x & x → x,  x & -1 → x
 *   OR:   x | 0  → x,  x | -1 → -1, x | x → x
 *   XOR:  x ^ 0  → x,  x ^ x → 0
 *   SHL:  x << 0 → x
 *   SHR:  x >> 0 → x
 *   SAR:  x >>a 0 → x
 *   NEG:  -(-x) → x
 *   NOT:  ~(~x) → x
 *
 * Iterates inside kyir_optimize. One pass per call.
 */
int kyir_opt_algebraic(KyGraph *g) {
    if (!g) return 0;
    int changed = 0;

    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
        if (n->flags & (KYIR_FLAG_HAS_SIDE_EFFECT | KYIR_FLAG_CONTROL)) continue;

        KyNode *replacement = NULL;

        if (n->num_values == 2) {
            KyNode *a = n->value_inputs[0];
            KyNode *b = n->value_inputs[1];

            switch (n->opcode) {
                case IR_ADD_I32: case IR_ADD_I64:
                    if (is_const_zero(a)) replacement = b;
                    else if (is_const_zero(b)) replacement = a;
                    break;

                case IR_SUB_I32: case IR_SUB_I64:
                    if (a == b) {
                        replacement = kyir_const_i64(g, 0);
                    } else if (is_const_zero(b)) {
                        replacement = a;
                    }
                    break;

                case IR_MUL_I32: case IR_MUL_I64:
                    if (is_const_zero(a) || is_const_zero(b)) {
                        replacement = kyir_const_i64(g, 0);
                    } else if (is_const_one(a)) {
                        replacement = b;
                    } else if (is_const_one(b)) {
                        replacement = a;
                    }
                    break;

                case IR_AND:
                    if (a == b) replacement = a;
                    else if (is_const_zero(a) || is_const_zero(b)) {
                        replacement = kyir_const_i64(g, 0);
                    } else if (kyir_node_is_constant(a) &&
                               kyir_node_const_i64(a) == -1) {
                        replacement = b;
                    } else if (kyir_node_is_constant(b) &&
                               kyir_node_const_i64(b) == -1) {
                        replacement = a;
                    }
                    break;

                case IR_OR:
                    if (a == b) replacement = a;
                    else if (is_const_zero(a)) replacement = b;
                    else if (is_const_zero(b)) replacement = a;
                    else if (kyir_node_is_constant(a) &&
                             kyir_node_const_i64(a) == -1) {
                        replacement = a;
                    } else if (kyir_node_is_constant(b) &&
                               kyir_node_const_i64(b) == -1) {
                        replacement = b;
                    }
                    break;

                case IR_XOR:
                    if (a == b) replacement = kyir_const_i64(g, 0);
                    else if (is_const_zero(a)) replacement = b;
                    else if (is_const_zero(b)) replacement = a;
                    break;

                case IR_SHL:
                case IR_SHR:
                case IR_SAR:
                    if (is_const_zero(b)) replacement = a;
                    break;

                default: break;
            }
        } else if (n->num_values == 1) {
            KyNode *a = n->value_inputs[0];

            switch (n->opcode) {
                case IR_NEG_I32: case IR_NEG_I64:
                    if (a && a->opcode == IR_NEG_I64) {
                        replacement = a->value_inputs[0];
                    } else if (a && a->opcode == IR_NEG_I32) {
                        replacement = a->value_inputs[0];
                    }
                    break;
                case IR_NOT:
                    if (a && a->opcode == IR_NOT) {
                        replacement = a->value_inputs[0];
                    }
                    break;
                default: break;
            }
        }

        if (replacement && replacement != n) {
            kyir_replace_with_fresh(g, n, replacement);
            changed++;
        }
    }
    return changed;
}

/* ---------- Dead Code Elimination ---------- */

/* session11a_dce_fixed
 *
 * Dead Code Elimination (fixed-point).
 *
 * A node is dead if it has no uses AND cannot affect program behavior:
 *   - not a side-effecting node (flags & HAS_SIDE_EFFECT)
 *   - not a control node (flags & CONTROL)
 *   - not one of the Start/End/Memory placeholders
 *
 * Iterates to fixed point because removing one node may make its inputs
 * unused, which are then removed in the next round. Capped at 50
 * iterations to prevent infinite loops.
 *
 * Removes the dead node from all its inputs' uses[] arrays (value,
 * effect, control) so input use counts stay accurate. */
int kyir_opt_dce(KyGraph *g) {
    if (!g) return 0;
    int total_changes = 0;
    int iteration = 0;
    int changed;

    do {
        changed = 0;
        for (uint32_t i = 0; i < g->node_count; i++) {
            KyNode *n = g->nodes[i];
            if (!n) continue;
            if (n->flags & KYIR_FLAG_DEAD) continue;

            /* Skip side-effecting nodes (stores, calls, syscalls, etc.) */
            if (n->flags & KYIR_FLAG_HAS_SIDE_EFFECT) continue;

            /* Skip control nodes (branches, returns, labels) */
            if (n->flags & KYIR_FLAG_CONTROL) continue;

            /* Skip placeholders — they anchor the graph */
            if (n->opcode == IR_START || n->opcode == IR_END) continue;
            if (n->opcode == IR_MEMORY_START || n->opcode == IR_MEMORY_END) continue;

            /* If it has no uses, it's dead */
            if (n->num_uses == 0) {
                n->flags |= KYIR_FLAG_DEAD;

                /* Remove this node from all its inputs' uses[] arrays */
                for (uint16_t j = 0; j < n->num_values; j++) {
                    if (n->value_inputs[j])
                        kyir_node_remove_use(n->value_inputs[j], n);
                }
                for (uint16_t j = 0; j < n->num_effects; j++) {
                    if (n->effect_inputs[j])
                        kyir_node_remove_use(n->effect_inputs[j], n);
                }
                for (uint16_t j = 0; j < n->num_controls; j++) {
                    if (n->control_inputs[j])
                        kyir_node_remove_use(n->control_inputs[j], n);
                }
                changed++;
            }
        }
        total_changes += changed;
        iteration++;
    } while (changed > 0 && iteration < 50);

    return total_changes;
}

/* ---------- Global Value Numbering (basic) ---------- */

/* session11b_gvn_fixed
 *
 * Global Value Numbering (fixed-point).
 *
 * Merges nodes that compute the same value:
 *   - same opcode
 *   - same num_values, num_effects, num_controls
 *   - same value_inputs (commutativity for ADD/SUB-no, MUL, AND, OR, XOR)
 *   - same effect_inputs (CRITICAL — two loads with different effect
 *     chains are NOT equivalent)
 *   - same block (restricting GVN to a single block avoids the
 *     dominance issues of cross-block merging)
 *   - not side-effecting, not control
 *   - not constants (they're already unique via const folding)
 *
 * Iterates because replacing one node may make other duplicates appear
 * eligible (e.g. after node X is merged into Y, X's users may now match
 * a different Y'). Caps at 50 rounds.
 *
 * Does NOT recurse into replacing uses of the replacement — that's what
 * the iteration handles.
 */
static int gvn_is_commutative(uint16_t opcode) {
    return opcode == IR_ADD_I32 || opcode == IR_ADD_I64 ||
           opcode == IR_MUL_I32 || opcode == IR_MUL_I64 ||
           opcode == IR_AND || opcode == IR_OR || opcode == IR_XOR;
}

int kyir_opt_gvn(KyGraph *g) {
    if (!g) return 0;
    int total_changes = 0;
    int iteration = 0;
    int changed;

    do {
        changed = 0;
        for (uint32_t i = 0; i < g->node_count; i++) {
            KyNode *a = g->nodes[i];
            if (!a || (a->flags & KYIR_FLAG_DEAD)) continue;
            if (a->flags & (KYIR_FLAG_HAS_SIDE_EFFECT | KYIR_FLAG_CONTROL)) continue;
            if (kyir_node_is_constant(a)) continue;

            for (uint32_t j = i + 1; j < g->node_count; j++) {
                KyNode *b = g->nodes[j];
                if (!b || (b->flags & KYIR_FLAG_DEAD)) continue;
                if (b->opcode != a->opcode) continue;
                if (b->num_values  != a->num_values)  continue;
                if (b->num_effects != a->num_effects) continue;
                if (b->num_controls != a->num_controls) continue;
                if (b->block != a->block) continue;

                /* session11b_gvn_const_fix:
                 * Compare constant payload. IR_PARAMETER uses it to
                 * store the arg index; IR_CONST_* uses it for the value.
                 * Without this check, param0 and param1 would be seen
                 * as equivalent (both have 0 value inputs). */
                if (a->constant.i64 != b->constant.i64) continue;

                /* Compare effect inputs (order matters) */
                int same = 1;
                for (uint16_t k = 0; k < a->num_effects; k++) {
                    if (a->effect_inputs[k] != b->effect_inputs[k]) {
                        same = 0; break;
                    }
                }
                if (!same) continue;

                /* Compare control inputs */
                for (uint16_t k = 0; k < a->num_controls; k++) {
                    if (a->control_inputs[k] != b->control_inputs[k]) {
                        same = 0; break;
                    }
                }
                if (!same) continue;

                /* Compare value inputs, with commutative swap for
                 * binary commutative ops. */
                for (uint16_t k = 0; k < a->num_values; k++) {
                    if (a->value_inputs[k] != b->value_inputs[k]) {
                        int swapped = 0;
                        if (gvn_is_commutative(a->opcode) && a->num_values == 2) {
                            if (a->value_inputs[0] == b->value_inputs[1] &&
                                a->value_inputs[1] == b->value_inputs[0]) {
                                swapped = 1;
                            }
                        }
                        if (!swapped) { same = 0; break; }
                    }
                }
                if (!same) continue;

                /* Merge b into a */
                kyir_node_replace_uses(g, b, a);
                b->flags |= KYIR_FLAG_DEAD;
                changed++;
            }
        }
        total_changes += changed;
        iteration++;
    } while (changed > 0 && iteration < 50);

    return total_changes;
}

/* session12a_cse_across_blocks
 *
 * CSE across basic blocks (dominance-based GVN).
 *
 * Extends GVN: two equivalent nodes can be merged even if they live in
 * DIFFERENT blocks, as long as the earlier one's block dominates the
 * later one's block. That guarantees the earlier node's value is
 * computed before the later node would run.
 *
 * Equivalence criteria (same as GVN):
 *   - same opcode
 *   - same num_values, num_effects, num_controls
 *   - same value inputs (commutative swap for ADD/MUL/AND/OR/XOR)
 *   - same effect inputs
 *   - same control inputs
 *   - same constant payload
 *   - neither node side-effecting, control, or constant
 *
 * Iterates to fixed point because merges can enable more merges.
 * Requires a dominator tree.
 */
static int cse_nodes_equivalent(KyNode *a, KyNode *b) {
    if (a == b) return 0;
    if (a->opcode != b->opcode) return 0;
    if (a->num_values   != b->num_values)   return 0;
    if (a->num_effects  != b->num_effects)  return 0;
    if (a->num_controls != b->num_controls) return 0;
    if (a->constant.i64 != b->constant.i64) return 0;

    for (uint16_t k = 0; k < a->num_effects; k++) {
        if (a->effect_inputs[k] != b->effect_inputs[k]) return 0;
    }
    for (uint16_t k = 0; k < a->num_controls; k++) {
        if (a->control_inputs[k] != b->control_inputs[k]) return 0;
    }

    if (a->num_values == 2 && gvn_is_commutative(a->opcode)) {
        if (a->value_inputs[0] == b->value_inputs[0] &&
            a->value_inputs[1] == b->value_inputs[1]) return 1;
        if (a->value_inputs[0] == b->value_inputs[1] &&
            a->value_inputs[1] == b->value_inputs[0]) return 1;
        return 0;
    }

    for (uint16_t k = 0; k < a->num_values; k++) {
        if (a->value_inputs[k] != b->value_inputs[k]) return 0;
    }
    return 1;
}

int kyir_opt_cse_across_blocks(KyGraph *g, KyDomTree *dt) {
    if (!g || !dt) return 0;
    int total_changes = 0;
    int iteration = 0;
    int changed;

    do {
        changed = 0;
        for (uint32_t i = 0; i < g->node_count; i++) {
            KyNode *a = g->nodes[i];
            if (!a || (a->flags & KYIR_FLAG_DEAD)) continue;
            if (a->flags & (KYIR_FLAG_HAS_SIDE_EFFECT | KYIR_FLAG_CONTROL)) continue;
            if (kyir_node_is_constant(a)) continue;
            if (!a->block) continue;

            for (uint32_t j = i + 1; j < g->node_count; j++) {
                KyNode *b = g->nodes[j];
                if (!b || (b->flags & KYIR_FLAG_DEAD)) continue;
                if (b->flags & (KYIR_FLAG_HAS_SIDE_EFFECT | KYIR_FLAG_CONTROL)) continue;
                if (kyir_node_is_constant(b)) continue;
                if (!b->block) continue;
                if (a->block == b->block) continue;   /* same-block GVN handles this */

                if (!cse_nodes_equivalent(a, b)) continue;

                /* Only merge if a's block dominates b's block */
                if (!kyir_domtree_dominates(dt, a->block, b->block)) continue;

                kyir_node_replace_uses(g, b, a);
                b->flags |= KYIR_FLAG_DEAD;
                changed++;
            }
        }
        total_changes += changed;
        iteration++;
    } while (changed > 0 && iteration < 50);

    return total_changes;
}

/* session12b_strength_reduce
 *
 * Strength reduction: replace expensive operations with cheaper ones.
 *
 * Currently supported:
 *   x * 2^n  →  x << n      (for constant power-of-two multiplier)
 *
 * SAFE for all x, signed or unsigned — multiplication and left shift
 * are bit-identical.
 *
 * NOT implemented (unsafe without unsigned-arithmetic guarantee):
 *   x / 2^n  →  x >> n      (signed division truncates toward zero,
 *                            arithmetic shift rounds toward -inf)
 *   x % 2^n  →  x & (2^n-1)
 *
 * The multiplication case is checked on both sides of the multiply for
 * symmetry. If both sides are powers of two, we reduce the second
 * (multiplier) side and keep the first as-is.
 *
 * Returns count of reductions. Runs once; iterate in the caller if
 * cascading reductions matter.
 */
int kyir_opt_strength_reduce(KyGraph *g) {
    if (!g) return 0;
    int changed = 0;

    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
        if (n->flags & (KYIR_FLAG_HAS_SIDE_EFFECT | KYIR_FLAG_CONTROL)) continue;

        if (n->opcode != IR_MUL_I64 && n->opcode != IR_MUL_I32) continue;
        if (n->num_values != 2) continue;

        KyNode *a = n->value_inputs[0];
        KyNode *b = n->value_inputs[1];
        if (!a || !b) continue;

        /* Determine which side (if any) is a power-of-two constant. */
        KyNode *base = NULL;
        KyNode *const_side = NULL;

        if (kyir_node_is_constant(b)) {
            base = a;
            const_side = b;
        } else if (kyir_node_is_constant(a)) {
            base = b;
            const_side = a;
        } else {
            continue;
        }

        int64_t c = kyir_node_const_i64(const_side);
        if (c <= 0) continue;                    /* only positive */
        if ((c & (c - 1)) != 0) continue;         /* not a power of two */

        /* n = log2(c) */
        int32_t n_bits = 0;
        int64_t t = c;
        while (t > 1) { t >>= 1; n_bits++; }

        if (n_bits == 0) continue;                /* c == 1 — algebraic handles this */

        /* session12b_block_fix:
         * Add both the shift-amount constant AND the SHL node to the
         * multiply's block so they're emitted in the right place. If
         * shift_amt weren't in a block, it would be appended as a
         * leftover at the very end of the emit order, after the SHL
         * that uses it — a use-before-def across blocks. */
        KyNode *shift_amt = kyir_const_i64(g, n_bits);
        if (!shift_amt) continue;

        KyNode *shl = kyir_node_create(g, IR_SHL);
        if (!shl) continue;
        shl->type = KYIR_TYPE_INT64;
        kyir_node_add_value_input(shl, base);
        kyir_node_add_value_input(shl, shift_amt);
        kyir_node_add_use(base, shl);
        kyir_node_add_use(shift_amt, shl);
        if (n->block) {
            kyir_block_add_node(n->block, shift_amt);
            kyir_block_add_node(n->block, shl);
        }

        /* Replace uses of n with shl */
        kyir_node_replace_uses(g, n, shl);
        n->flags |= KYIR_FLAG_DEAD;
        changed++;
    }

    return changed;
}

/* ---------- Optimize Driver ---------- */

int kyir_optimize(KyGraph *g) {
    if (!g) return 0;
    int total_changes = 0;
    int iteration = 0;
    int changed;

    do {
        changed = 0;
        changed |= kyir_opt_constfold(g);
        changed |= kyir_opt_algebraic(g);
        changed |= kyir_opt_gvn(g);
        changed |= kyir_opt_dce(g);
        total_changes += changed;
        iteration++;
    } while (changed > 0 && iteration < 20);

    return total_changes;
}

/* ============================================================
 * Layer 7: Graph Verifier
 * ============================================================ */

/* session10_verify_extended */

/* Helper: recursive DFS to detect use-def cycles in SSA. */
static int detect_cycle_dfs(KyNode *n, uint8_t *state, uint32_t *guard) {
    /* state[]: 0 = unvisited, 1 = in-progress, 2 = done */
    if (!n) return 0;
    if ((*guard)++ > 1000000) return 1;   /* runaway guard */

    if (state[n->id] == 1) return 1;   /* back edge: cycle */
    if (state[n->id] == 2) return 0;   /* already done */

    state[n->id] = 1;
    for (uint16_t i = 0; i < n->num_values; i++) {
        if (detect_cycle_dfs(n->value_inputs[i], state, guard)) return 1;
    }
    for (uint16_t i = 0; i < n->num_effects; i++) {
        if (detect_cycle_dfs(n->effect_inputs[i], state, guard)) return 1;
    }
    /* Note: we don't traverse control_inputs — those CAN form cycles in
     * loops. Only use-def (value + effect) must be acyclic in SSA. */
    state[n->id] = 2;
    return 0;
}

KyVerifyResult kyir_graph_verify(KyGraph *g) {
    KyVerifyResult r;
    memset(&r, 0, sizeof(r));
    r.ok = 1;

    if (!g) {
        r.ok = 0;
        snprintf(r.messages[r.errors++], 128, "graph is NULL");
        return r;
    }

    /* --- Check 1: node-level consistency --- */
    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n) {
            r.ok = 0;
            snprintf(r.messages[r.errors++], 128, "node %u is NULL", i);
            if (r.errors >= 16) break;
            continue;
        }
        if (n->id != i) {
            r.ok = 0;
            snprintf(r.messages[r.errors++], 128,
                     "node at %u has id %u", i, n->id);
            if (r.errors >= 16) break;
        }
        for (uint16_t j = 0; j < n->num_values; j++) {
            if (!n->value_inputs[j]) {
                r.ok = 0;
                snprintf(r.messages[r.errors++], 128,
                         "node %u has NULL value input %u", n->id, j);
                if (r.errors >= 16) break;
            }
        }
        if (r.errors >= 16) break;
    }

    if (r.errors > 0) return r;

    /* --- Check 2: reachability ---
     * session10_reach_by_block
     *
     * In our IR, Start and End are placeholders — nothing connects to
     * them via value/control/effect edges. The actual connectivity is
     * block membership: every node added via kyir_block_add_node has
     * n->block set. A node is reachable if:
     *   - it is a placeholder (Start, End, Memory_Start, Memory_End)
     *   - OR it is in a block (n->block != NULL)
     *   - OR it has uses (something references it)
     *
     * A node with no block, no uses, and not a placeholder is orphaned. */
    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n) continue;
        if (n == g->start || n == g->end) continue;
        if (n->opcode == IR_MEMORY_START || n->opcode == IR_MEMORY_END) continue;
        if (n->block) continue;
        if (n->num_uses > 0) continue;
        r.ok = 0;
        snprintf(r.messages[r.errors++], 128,
                 "node %u (opcode %u) unreachable: no block, no uses",
                 n->id, n->opcode);
        if (r.errors >= 16) break;
    }
    if (r.errors > 0) return r;

    /* --- Check 3: use-def cycles --- */
    uint8_t *state = (uint8_t *)calloc(g->node_count, 1);
    if (state) {
        uint32_t guard = 0;
        for (uint32_t i = 0; i < g->node_count; i++) {
            if (g->nodes[i] && state[g->nodes[i]->id] == 0) {
                if (detect_cycle_dfs(g->nodes[i], state, &guard)) {
                    r.ok = 0;
                    snprintf(r.messages[r.errors++], 128,
                             "cycle in use-def detected at node %u",
                             g->nodes[i]->id);
                    break;
                }
            }
        }
        free(state);
    }
    if (r.errors > 0) return r;

    /* --- Check 5 (session10_ubd_check): use-before-def within block ---
     * For each block, every node's same-block value inputs must appear
     * earlier in the block's node list. If not, reordering failed (or
     * a use-def cycle exists within the block). */
    for (uint32_t bi = 0; bi < g->block_count; bi++) {
        KyBlock *blk = g->blocks[bi];
        if (!blk) continue;
        for (uint32_t ni = 0; ni < blk->num_nodes; ni++) {
            KyNode *N = blk->nodes[ni];
            if (!N) continue;
            for (uint16_t vi = 0; vi < N->num_values; vi++) {
                KyNode *V = N->value_inputs[vi];
                if (!V || V->block != blk) continue;
                int32_t v_pos = -1;
                for (uint32_t j = 0; j < blk->num_nodes; j++) {
                    if (blk->nodes[j] == V) { v_pos = (int32_t)j; break; }
                }
                if (v_pos < 0 || (uint32_t)v_pos > ni) {
                    r.ok = 0;
                    snprintf(r.messages[r.errors++], 128,
                             "use-before-def: node %u (block %u, pos %u) "
                             "reads node %u defined later",
                             N->id, bi, ni, V->id);
                    if (r.errors >= 16) break;
                }
            }
            if (r.errors >= 16) break;
        }
        if (r.errors >= 16) break;
    }
    if (r.errors > 0) return r;

    /* --- Check 4: terminator consistency --- */
    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n) continue;
        if (n->opcode == IR_IF) {
            if (n->num_values < 3) {
                r.ok = 0;
                snprintf(r.messages[r.errors++], 128,
                         "IR_IF node %u has %u inputs (need 3)",
                         n->id, n->num_values);
            }
        } else if (n->opcode == IR_JUMP) {
            if (n->num_values < 1) {
                r.ok = 0;
                snprintf(r.messages[r.errors++], 128,
                         "IR_JUMP node %u has no target", n->id);
            }
        } else if (n->opcode == IR_RETURN) {
            if (n->num_values < 1) {
                r.ok = 0;
                snprintf(r.messages[r.errors++], 128,
                         "IR_RETURN node %u has no value", n->id);
            }
        }
        if (r.errors >= 16) break;
    }

    return r;
}


/* ============================================================
 * Layer 8: Dominance Frontier
 *
 * DF(X) = { Y | X dominates a predecessor of Y, but X does not
 *            strictly dominate Y }
 *
 * Algorithm (Cooper-Harvey-Kennedy):
 *   for each block Y:
 *       for each predecessor P of Y:
 *           runner = P
 *           while runner != idom(Y):
 *               add Y to DF(runner)
 *               runner = idom(runner)
 * ============================================================ */

KyDominanceFrontier *kyir_domfrontier_build(KyGraph *g, KyDomTree *dt) {
    if (!g || !dt) return NULL;

    KyDominanceFrontier *df = (KyDominanceFrontier *)calloc(g->block_count,
                                                             sizeof(KyDominanceFrontier));
    if (!df) return NULL;

    for (uint32_t i = 0; i < g->block_count; i++) {
        df[i].num_blocks = 0;
        df[i].capacity = 4;
        df[i].frontier = (KyBlock **)calloc(df[i].capacity, sizeof(KyBlock *));
    }

    for (uint32_t i = 0; i < g->block_count; i++) {
        KyBlock *y = g->blocks[i];
        if (!y || y->num_predecessors < 2) continue;

        for (uint16_t j = 0; j < y->num_predecessors; j++) {
            KyBlock *p = y->predecessors[j];
            KyBlock *runner = p;
            uint32_t guard = 0;
            while (runner && runner != dt->idom[y->id] && guard++ < 10000) {
                /* Add y to DF(runner) */
                KyDominanceFrontier *f = &df[runner->id];
                int found = 0;
                for (uint32_t k = 0; k < f->num_blocks; k++) {
                    if (f->frontier[k] == y) { found = 1; break; }
                }
                if (!found) {
                    if (f->num_blocks >= f->capacity) {
                        f->capacity *= 2;
                        f->frontier = (KyBlock **)realloc(f->frontier,
                                        f->capacity * sizeof(KyBlock *));
                    }
                    f->frontier[f->num_blocks++] = y;
                }
                KyBlock *next = dt->idom[runner->id];
                if (!next || next == runner) break;
                runner = next;
            }
        }
    }

    return df;
}

void kyir_domfrontier_destroy(KyDominanceFrontier *df) {
    if (!df) return;
    /* df is an array — need to free inner arrays */
    /* We don't know the count here, but the caller knows */
    /* For safety, we free the array of frontiers externally */
    free(df);
}

