/* ============================================================
 * Layer 9: Loop Detection
 * ============================================================ */

/* Check if a block is in the loop body */
static int loop_has_block(KyLoop *loop, KyBlock *b) {
    for (uint32_t i = 0; i < loop->num_body; i++) {
        if (loop->body[i] == b) return 1;
    }
    return 0;
}

/* Add block to loop body */
static void loop_add_block(KyLoop *loop, KyBlock *b) {
    if (loop_has_block(loop, b)) return;
    if (loop->num_body >= loop->body_capacity) {
        loop->body_capacity *= 2;
        loop->body = (KyBlock **)realloc(loop->body,
                                          loop->body_capacity * sizeof(KyBlock *));
    }
    loop->body[loop->num_body++] = b;
}

/* Add exit to loop */
static void loop_add_exit(KyLoop *loop, KyBlock *b) {
    for (uint32_t i = 0; i < loop->num_exits; i++) {
        if (loop->exits[i] == b) return;
    }
    if (loop->num_exits >= loop->exit_capacity) {
        loop->exit_capacity = loop->exit_capacity ? loop->exit_capacity * 2 : 4;
        loop->exits = (KyBlock **)realloc(loop->exits,
                                          loop->exit_capacity * sizeof(KyBlock *));
    }
    loop->exits[loop->num_exits++] = b;
}

/* Find natural loop for back edge b -> h */
static KyLoop *find_natural_loop(KyGraph *g, KyBlock *h, KyBlock *b) {
    (void)g;

    KyLoop *loop = (KyLoop *)calloc(1, sizeof(KyLoop));
    if (!loop) return NULL;

    loop->header = h;
    loop->latch = b;
    loop->body_capacity = 8;
    loop->body = (KyBlock **)calloc(loop->body_capacity, sizeof(KyBlock *));
    loop->exit_capacity = 4;
    loop->exits = (KyBlock **)calloc(loop->exit_capacity, sizeof(KyBlock *));
    loop->child_capacity = 4;
    loop->children = (KyLoop **)calloc(loop->child_capacity, sizeof(KyLoop *));

    /* Start from header */
    loop_add_block(loop, h);

    if (b == h) return loop;

    /* Worklist: start from latch, add predecessors that aren't in loop */
    KyBlock **stack = (KyBlock **)calloc(1024, sizeof(KyBlock *));
    uint32_t stack_top = 0;
    stack[stack_top++] = b;

    while (stack_top > 0) {
        KyBlock *n = stack[--stack_top];
        if (loop_has_block(loop, n)) continue;

        loop_add_block(loop, n);

        for (uint16_t i = 0; i < n->num_predecessors; i++) {
            KyBlock *p = n->predecessors[i];
            if (!loop_has_block(loop, p)) {
                if (stack_top < 1024) {
                    stack[stack_top++] = p;
                }
            }
        }
    }
    free(stack);

    /* Find exits: successors outside the loop */
    for (uint32_t i = 0; i < loop->num_body; i++) {
        KyBlock *bb = loop->body[i];
        for (uint16_t j = 0; j < bb->num_successors; j++) {
            KyBlock *succ = bb->successors[j];
            if (!loop_has_block(loop, succ)) {
                loop_add_exit(loop, succ);
            }
        }
    }

    return loop;
}

/* Add loop to loop info */
static void loopinfo_add(KyLoopInfo *li, KyLoop *loop) {
    if (li->num_loops >= li->capacity) {
        li->capacity = li->capacity ? li->capacity * 2 : 8;
        li->loops = (KyLoop **)realloc(li->loops, li->capacity * sizeof(KyLoop *));
    }
    li->loops[li->num_loops++] = loop;
}

KyLoopInfo *kyir_loopinfo_build(KyGraph *g, KyDomTree *dt) {
    if (!g || !dt) return NULL;

    KyLoopInfo *li = (KyLoopInfo *)calloc(1, sizeof(KyLoopInfo));
    if (!li) return NULL;

    li->capacity = 8;
    li->loops = (KyLoop **)calloc(li->capacity, sizeof(KyLoop *));
    li->block_loop = (KyLoop **)calloc(g->block_count, sizeof(KyLoop *));

    /* Step 1: find back edges */
    for (uint32_t i = 0; i < g->block_count; i++) {
        KyBlock *b = g->blocks[i];
        if (!b) continue;

        for (uint16_t j = 0; j < b->num_successors; j++) {
            KyBlock *succ = b->successors[j];

            /* Back edge: b -> succ where succ dominates b */
            if (kyir_domtree_dominates(dt, succ, b)) {
                /* Find or create loop for this header */
                KyLoop *existing = NULL;
                for (uint32_t k = 0; k < li->num_loops; k++) {
                    if (li->loops[k]->header == succ) {
                        existing = li->loops[k];
                        break;
                    }
                }

                if (existing) {
                    /* Merge: add blocks from new loop to existing */
                    KyLoop *new_loop = find_natural_loop(g, succ, b);
                    if (new_loop) {
                        for (uint32_t k = 0; k < new_loop->num_body; k++) {
                            loop_add_block(existing, new_loop->body[k]);
                        }
                        for (uint32_t k = 0; k < new_loop->num_exits; k++) {
                            loop_add_exit(existing, new_loop->exits[k]);
                        }
                        free(new_loop->body);
                        free(new_loop->exits);
                        free(new_loop->children);
                        free(new_loop);
                    }
                } else {
                    KyLoop *loop = find_natural_loop(g, succ, b);
                    if (loop) {
                        loopinfo_add(li, loop);
                    }
                }
            }
        }
    }

    /* Step 2: compute preheaders and block_loop map */
    for (uint32_t i = 0; i < li->num_loops; i++) {
        KyLoop *loop = li->loops[i];

        /* Preheader: unique predecessor outside loop */
        KyBlock *preheader = NULL;
        int outside_count = 0;
        for (uint16_t j = 0; j < loop->header->num_predecessors; j++) {
            KyBlock *p = loop->header->predecessors[j];
            if (!loop_has_block(loop, p)) {
                preheader = p;
                outside_count++;
            }
        }
        if (outside_count == 1) loop->preheader = preheader;

        /* Update block_loop map (innermost) */
        for (uint32_t k = 0; k < loop->num_body; k++) {
            KyBlock *b = loop->body[k];
            KyLoop *current = li->block_loop[b->id];
            if (!current || loop->num_body < current->num_body) {
                li->block_loop[b->id] = loop;
            }
        }
    }

    /* Step 3: build loop nest tree (by size) */
    for (uint32_t i = 0; i < li->num_loops; i++) {
        KyLoop *inner = li->loops[i];
        KyLoop *parent = NULL;
        for (uint32_t j = 0; j < li->num_loops; j++) {
            if (i == j) continue;
            KyLoop *outer = li->loops[j];
            if (outer->num_body > inner->num_body &&
                loop_has_block(outer, inner->header)) {
                if (!parent || outer->num_body < parent->num_body) {
                    parent = outer;
                }
            }
        }
        inner->parent = parent;
        if (parent) {
            if (parent->num_children >= parent->child_capacity) {
                parent->child_capacity *= 2;
                parent->children = (KyLoop **)realloc(parent->children,
                    parent->child_capacity * sizeof(KyLoop *));
            }
            parent->children[parent->num_children++] = inner;
        }
    }

    /* Step 4: compute depth and innermost flags */
    for (uint32_t i = 0; i < li->num_loops; i++) {
        KyLoop *loop = li->loops[i];
        uint32_t depth = 0;
        KyLoop *cur = loop->parent;
        while (cur) { depth++; cur = cur->parent; }
        loop->depth = depth;
        loop->is_innermost = (loop->num_children == 0);
    }

    return li;
}

void kyir_loopinfo_destroy(KyLoopInfo *li) {
    if (!li) return;
    for (uint32_t i = 0; i < li->num_loops; i++) {
        KyLoop *l = li->loops[i];
        free(l->body);
        free(l->exits);
        free(l->children);
        free(l);
    }
    free(li->loops);
    free(li->block_loop);
    free(li);
}

KyLoop *kyir_loop_of_block(KyLoopInfo *li, KyBlock *b) {
    if (!li || !b) return NULL;
    return li->block_loop[b->id];
}

int kyir_loop_contains(KyLoop *loop, KyBlock *b) {
    if (!loop || !b) return 0;
    return loop_has_block(loop, b);
}

void kyir_loopinfo_print(KyLoopInfo *li) {
    if (!li) return;
    printf("Loop Info: %u loops\n", li->num_loops);
    for (uint32_t i = 0; i < li->num_loops; i++) {
        KyLoop *l = li->loops[i];
        printf("  loop %u: header=b%u latch=b%u body=%u exits=%u depth=%u%s\n",
               i, l->header->id, l->latch ? l->latch->id : 0,
               l->num_body, l->num_exits, l->depth,
               l->is_innermost ? " (innermost)" : "");
    }
}

/* ============================================================
 * LICM — Loop Invariant Code Motion
 *
 * For each loop (innermost first):
 *   For each node in loop:
 *     If node is loop-invariant (all inputs defined outside loop):
 *       If node is safe to hoist (no side effects, no control):
 *         Hoist to preheader
 * ============================================================ */

static int node_is_loop_invariant(KyNode *n, KyLoop *loop, KyLoopInfo *li) {
    if (!n || !loop) return 0;

    /* Skip control nodes, phis, side effects */
    if (n->flags & KYIR_FLAG_CONTROL) return 0;
    if (n->opcode == IR_PHI) return 0;
    if (n->flags & KYIR_FLAG_HAS_SIDE_EFFECT) return 0;

    /* Check all value inputs */
    for (uint16_t i = 0; i < n->num_values; i++) {
        KyNode *in = n->value_inputs[i];
        if (!in) continue;

        /* If input is in the loop, not invariant */
        if (in->block) {
            KyLoop *in_loop = kyir_loop_of_block(li, in->block);
            if (in_loop == loop) return 0;
            /* Or in a nested loop of this loop */
            KyLoop *p = in_loop;
            while (p) {
                if (p == loop) return 0;
                p = p->parent;
            }
        }
    }

    return 1;
}

static int node_dominates_loop_exits(KyNode *n, KyLoop *loop, KyDomTree *dt) {
    if (!n || !n->block || !loop || !dt) return 0;
    for (uint32_t i = 0; i < loop->num_exits; i++) {
        if (!kyir_domtree_dominates(dt, n->block, loop->exits[i])) {
            return 0;
        }
    }
    return 1;
}

KyLICMResult kyir_licm(KyGraph *g, KyLoopInfo *li, KyDomTree *dt) {
    KyLICMResult result = {0};
    if (!g || !li || !dt) return result;

    /* Process innermost first */
    for (uint32_t pass = 0; pass < li->num_loops; pass++) {
        for (uint32_t i = 0; i < li->num_loops; i++) {
            KyLoop *loop = li->loops[i];
            if (!loop->preheader) continue;
            if (!loop->is_innermost && pass < li->num_loops - 1) continue;

            result.loops_processed++;

            int changed = 1;
            int iterations = 0;
            while (changed && iterations++ < 10) {
                changed = 0;
                for (uint32_t j = 0; j < g->node_count; j++) {
                    KyNode *n = g->nodes[j];
                    if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
                    if (!n->block) continue;
                    if (!loop_has_block(loop, n->block)) continue;

                    if (node_is_loop_invariant(n, loop, li) &&
                        node_dominates_loop_exits(n, loop, dt)) {
                        /* Hoist to preheader */
                        n->block = loop->preheader;
                        kyir_block_add_node(loop->preheader, n);
                        result.nodes_hoisted++;
                        changed = 1;
                    }
                }
            }
        }
    }

    return result;
}

