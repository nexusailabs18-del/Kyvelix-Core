 * Layer 10: Type Inference
 * ============================================================ */

const char *kyir_type_name(KyIRType t) {
    switch (t) {
        case KYIR_TYPE_UNKNOWN:   return "Unknown";
        case KYIR_TYPE_INT32:     return "Int32";
        case KYIR_TYPE_INT64:     return "Int64";
        case KYIR_TYPE_FLOAT32:   return "Float32";
        case KYIR_TYPE_FLOAT64:   return "Float64";
        case KYIR_TYPE_PTR:       return "Ptr";
        case KYIR_TYPE_OBJECT:    return "Object";
        case KYIR_TYPE_ARRAY:     return "Array";
        case KYIR_TYPE_STRING:    return "String";
        case KYIR_TYPE_FUNCTION:  return "Function";
        case KYIR_TYPE_NULL:      return "Null";
        case KYIR_TYPE_UNDEFINED: return "Undefined";
        case KYIR_TYPE_BOOLEAN:   return "Boolean";
        case KYIR_TYPE_ANY:       return "Any";
        default:                  return "?";
    }
}

/* Find the "union" or "meet" of two types.
 * Since our lattice is a flat list of specific types, we implement:
 *   - Same type: return it
 *   - INT32 + INT64 = INT64 (wider)
 *   - Any + T = Any
 *   - Otherwise: UNKNOWN */
static KyIRType meet_types(KyIRType a, KyIRType b) {
    if (a == b) return a;
    if (a == KYIR_TYPE_UNKNOWN) return b;
    if (b == KYIR_TYPE_UNKNOWN) return a;
    if (a == KYIR_TYPE_ANY || b == KYIR_TYPE_ANY) return KYIR_TYPE_ANY;

    /* Numeric widening */
    int a_int = (a == KYIR_TYPE_INT32 || a == KYIR_TYPE_INT64);
    int b_int = (b == KYIR_TYPE_INT32 || b == KYIR_TYPE_INT64);
    if (a_int && b_int) {
        return (a == KYIR_TYPE_INT64 || b == KYIR_TYPE_INT64)
               ? KYIR_TYPE_INT64 : KYIR_TYPE_INT32;
    }

    int a_f = (a == KYIR_TYPE_FLOAT32 || a == KYIR_TYPE_FLOAT64);
    int b_f = (b == KYIR_TYPE_FLOAT32 || b == KYIR_TYPE_FLOAT64);
    if (a_f && b_f) {
        return (a == KYIR_TYPE_FLOAT64 || b == KYIR_TYPE_FLOAT64)
               ? KYIR_TYPE_FLOAT64 : KYIR_TYPE_FLOAT32;
    }

    int a_num = a_int || a_f;
    int b_num = b_int || b_f;
    if (a_num && b_num) return KYIR_TYPE_FLOAT64;  /* int + float = float64 */

    return KYIR_TYPE_UNKNOWN;
}

static KyTypeLattice type_from_opcode(KyIROpcode op) {
    KyTypeLattice t = {0};
    t.base = KYIR_TYPE_UNKNOWN;
    t.min = INT64_MIN;
    t.max = INT64_MAX;

    switch (op) {
        case IR_CONST_I32:
            t.base = KYIR_TYPE_INT32;
            break;
        case IR_CONST_I64:
            t.base = KYIR_TYPE_INT64;
            break;
        case IR_CONST_F32:
            t.base = KYIR_TYPE_FLOAT32;
            break;
        case IR_CONST_F64:
            t.base = KYIR_TYPE_FLOAT64;
            break;
        case IR_CONST_TRUE:
        case IR_CONST_FALSE:
            t.base = KYIR_TYPE_BOOLEAN;
            break;
        case IR_CONST_NULL:
            t.base = KYIR_TYPE_NULL;
            break;
        case IR_CONST_UNDEF:
            t.base = KYIR_TYPE_UNDEFINED;
            break;

        case IR_ADD_I32: case IR_SUB_I32: case IR_MUL_I32: case IR_DIV_I32:
        case IR_MOD_I32: case IR_NEG_I32:
        case IR_SHL: case IR_SHR: case IR_AND: case IR_OR: case IR_XOR:
            t.base = KYIR_TYPE_INT32;
            break;

        case IR_ADD_I64: case IR_SUB_I64: case IR_MUL_I64: case IR_DIV_I64:
        case IR_MOD_I64: case IR_NEG_I64:
            t.base = KYIR_TYPE_INT64;
            break;

        case IR_ADD_F32: case IR_SUB_F32: case IR_MUL_F32: case IR_DIV_F32:
            t.base = KYIR_TYPE_FLOAT32;
            break;

        case IR_ADD_F64: case IR_SUB_F64: case IR_MUL_F64: case IR_DIV_F64:
            t.base = KYIR_TYPE_FLOAT64;
            break;

        case IR_CMP_EQ: case IR_CMP_NE: case IR_CMP_LT:
        case IR_CMP_LE: case IR_CMP_GT: case IR_CMP_GE:
            t.base = KYIR_TYPE_BOOLEAN;
            break;

        case IR_NEW_OBJECT:
            t.base = KYIR_TYPE_OBJECT;
            break;
        case IR_NEW_ARRAY:
            t.base = KYIR_TYPE_ARRAY;
            break;
        case IR_NEW_CLOSURE:
            t.base = KYIR_TYPE_FUNCTION;
            break;

        default:
            t.base = KYIR_TYPE_UNKNOWN;
            break;
    }
    return t;
}

/* Infer type for a single node based on opcode + inputs */
static int infer_node_type(KyTypeInference *ti, KyNode *n) {
    KyTypeLattice old = ti->info[n->id].type;
    KyTypeLattice new_type = type_from_opcode((KyIROpcode)n->opcode);

    /* Constant values override */
    if (n->opcode == IR_CONST_I32) {
        new_type.base = KYIR_TYPE_INT32;
        new_type.is_const = 1;
        new_type.const_val = n->constant.i32;
        new_type.min = new_type.max = n->constant.i32;
        new_type.is_exact = 1;
    } else if (n->opcode == IR_CONST_I64) {
        new_type.base = KYIR_TYPE_INT64;
        new_type.is_const = 1;
        new_type.const_val = n->constant.i64;
        new_type.min = new_type.max = n->constant.i64;
        new_type.is_exact = 1;
    } else if (n->opcode == IR_CONST_F32) {
        new_type.base = KYIR_TYPE_FLOAT32;
        new_type.is_const = 1;
        new_type.is_exact = 1;
    } else if (n->opcode == IR_CONST_F64) {
        new_type.base = KYIR_TYPE_FLOAT64;
        new_type.is_const = 1;
        new_type.is_exact = 1;
    } else if (n->opcode == IR_CONST_TRUE || n->opcode == IR_CONST_FALSE) {
        new_type.base = KYIR_TYPE_BOOLEAN;
        new_type.is_const = 1;
        new_type.is_exact = 1;
    } else if (n->opcode == IR_PHI) {
        /* Phi: meet of all inputs */
        KyIRType t = KYIR_TYPE_UNKNOWN;
        for (uint16_t i = 0; i < n->num_values; i++) {
            KyNode *in = n->value_inputs[i];
            if (!in) continue;
            t = meet_types(t, ti->info[in->id].type.base);
        }
        new_type.base = t;
    } else if (n->num_values >= 2 &&
               (n->opcode == IR_ADD_I32 || n->opcode == IR_ADD_I64 ||
                n->opcode == IR_SUB_I32 || n->opcode == IR_SUB_I64 ||
                n->opcode == IR_MUL_I32 || n->opcode == IR_MUL_I64)) {
        /* Arithmetic: meet of inputs */
        KyTypeLattice t1 = ti->info[n->value_inputs[0]->id].type;
        KyTypeLattice t2 = ti->info[n->value_inputs[1]->id].type;
        new_type.base = meet_types(t1.base, t2.base);

        /* Range analysis for + and - */
        if (n->opcode == IR_ADD_I64 || n->opcode == IR_ADD_I32) {
            if (t1.min != INT64_MIN && t2.min != INT64_MIN) {
                new_type.min = t1.min + t2.min;
            }
            if (t1.max != INT64_MAX && t2.max != INT64_MAX) {
                new_type.max = t1.max + t2.max;
            }
        } else if (n->opcode == IR_SUB_I64 || n->opcode == IR_SUB_I32) {
            if (t1.min != INT64_MIN && t2.max != INT64_MAX) {
                new_type.min = t1.min - t2.max;
            }
            if (t1.max != INT64_MAX && t2.min != INT64_MIN) {
                new_type.max = t1.max - t2.min;
            }
        }
    }

    /* Check for changes */
    int changed = 0;
    if (old.base != new_type.base ||
        old.min != new_type.min ||
        old.max != new_type.max ||
        old.is_const != new_type.is_const) {
        changed = 1;
    }

    ti->info[n->id].type = new_type;
    return changed;
}

KyTypeInference *kyir_types_infer(KyGraph *g, KyDomTree *dt) {
    (void)dt;
    if (!g) return NULL;

    KyTypeInference *ti = (KyTypeInference *)calloc(1, sizeof(KyTypeInference));
    if (!ti) return NULL;

    ti->graph = g;
    ti->info = (KyNodeTypeInfo *)calloc(g->node_count, sizeof(KyNodeTypeInfo));

    /* Initialize all types to UNKNOWN */
    for (uint32_t i = 0; i < g->node_count; i++) {
        ti->info[i].type.base = KYIR_TYPE_UNKNOWN;
        ti->info[i].type.min = INT64_MIN;
        ti->info[i].type.max = INT64_MAX;
    }

    /* Fixed-point iteration */
    int changed = 1;
    uint32_t iterations = 0;
    while (changed && iterations < 100) {
        changed = 0;
        iterations++;
        for (uint32_t i = 0; i < g->node_count; i++) {
            KyNode *n = g->nodes[i];
            if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
            if (infer_node_type(ti, n)) changed = 1;
        }
    }

    ti->num_iterations = iterations;
    return ti;
}

void kyir_types_destroy(KyTypeInference *ti) {
    if (!ti) return;
    free(ti->info);
    free(ti);
}

KyTypeLattice kyir_types_get(KyTypeInference *ti, KyNode *n) {
    KyTypeLattice empty = {0};
    if (!ti || !n) return empty;
    return ti->info[n->id].type;
}

int kyir_types_is_const(KyTypeInference *ti, KyNode *n, int64_t *out) {
    if (!ti || !n) return 0;
    KyTypeLattice t = ti->info[n->id].type;
    if (t.is_const) {
        if (out) *out = t.const_val;
        return 1;
    }
    return 0;
}

int kyir_types_is_int(KyTypeInference *ti, KyNode *n) {
    if (!ti || !n) return 0;
    KyIRType t = ti->info[n->id].type.base;
    return t == KYIR_TYPE_INT32 || t == KYIR_TYPE_INT64;
}

int kyir_types_is_float(KyTypeInference *ti, KyNode *n) {
    if (!ti || !n) return 0;
    KyIRType t = ti->info[n->id].type.base;
    return t == KYIR_TYPE_FLOAT32 || t == KYIR_TYPE_FLOAT64;
}

void kyir_types_print(KyTypeInference *ti) {
    if (!ti) return;
    printf("Type Inference: %u nodes, %u iterations\n",
           ti->graph->node_count, ti->num_iterations);
    for (uint32_t i = 0; i < ti->graph->node_count; i++) {
        KyNode *n = ti->graph->nodes[i];
        if (!n) continue;
        KyTypeLattice t = ti->info[i].type;
        printf("  n%-4u %-14s type=%-10s", n->id,
               opcode_name((KyIROpcode)n->opcode),
               kyir_type_name(t.base));
        if (t.is_const) {
            printf(" const=%lld", (long long)t.const_val);
        } else if (t.min != INT64_MIN || t.max != INT64_MAX) {
            printf(" range=[%lld, %lld]", (long long)t.min, (long long)t.max);
        }
        printf("\n");
    }
}

/* ============================================================
 * SCCP — Sparse Conditional Constant Propagation
 *
 * Uses type info to propagate constants through the graph.
 * ============================================================ */

int kyir_opt_sccp(KyGraph *g, KyTypeInference *ti) {
    if (!g || !ti) return 0;
    int changed = 0;

    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
        if (n->flags & KYIR_FLAG_CONSTANT) continue;

        /* If all inputs are constants, fold */
        int all_const = 1;
        int64_t vals[4];
        for (uint16_t j = 0; j < n->num_values; j++) {
            KyNode *in = n->value_inputs[j];
            if (!in || !ti->info[in->id].type.is_const) {
                all_const = 0;
                break;
            }
            if (j < 4) vals[j] = ti->info[in->id].type.const_val;
        }
        if (!all_const || n->num_values < 2) continue;

        int64_t result = 0;
        int folded = 0;
        switch (n->opcode) {
            case IR_ADD_I32: case IR_ADD_I64:
                result = vals[0] + vals[1]; folded = 1; break;
            case IR_SUB_I32: case IR_SUB_I64:
                result = vals[0] - vals[1]; folded = 1; break;
            case IR_MUL_I32: case IR_MUL_I64:
                result = vals[0] * vals[1]; folded = 1; break;
            case IR_AND: result = vals[0] & vals[1]; folded = 1; break;
            case IR_OR:  result = vals[0] | vals[1]; folded = 1; break;
            case IR_XOR: result = vals[0] ^ vals[1]; folded = 1; break;
            default: break;
        }

        if (folded) {
            KyNode *c = kyir_const_i64(g, result);
            kyir_node_replace_uses(g, n, c);
            n->flags |= KYIR_FLAG_DEAD;
            changed++;
        }
    }
    return changed;
}

/* ============================================================
 * Bounds Check Elimination
 *
 * If we can prove that an index is within [0, length), remove the check.
 * (Placeholder — needs array type + range info)
 * ============================================================ */

int kyir_opt_bounds_check(KyGraph *g, KyTypeInference *ti) {
    if (!g || !ti) return 0;
    int changed = 0;

    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
        if (n->opcode != IR_CHECK_BOUNDS) continue;

        /* Get the index node and its range */
        if (n->num_values < 1) continue;
        KyNode *idx = n->value_inputs[0];
        KyTypeLattice t = ti->info[idx->id].type;

        /* If we know range [min, max] and it's within bounds, remove check */
        /* (Placeholder — real implementation needs array length) */
        if (t.min >= 0 && t.max < 1000000) {
            /* Would remove the check */
            changed++;
        }
    }
    return changed;
}

