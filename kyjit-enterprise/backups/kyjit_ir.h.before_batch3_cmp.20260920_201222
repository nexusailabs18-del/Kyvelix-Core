/* ============================================================
 * Layer 13: x86-64 Backend
 *
 * Pipeline:
 *   1. Linearize IR into instruction list
 *   2. Instruction selection (BURS-style)
 *   3. Register allocation (linear scan)
 *   4. Code emission (x86-64 bytes)
 * ============================================================ */

/* Physical x86-64 registers */
typedef enum {
    X64_RAX = 0, X64_RBX, X64_RCX, X64_RDX,
    X64_RSI, X64_RDI, X64_RBP, X64_RSP,
    X64_R8, X64_R9, X64_R10, X64_R11,
    X64_R12, X64_R13, X64_R14, X64_R15,
    X64_REG_COUNT,
    X64_REG_NONE = 0xFF
} KyX64Reg;

/*
 * x86-64 encoding order:
 *   RAX=0, RCX=1, RDX=2, RBX=3, RSP=4, RBP=5, RSI=6, RDI=7,
 *   R8=8, R9=9, R10=10, R11=11, R12=12, R13=13, R14=14, R15=15
 *
 * Our enum order is different (RAX, RBX, RCX, RDX, RSI, RDI, RBP, RSP, R8..R15).
 * Use ky_x64_enc[] to convert.
 */
static const uint8_t ky_x64_enc[16] = {
    0,   /* X64_RAX = 0  → enc 0  (rax) */
    3,   /* X64_RBX = 1  → enc 3  (rbx) */
    1,   /* X64_RCX = 2  → enc 1  (rcx) */
    2,   /* X64_RDX = 3  → enc 2  (rdx) */
    6,   /* X64_RSI = 4  → enc 6  (rsi) */
    7,   /* X64_RDI = 5  → enc 7  (rdi) */
    5,   /* X64_RBP = 6  → enc 5  (rbp) */
    4,   /* X64_RSP = 7  → enc 4  (rsp) */
    8,   /* X64_R8  = 8  → enc 8 */
    9,   /* X64_R9  = 9  → enc 9 */
    10,  /* X64_R10 = 10 → enc 10 */
    11,  /* X64_R11 = 11 → enc 11 */
    12,  /* X64_R12 = 12 → enc 12 */
    13,  /* X64_R13 = 13 → enc 13 */
    14,  /* X64_R14 = 14 → enc 14 */
    15   /* X64_R15 = 15 → enc 15 */
};

/* Machine opcodes (subset) */
typedef enum {
    X64_MOV_REG_REG = 0,
    X64_MOV_REG_IMM,
    X64_ADD_REG_REG,
    X64_ADD_REG_IMM,
    X64_SUB_REG_REG,
    X64_SUB_REG_IMM,
    X64_MUL_REG_REG,
    X64_IMUL_REG_REG_IMM,
    X64_AND_REG_REG,
    X64_OR_REG_REG,
    X64_XOR_REG_REG,
    X64_SHL_REG_IMM,
    X64_SHR_REG_IMM,
    X64_SAR_REG_IMM,    /* sar r/m64, imm8  (C1 /7) */
    X64_NEG,            /* neg r/m64        (F7 /3) */
    X64_NOT,            /* not r/m64        (F7 /2) */
    X64_CQO,            /* sign-extend rax -> rdx:rax  (48 99) */
    X64_IDIV_REG,       /* signed divide rdx:rax by reg (REX.W F7 /7) */
    X64_CMP_REG_REG,
    X64_CMP_REG_IMM,
    X64_JMP,
    X64_JZ,
    X64_JNZ,
    X64_JE,
    X64_JNE,
    X64_JL,
    X64_JLE,
    X64_JG,
    X64_JGE,
    X64_CALL,
    X64_RET,
    X64_PUSH,
    X64_POP,
    X64_MOV_REG_MEM,
    X64_MOV_MEM_REG,
    X64_LEA,
    X64_NOP,
    X64_LABEL,
    X64_OP_COUNT
} KyX64Op;

/* Virtual register */
typedef enum {
    VREG_VIRTUAL = 0,
    VREG_PHYSICAL
} KyVRegKind;

typedef struct KyVReg {
    uint32_t    id;
    KyVRegKind  kind;
    KyX64Reg    phys;      /* if physical */
    uint32_t    interval_start;
    uint32_t    interval_end;
    int         spilled;
    int32_t     spill_slot;
} KyVReg;

/* Machine instruction */
typedef struct KyX64Label {
    uint32_t  id;
    uint32_t  byte_offset;
    uint32_t  num_patches;
    uint32_t *patch_offsets;
    uint32_t  patch_capacity;
} KyX64Label;

typedef struct KyX64Ins {
    KyX64Op   op;
    KyVReg   *dst;
    KyVReg   *src1;
    KyVReg   *src2;
    int64_t   imm;
    int32_t   mem_offset;      /* for load/store */
    KyX64Reg  mem_base;        /* for load/store */
    uint32_t  label_id;        /* for jumps/labels */
    uint32_t  orig_node;       /* original IR node id */
    uint32_t  fixup_offset;      /* byte offset for patch */
    uint32_t  fixup_label;       /* target label id */
    uint8_t   is_conditional;    /* conditional jump */
    uint8_t   is_terminator;     /* terminator (jump/ret) */
    uint8_t   _pad[6];
} KyX64Ins;

/* Backend context */
/* ============================================================
 * Function frame — callee-saved registers to push/pop.
 * Must be declared before KyX64Backend (which embeds one).
 * ============================================================ */
typedef struct KyFuncFrame {
    /* Callee-saved registers actually used (need to be saved) */
    KyX64Reg  callee_saved[6];      /* rbx, rbp, r12, r13, r14, r15 */
    uint32_t  num_callee_saved;

    /* Stack frame size (local variables, spills) */
    uint32_t  frame_size;

    /* Alignment tracking */
    uint32_t  stack_depth;

    /* Prologue/epilogue labels */
    uint32_t  prologue_done;
} KyFuncFrame;

typedef struct KyX64Backend {
    KyGraph     *graph;
    KySchedule  *schedule;
    KyDomTree   *domtree;

    KyVReg    **vregs;
    uint32_t    num_vregs;
    uint32_t    vreg_capacity;

    KyX64Ins  **insns;
    uint32_t    num_insns;
    uint32_t    insn_capacity;

    uint32_t    num_labels;
    uint32_t    next_label;
    KyX64Label **labels;
    uint32_t    label_capacity;

    /* Register allocation state */
    KyX64Reg    reg_alloc[X64_REG_COUNT];    /* which vreg uses each phys */
    KyX64Reg   *vreg_phys;                   /* phys reg per vreg */

    /* Function frame (callee-saved regs to push/pop) */
    KyFuncFrame frame;

    /* Reserved registers — allocator must not assign these.
     * Used to pin RAX/RDX for idiv sequences. Bit i set = X64 reg i reserved. */
    uint32_t    reserved_regs;

    /* Stats */
    uint32_t    num_spills;
    uint32_t    num_moves_eliminated;
} KyX64Backend;

