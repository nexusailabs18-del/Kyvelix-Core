            changed++;
        }
    }
    return changed;
}


/* ============================================================
 * Layer 11: Escape Analysis
 * ============================================================ */

/* Add a points-to edge to the connection graph */
static void cg_add_edge(KyConnectionGraph *cg, KyNode *from, KyNode *to, uint16_t kind) {
    if (!cg || !from || !to) return;
    if (to->id >= cg->edge_capacity) return;

    KyConnectionEdge *e = (KyConnectionEdge *)calloc(1, sizeof(KyConnectionEdge));
    if (!e) return;

    e->from = from;
    e->to = to;
    e->kind = kind;
    e->next = cg->edges[to->id];
    cg->edges[to->id] = e;
}

/* Track allocation nodes */
static void cg_add_allocation(KyConnectionGraph *cg, KyNode *n) {
    if (!cg || !n) return;
    if (cg->num_allocations >= cg->alloc_capacity) {
        cg->alloc_capacity = cg->alloc_capacity ? cg->alloc_capacity * 2 : 16;
        cg->allocations = (KyNode **)realloc(cg->allocations,
            cg->alloc_capacity * sizeof(KyNode *));
    }
    cg->allocations[cg->num_allocations++] = n;
}

KyConnectionGraph *kyir_escape_build(KyGraph *g) {
    if (!g) return NULL;

    KyConnectionGraph *cg = (KyConnectionGraph *)calloc(1, sizeof(KyConnectionGraph));
    if (!cg) return NULL;

    cg->edge_capacity = g->node_count + 16;
    cg->edges = (KyConnectionEdge **)calloc(cg->edge_capacity, sizeof(KyConnectionEdge *));
    cg->states = (KyEscapeState *)calloc(cg->edge_capacity, sizeof(KyEscapeState));
    cg->num_nodes = g->node_count;

    /* Step 1: find allocation nodes */
    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n) continue;
        if (n->opcode == IR_NEW_OBJECT ||
            n->opcode == IR_NEW_ARRAY ||
            n->opcode == IR_NEW_CLOSURE) {
            cg_add_allocation(cg, n);
        }
    }

    /* Step 2: build points-to edges based on data flow */
    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n) continue;

        switch (n->opcode) {
            case IR_STORE:
            case IR_STORE_FIELD:
            case IR_STORE_ELEMENT:
                /* If we store obj to another object's field, first escapes */
                if (n->num_values >= 2) {
                    KyNode *obj = n->value_inputs[0];
                    KyNode *value = n->value_inputs[1];
                    if (obj && value) {
                        cg_add_edge(cg, obj, value, 1);  /* points-to */
                    }
                }
                break;

            case IR_RETURN:
                /* Anything returned escapes */
                if (n->num_values >= 1) {
                    KyNode *ret = n->value_inputs[0];
                    if (ret) cg_add_edge(cg, ret, n, 2);  /* return edge */
                }
                break;

            case IR_CALL:
            case IR_CALL_DIRECT:
            case IR_CALL_INDIRECT:
            case IR_CALL_RUNTIME:
                /* Anything passed to unknown call escapes */
                for (uint16_t j = 0; j < n->num_values; j++) {
                    cg_add_edge(cg, n->value_inputs[j], n, 3);  /* arg escape */
                }
                break;

            default:
                break;
        }
    }

    return cg;
}

void kyir_escape_destroy(KyConnectionGraph *cg) {
    if (!cg) return;
    for (uint32_t i = 0; i < cg->edge_capacity; i++) {
        KyConnectionEdge *e = cg->edges[i];
        while (e) {
            KyConnectionEdge *next = e->next;
            free(e);
            e = next;
        }
    }
    free(cg->edges);
    free(cg->states);
    free(cg->allocations);
    free(cg->worklist);
    free(cg);
}

void kyir_escape_analyze(KyConnectionGraph *cg, KyGraph *g) {
    if (!cg || !g) return;

    /* Initialize all allocations to NO_ESCAPE */
    for (uint32_t i = 0; i < cg->num_allocations; i++) {
        cg->states[cg->allocations[i]->id] = KYIR_ESCAPE_NO_ESCAPE;
    }

    /* Propagate escape states based on edges */
    int changed = 1;
    uint32_t iterations = 0;
    while (changed && iterations < 50) {
        changed = 0;
        iterations++;

        for (uint32_t i = 0; i < cg->num_allocations; i++) {
            KyNode *alloc = cg->allocations[i];
            KyEscapeState state = cg->states[alloc->id];

            /* Look at outgoing edges */
            for (uint32_t j = 0; j < g->node_count; j++) {
                KyNode *user = g->nodes[j];
                if (!user) continue;

                /* Check if user consumes alloc */
                int consumes = 0;
                for (uint16_t k = 0; k < user->num_values; k++) {
                    if (user->value_inputs[k] == alloc) {
                        consumes = 1;
                        break;
                    }
                }
                if (!consumes) continue;

                KyEscapeState new_state = state;

                if (user->opcode == IR_RETURN) {
                    new_state = KYIR_ESCAPE_RETURN_ESCAPE;
                } else if (user->opcode == IR_STORE ||
                           user->opcode == IR_STORE_FIELD ||
                           user->opcode == IR_STORE_ELEMENT) {
                    /* alloc as target (input[0]) is fine — it's the object
                     * being written to. Only escape if alloc is the VALUE
                     * being stored to another object (input[1]). */
                    if (user->num_values >= 2 &&
                        user->value_inputs[1] == alloc) {
                        new_state = KYIR_ESCAPE_HEAP_ESCAPE;
                    }
                    /* If alloc is input[0] (the target), it doesn't escape */
                } else if (user->opcode == IR_CALL ||
                           user->opcode == IR_CALL_DIRECT ||
                           user->opcode == IR_CALL_INDIRECT ||
                           user->opcode == IR_CALL_RUNTIME) {
                    new_state = KYIR_ESCAPE_UNKNOWN;
                }

                if (new_state > state) {
                    cg->states[alloc->id] = new_state;
                    state = new_state;
                    changed = 1;
                }
            }
        }
    }
}

KyEscapeState kyir_escape_get(KyConnectionGraph *cg, KyNode *n) {
    if (!cg || !n) return KYIR_ESCAPE_UNKNOWN;
    if (n->id >= cg->edge_capacity) return KYIR_ESCAPE_UNKNOWN;
    return cg->states[n->id];
}

void kyir_escape_print(KyConnectionGraph *cg, KyGraph *g) {
    if (!cg || !g) return;
    printf("Escape Analysis: %u allocations\n", cg->num_allocations);
    for (uint32_t i = 0; i < cg->num_allocations; i++) {
        KyNode *n = cg->allocations[i];
        const char *state_str = "UNKNOWN";
        switch (cg->states[n->id]) {
            case KYIR_ESCAPE_NO_ESCAPE:     state_str = "NO_ESCAPE"; break;
            case KYIR_ESCAPE_ARG_ESCAPE:    state_str = "ARG_ESCAPE"; break;
            case KYIR_ESCAPE_RETURN_ESCAPE: state_str = "RETURN_ESCAPE"; break;
            case KYIR_ESCAPE_HEAP_ESCAPE:   state_str = "HEAP_ESCAPE"; break;
            case KYIR_ESCAPE_UNKNOWN:       state_str = "UNKNOWN"; break;
        }
        printf("  n%-4u %-14s state=%s\n",
               n->id, opcode_name((KyIROpcode)n->opcode), state_str);
    }
}

/* ============================================================
 * SROA — Scalar Replacement of Aggregates
 *
 * For each NO_ESCAPE allocation:
 *   1. Find all LOAD_FIELD/STORE_FIELD on the object
 *   2. Track the field values as SSA scalars
 *   3. Remove the allocation node
 * ============================================================ */

KySROAResult kyir_sroa(KyGraph *g, KyConnectionGraph *cg) {
    KySROAResult result = {0};
    if (!g || !cg) return result;

    for (uint32_t i = 0; i < cg->num_allocations; i++) {
        KyNode *alloc = cg->allocations[i];
        if (cg->states[alloc->id] != KYIR_ESCAPE_NO_ESCAPE) continue;

        /* Track field values: offset -> current node */
        struct { uint32_t offset; KyNode *value; } fields[64];
        uint32_t num_fields = 0;

        /* Walk all uses of alloc */
        int eliminated = 1;
        for (uint16_t u = 0; u < alloc->num_uses; u++) {
            KyNode *user = alloc->uses[u];
            if (!user) continue;

            if (user->opcode == IR_STORE_FIELD) {
                /* Store: extract offset and value */
                if (user->num_values >= 2) {
                    KyNode *value = user->value_inputs[1];
                    /* Use node id as fake offset for now */
                    uint32_t offset = user->id;
                    int found = 0;
                    for (uint32_t k = 0; k < num_fields; k++) {
                        if (fields[k].offset == offset) {
                            fields[k].value = value;
                            found = 1;
                            break;
                        }
                    }
                    if (!found && num_fields < 64) {
                        fields[num_fields].offset = offset;
                        fields[num_fields].value = value;
                        num_fields++;
                    }
                    /* Mark store for removal */
                    user->flags |= KYIR_FLAG_DEAD;
                    result.stores_replaced++;
                }
            } else if (user->opcode == IR_LOAD_FIELD) {
                /* Load: replace with the last stored value */
                KyNode *replacement = NULL;
                for (uint32_t k = 0; k < num_fields; k++) {
                    if (fields[k].offset == alloc->id + user->id) {
                        replacement = fields[k].value;
                        break;
                    }
                }
                if (replacement) {
                    kyir_node_replace_uses(g, user, replacement);
                    user->flags |= KYIR_FLAG_DEAD;
                    result.loads_replaced++;
                }
                /* Load without prior store means the alloc was read before write */
                /* In that case, we can't eliminate */
                if (!replacement) eliminated = 0;
            } else if (user->opcode == IR_LOAD_ELEMENT ||
                       user->opcode == IR_STORE_ELEMENT) {
                /* Element access — cannot SROA */
                eliminated = 0;
            }
        }

        if (eliminated) {
            /* Remove the allocation */
            alloc->flags |= KYIR_FLAG_DEAD;
            result.allocations_eliminated++;
        }
    }

    return result;
}


/* ============================================================
 * Layer 12: Click's Global Code Motion
 * ============================================================ */

/* Helper: is block A dominated by all blocks in array? */
static int all_dominate(KyDomTree *dt, KyNode **inputs, uint16_t n, KyBlock *target) {
    for (uint16_t i = 0; i < n; i++) {
        KyNode *in = inputs[i];
        if (!in) continue;
        KyBlock *ib = in->block;
        if (!ib) {
            /* Unscheduled input — check if it has been assigned */
            if (in->block) ib = in->block;
            else continue;
        }
        if (!kyir_domtree_dominates(dt, ib, target)) return 0;
    }
    return 1;
}

/* LCA of two blocks in dominator tree */
static KyBlock *block_lca(KyDomTree *dt, KyBlock *a, KyBlock *b) {
    if (!a) return b;
    if (!b) return a;
    return kyir_domtree_lca(dt, a, b);
}

/* Compute LCA of all uses of a node */
static KyBlock *uses_lca(KyDomTree *dt, KyNode *n) {
    if (!n || n->num_uses == 0) return NULL;
    KyBlock *lca = NULL;
    for (uint16_t i = 0; i < n->num_uses; i++) {
        KyNode *user = n->uses[i];
        if (!user) continue;
        KyBlock *ub = user->block;
        if (!ub) continue;
        if (!lca) lca = ub;
        else lca = block_lca(dt, lca, ub);
    }
    return lca;
}

/* Get node priority (for ordering within block) */
static uint32_t node_priority(KyNode *n) {
    /* Higher priority = scheduled earlier
     * Data nodes: 100 (they should be computed first)
     * Control: 50 (they go last)
     * Constants: 10 (they can go anywhere) */
    if (n->flags & KYIR_FLAG_CONSTANT) return 10;
    if (n->flags & KYIR_FLAG_CONTROL) return 50;
    if (n->opcode == IR_PHI) return 5;
    return 100;
}

KySchedule *kyir_schedule_build(KyGraph *g, KyDomTree *dt) {
    if (!g || !dt) return NULL;

    KySchedule *s = (KySchedule *)calloc(1, sizeof(KySchedule));
    if (!s) return NULL;

    s->graph = g;
    s->domtree = dt;
    s->node_block = (KyBlock **)calloc(g->node_count, sizeof(KyBlock *));
    s->node_index = (uint32_t *)calloc(g->node_count, sizeof(uint32_t));
    s->node_priority = (uint32_t *)calloc(g->node_count, sizeof(uint32_t));

    /* Phase 1: Schedule late — assign each node to a block */
    /* Process in reverse postorder of dominator tree */

    for (uint32_t pass = 0; pass < g->node_count; pass++) {
        int progressed = 0;
        for (uint32_t i = 0; i < g->node_count; i++) {
            KyNode *n = g->nodes[i];
            if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
            if (s->node_block[n->id]) continue;  /* already scheduled */

            /* Start/End nodes: assign to first/last block */
            if (n->opcode == IR_START) {
                s->node_block[n->id] = g->blocks[0];
                progressed = 1;
                continue;
            }
            if (n->opcode == IR_END) {
                s->node_block[n->id] = g->blocks[g->block_count - 1];
                progressed = 1;
                continue;
            }

            /* Find candidate block = LCA of uses */
            KyBlock *candidate = uses_lca(dt, n);
            if (!candidate) {
                /* No uses: place at start block */
                candidate = g->blocks[0];
            }

            /* Walk up until all inputs dominate */
            KyBlock *valid = candidate;
            uint32_t guard = 0;
            while (valid && guard++ < 10000) {
                /* Check all inputs dominate 'valid' */
                int ok = 1;
                for (uint16_t j = 0; j < n->num_values; j++) {
                    KyNode *in = n->value_inputs[j];
                    if (!in) continue;
                    KyBlock *ib = s->node_block[in->id];
                    if (!ib) { ok = 0; break; }
                    if (!kyir_domtree_dominates(dt, ib, valid)) {
                        ok = 0;
                        break;
                    }
                }
                /* Check control inputs */
                for (uint16_t j = 0; j < n->num_controls; j++) {
                    KyNode *in = n->control_inputs[j];
                    if (!in) continue;
                    KyBlock *ib = s->node_block[in->id];
                    if (!ib) { ok = 0; break; }
                    if (!kyir_domtree_dominates(dt, ib, valid)) {
                        ok = 0;
                        break;
                    }
                }

                if (ok) {
                    s->node_block[n->id] = valid;
                    progressed = 1;
                    break;
                }

                /* Move up to immediate dominator */
                KyBlock *idom = dt->idom[valid->id];
                if (!idom || idom == valid) break;
                valid = idom;
            }

            /* If we get here without scheduling, place at first block */
            if (!s->node_block[n->id]) {
                s->node_block[n->id] = g->blocks[0];
            }
        }

        if (!progressed) break;
    }

    /* Phase 2: Assign indices within each block based on priority */
    /* Higher priority first (data before control) */
    for (uint32_t b = 0; b < g->block_count; b++) {
        KyBlock *blk = g->blocks[b];
        if (!blk) continue;

        /* Count nodes in block */
        uint32_t count = 0;
        for (uint32_t i = 0; i < g->node_count; i++) {
            if (s->node_block[i] == blk) count++;
        }

        /* Sort by priority */
        uint32_t *ids = (uint32_t *)calloc(count, sizeof(uint32_t));
        uint32_t *prio = (uint32_t *)calloc(count, sizeof(uint32_t));
        uint32_t idx = 0;
        for (uint32_t i = 0; i < g->node_count; i++) {
            if (s->node_block[i] == blk) {
                ids[idx] = i;
                prio[idx] = node_priority(g->nodes[i]);
                idx++;
            }
        }

        /* Sort by priority descending */
        for (uint32_t i = 0; i < count; i++) {
            for (uint32_t j = i + 1; j < count; j++) {
                if (prio[j] > prio[i]) {
                    uint32_t t = prio[i]; prio[i] = prio[j]; prio[j] = t;
                    t = ids[i]; ids[i] = ids[j]; ids[j] = t;
                }
            }
        }

        /* Assign indices */
        for (uint32_t i = 0; i < count; i++) {
            s->node_index[ids[i]] = i;
        }

        free(ids);
        free(prio);
    }

    /* Count stats */
    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
        if (s->node_block[i]) s->num_scheduled++;
        else s->num_unscheduled++;
    }

    return s;
}

void kyir_schedule_destroy(KySchedule *s) {
    if (!s) return;
    free(s->node_block);
    free(s->node_index);
    free(s->node_priority);
    free(s);
}

int kyir_schedule_apply(KyGraph *g, KySchedule *s) {
    if (!g || !s) return -1;
    for (uint32_t i = 0; i < g->node_count; i++) {
        KyNode *n = g->nodes[i];
        if (!n) continue;
        if (s->node_block[i]) {
            n->block = s->node_block[i];
            n->schedule_idx = s->node_index[i];
        }
    }
    return 0;
}

void kyir_schedule_print(KySchedule *s) {
    if (!s) return;
    printf("Schedule: %u scheduled, %u unscheduled\n",
           s->num_scheduled, s->num_unscheduled);
    KyGraph *g = s->graph;
    for (uint32_t b = 0; b < g->block_count; b++) {
        KyBlock *blk = g->blocks[b];
        if (!blk) continue;
        printf("  block b%u:\n", blk->id);
        for (uint32_t i = 0; i < g->node_count; i++) {
            if (s->node_block[i] == blk) {
                KyNode *n = g->nodes[i];
                printf("    [%u] n%u: %s\n",
                       s->node_index[i], i, opcode_name((KyIROpcode)n->opcode));
            }
        }
    }
}


/* ============================================================
 * Layer 13: x86-64 Backend
 * ============================================================ */

const char *kyx64_op_name(KyX64Op op) {
    switch (op) {
        case X64_MOV_REG_REG: return "mov";
        case X64_MOV_REG_IMM: return "mov";
        case X64_ADD_REG_REG: return "add";
        case X64_ADD_REG_IMM: return "add";
        case X64_SUB_REG_REG: return "sub";
        case X64_SUB_REG_IMM: return "sub";
        case X64_MUL_REG_REG: return "imul";
        case X64_IMUL_REG_REG_IMM: return "imul";
        case X64_AND_REG_REG: return "and";
        case X64_OR_REG_REG: return "or";
        case X64_XOR_REG_REG: return "xor";
        case X64_SHL_REG_IMM: return "shl";
        case X64_SHR_REG_IMM: return "shr";
        case X64_CMP_REG_REG: return "cmp";
        case X64_CMP_REG_IMM: return "cmp";
        case X64_JMP: return "jmp";
        case X64_JZ: return "jz";
        case X64_JNZ: return "jnz";
        case X64_RET: return "ret";
        case X64_PUSH: return "push";
        case X64_POP: return "pop";
        case X64_MOV_REG_MEM: return "mov(mem->reg)";
        case X64_MOV_MEM_REG: return "mov(reg->mem)";
        case X64_LEA: return "lea";
        case X64_NOP: return "nop";
        case X64_LABEL: return "label";
        default: return "?";
    }
}

const char *kyx64_reg_name(KyX64Reg r) {
    static const char *names[] = {
        "rax", "rbx", "rcx", "rdx",
        "rsi", "rdi", "rbp", "rsp",
        "r8", "r9", "r10", "r11",
        "r12", "r13", "r14", "r15"
    };
    if (r < X64_REG_COUNT) return names[r];
    return "?";
}

KyX64Backend *kyx64_backend_create(KyGraph *g, KySchedule *s, KyDomTree *dt) {
    if (!g) return NULL;

    KyX64Backend *b = (KyX64Backend *)calloc(1, sizeof(KyX64Backend));
    if (!b) return NULL;

    b->graph = g;
    b->schedule = s;
    b->domtree = dt;

    /* Explicit init of label fields */
    b->labels = NULL;
    b->label_capacity = 0;
    b->num_labels = 0;
    b->next_label = 0;

    b->vreg_capacity = g->node_count + 16;
    b->vregs = (KyVReg **)calloc(b->vreg_capacity, sizeof(KyVReg *));

    b->insn_capacity = g->node_count * 4 + 16;
    b->insns = (KyX64Ins **)calloc(b->insn_capacity, sizeof(KyX64Ins *));

    b->vreg_phys = (KyX64Reg *)malloc(b->vreg_capacity * sizeof(KyX64Reg));
    for (uint32_t i = 0; i < b->vreg_capacity; i++) {
        b->vreg_phys[i] = X64_REG_NONE;
    }

    return b;
}

void kyx64_backend_destroy(KyX64Backend *b) {
    if (!b) return;
    for (uint32_t i = 0; i < b->num_vregs; i++) {
        if (b->vregs[i]) free(b->vregs[i]);
    }
    for (uint32_t i = 0; i < b->num_insns; i++) {
        if (b->insns[i]) free(b->insns[i]);
    }
    if (b->labels) {
        for (uint32_t i = 0; i < b->num_labels; i++) {
            if (b->labels[i]) {
                free(b->labels[i]->patch_offsets);
                free(b->labels[i]);
            }
        }
        free(b->labels);
    }
    free(b->vregs);
    free(b->insns);
    free(b->vreg_phys);
    free(b);
}

/* Create a virtual register for an IR node */
KyVReg *new_vreg(KyX64Backend *b, uint32_t node_id) {
    if (b->num_vregs >= b->vreg_capacity) return NULL;

    KyVReg *vr = (KyVReg *)calloc(1, sizeof(KyVReg));
    vr->id = b->num_vregs;
    vr->kind = VREG_VIRTUAL;
    vr->phys = X64_REG_NONE;
    vr->spill_slot = -1;

    b->vregs[b->num_vregs++] = vr;
    b->vreg_phys[vr->id] = X64_REG_NONE;

    /* Store the IR node id for later mapping */
    if (node_id < b->vreg_capacity) {
        /* We store node-to-vreg mapping separately */
    }

    return vr;
}

/* Create or get a physical vreg for an ABI register */
static KyVReg *get_phys_vreg(KyX64Backend *b, KyX64Reg reg) {
    for (uint32_t i = 0; i < b->num_vregs; i++) {
        KyVReg *vr = b->vregs[i];
        if (vr && vr->kind == VREG_PHYSICAL && vr->phys == reg) return vr;
    }
    KyVReg *vr = new_vreg(b, 0xFFFFFFFF);
    if (vr) {
        vr->kind = VREG_PHYSICAL;
        vr->phys = reg;
        b->vreg_phys[vr->id] = reg;
    }
    return vr;
}

/* Add a machine instruction */
KyX64Ins *add_insn(KyX64Backend *b, KyX64Op op) {
    if (b->num_insns >= b->insn_capacity) {
        b->insn_capacity *= 2;
        b->insns = (KyX64Ins **)realloc(b->insns, b->insn_capacity * sizeof(KyX64Ins *));
    }
    KyX64Ins *ins = (KyX64Ins *)calloc(1, sizeof(KyX64Ins));
    ins->op = op;
    b->insns[b->num_insns++] = ins;
    return ins;
}

/* ============================================================
 * Stage 1: Linearize — assign vregs to IR nodes, no ordering yet
 * ============================================================ */

int kyx64_linearize(KyX64Backend *b) {
    if (!b) return -1;

    /* Create a vreg for every IR node that produces a value */
    for (uint32_t i = 0; i < b->graph->node_count; i++) {
        KyNode *n = b->graph->nodes[i];
        if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
        if (n->flags & KYIR_FLAG_CONTROL) continue;
        if (n->opcode == IR_START || n->opcode == IR_END) continue;

        new_vreg(b, i);
    }

    return 0;
}

/* ============================================================
 * Stage 2: Instruction Selection
 *
 * For each IR node, emit machine instructions.
 * Simple non-optimal selection: 1 IR op → 1-3 machine ops.
 * ============================================================ */

static KyX64Ins *emit_mov_imm(KyX64Backend *b, KyVReg *dst, int64_t imm) {
    KyX64Ins *ins = add_insn(b, X64_MOV_REG_IMM);
    ins->dst = dst;
    ins->imm = imm;
    return ins;
}

static KyX64Ins *emit_mov_reg(KyX64Backend *b, KyVReg *dst, KyVReg *src) {
    KyX64Ins *ins = add_insn(b, X64_MOV_REG_REG);
    ins->dst = dst;
    ins->src1 = src;
    /* CRITICAL: X64_MOV_REG_REG's emitter branches on ins->imm.
     *   - if (imm >= 0 && imm < X64_REG_COUNT): treat imm as a hardcoded
     *     physical destination register (used by test_funcs.c's mov_ret trick).
     *   - else: use ins->dst->phys and ins->src1->phys normally.
     * add_insn() callocs the insn, so imm defaults to 0 (= X64_RAX), which
     * silently routes to the hardcoded-destination branch and ignores dst.
     * Force imm = -1 so we take the normal vreg path. */
    ins->imm = -1;
    return ins;
}

static KyX64Ins *emit_binop(KyX64Backend *b, KyX64Op op, KyVReg *dst, KyVReg *a, KyVReg *b2) {
    KyX64Ins *ins = add_insn(b, op);
    ins->dst = dst;
    ins->src1 = a;
    ins->src2 = b2;
    return ins;
}

int kyx64_select(KyX64Backend *b) {
    if (!b) return -1;

    /* Map node id → vreg */
    uint32_t *node_vreg = (uint32_t *)malloc(b->graph->node_count * sizeof(uint32_t));
    for (uint32_t i = 0; i < b->graph->node_count; i++) node_vreg[i] = 0xFFFFFFFF;
    for (uint32_t i = 0; i < b->num_vregs; i++) {
        /* vregs are indexed by order of creation, node ids are separate */
        /* This simplified version uses vreg index = node id where possible */
        (void)i;
    }

    /* Rebuild: assign vreg per node in order */
    uint32_t vidx = 0;
    for (uint32_t i = 0; i < b->graph->node_count; i++) {
        KyNode *n = b->graph->nodes[i];
        if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;
        if (n->flags & KYIR_FLAG_CONTROL) continue;
        if (n->opcode == IR_START || n->opcode == IR_END) continue;
        if (vidx < b->num_vregs) {
            node_vreg[i] = vidx;
            vidx++;
        }
    }

    for (uint32_t i = 0; i < b->graph->node_count; i++) {
        KyNode *n = b->graph->nodes[i];
        if (!n || (n->flags & KYIR_FLAG_DEAD)) continue;

        switch (n->opcode) {
            case IR_CONST_I32:
            case IR_CONST_I64: {
                if (node_vreg[i] == 0xFFFFFFFF) break;
                KyVReg *dst = b->vregs[node_vreg[i]];
                emit_mov_imm(b, dst, n->constant.i64);
                break;
            }

            case IR_PARAMETER: {
                /* SysV x86-64 ABI: integer args 0..5 arrive in
                 * rdi, rsi, rdx, rcx, r8, r9. Emit a mov from the
                 * physical ABI register into the parameter's vreg,
                 * so downstream ops see the incoming value. */
                if (node_vreg[i] == 0xFFFFFFFF) break;
                static const KyX64Reg sysv_args[6] = {
                    X64_RDI, X64_RSI, X64_RDX, X64_RCX, X64_R8, X64_R9
                };
                int idx = (int)n->constant.i64;
                if (idx < 0 || idx >= 6) break;
                KyVReg *dst = b->vregs[node_vreg[i]];
                KyVReg *phys = get_phys_vreg(b, sysv_args[idx]);
                if (!phys) break;
                emit_mov_reg(b, dst, phys);
                break;
            }

            case IR_ADD_I32:
            case IR_ADD_I64: {
                if (node_vreg[i] == 0xFFFFFFFF) break;
                KyVReg *dst = b->vregs[node_vreg[i]];
                KyNode *a = n->value_inputs[0];
                KyNode *c = n->value_inputs[1];
                if (a && c &&
                    node_vreg[a->id] != 0xFFFFFFFF &&
                    node_vreg[c->id] != 0xFFFFFFFF) {
                    emit_binop(b, X64_ADD_REG_REG, dst,
                              b->vregs[node_vreg[a->id]],
                              b->vregs[node_vreg[c->id]]);
                }
                break;
            }

            case IR_SUB_I32:
            case IR_SUB_I64: {
                if (node_vreg[i] == 0xFFFFFFFF) break;
                KyVReg *dst = b->vregs[node_vreg[i]];
                KyNode *a = n->value_inputs[0];
                KyNode *c = n->value_inputs[1];
                if (a && c &&
                    node_vreg[a->id] != 0xFFFFFFFF &&
                    node_vreg[c->id] != 0xFFFFFFFF) {
                    emit_binop(b, X64_SUB_REG_REG, dst,
                              b->vregs[node_vreg[a->id]],
                              b->vregs[node_vreg[c->id]]);
                }
                break;
            }

            case IR_MUL_I32:
            case IR_MUL_I64: {
                if (node_vreg[i] == 0xFFFFFFFF) break;
                KyVReg *dst = b->vregs[node_vreg[i]];
                KyNode *a = n->value_inputs[0];
                KyNode *c = n->value_inputs[1];
                if (a && c &&
                    node_vreg[a->id] != 0xFFFFFFFF &&
                    node_vreg[c->id] != 0xFFFFFFFF) {
                    emit_binop(b, X64_MUL_REG_REG, dst,
                              b->vregs[node_vreg[a->id]],
                              b->vregs[node_vreg[c->id]]);
                }
                break;
            }

            case IR_AND:
            case IR_OR:
            case IR_XOR: {
                if (node_vreg[i] == 0xFFFFFFFF) break;
                KyVReg *dst = b->vregs[node_vreg[i]];
                KyNode *a = n->value_inputs[0];
                KyNode *c = n->value_inputs[1];
                if (a && c &&
                    node_vreg[a->id] != 0xFFFFFFFF &&
                    node_vreg[c->id] != 0xFFFFFFFF) {
                    KyX64Op op = (n->opcode == IR_AND) ? X64_AND_REG_REG :
                                 (n->opcode == IR_OR)  ? X64_OR_REG_REG  :
                                                         X64_XOR_REG_REG;
                    emit_binop(b, op, dst,
                              b->vregs[node_vreg[a->id]],
                              b->vregs[node_vreg[c->id]]);
                }
                break;
            }

            case IR_LOAD_FIELD: {
                if (node_vreg[i] == 0xFFFFFFFF) break;
                KyVReg *dst = b->vregs[node_vreg[i]];
                KyNode *obj = n->value_inputs[0];
                if (!obj || node_vreg[obj->id] == 0xFFFFFFFF) break;
                KyVReg *base = b->vregs[node_vreg[obj->id]];
                kyx64_emit_load(b, dst, base, (int32_t)n->constant.i64);
                break;
            }

            case IR_STORE_FIELD: {
                KyNode *obj = n->value_inputs[0];
                KyNode *val = n->value_inputs[1];
                if (!obj || !val) break;
                if (node_vreg[obj->id] == 0xFFFFFFFF) break;
                if (node_vreg[val->id] == 0xFFFFFFFF) break;
                KyVReg *base = b->vregs[node_vreg[obj->id]];
                KyVReg *value = b->vregs[node_vreg[val->id]];
                kyx64_emit_store(b, base, (int32_t)n->constant.i64, value);
                break;
            }

            case IR_RETURN: {
                KyNode *val = n->value_inputs[0];
                if (val && node_vreg[val->id] != 0xFFFFFFFF) {
                    /* mov rax, vreg */
                    KyX64Ins *ins = add_insn(b, X64_MOV_REG_REG);
                    ins->dst = NULL;  /* physical rax */
                    ins->src1 = b->vregs[node_vreg[val->id]];
                    ins->imm = X64_RAX;  /* target register */
                    add_insn(b, X64_RET);
                } else {
                    add_insn(b, X64_RET);
                }
                break;
            }

            default:
                break;
        }
    }

    free(node_vreg);
    return 0;
}

/* ============================================================
 * Stage 3: Register Allocation (simplified linear scan)
 *
 * For now: assign vregs to physical registers in round-robin
 * fashion. Real allocator would compute live intervals.
 * ============================================================ */

int kyx64_allocate(KyX64Backend *b) {
    if (!b) return -1;

    /* Registers available for allocation.
     *
     * All general-purpose regs except RSP (stack pointer) and RBP
     * (frame pointer, unused). Callee-saved regs (RBX, R12-R15) are
     * safe because kyx64_compile now emits push/pop in the prologue
     * and epilogue for any that are used. See scan_used_callee_saved
     * and splice_prologue_epilogue above.
     */
    KyX64Reg free_regs[] = {
        X64_RAX, X64_RBX, X64_RCX, X64_RDX,
        X64_RSI, X64_RDI,
        X64_R8, X64_R9, X64_R10, X64_R11,
        X64_R12, X64_R13, X64_R14, X64_R15
    };
    uint32_t num_free = sizeof(free_regs) / sizeof(free_regs[0]);
    uint32_t next_reg = 0;

    for (uint32_t i = 0; i < b->num_vregs; i++) {
        KyVReg *vr = b->vregs[i];
        if (!vr) continue;
        if (vr->kind == VREG_PHYSICAL) continue;

        if (vr->kind == VREG_VIRTUAL) {
            if (next_reg < num_free) {
                vr->phys = free_regs[next_reg++];
                b->vreg_phys[vr->id] = vr->phys;
            } else {
                /* Spill */
                vr->spilled = 1;
                vr->spill_slot = (int32_t)(b->num_spills++);
            }
        }
    }

    return 0;
}

/* ============================================================
 * Stage 4: Code Emission — write x86-64 bytes
 *
 * Simplified: only supports a few instruction formats.
 * ============================================================ */

int emit_bytes(uint8_t *code, size_t code_size, size_t *off,
                      const uint8_t *bytes, size_t len) {
    if (*off + len > code_size) return -1;
    memcpy(code + *off, bytes, len);
    *off += len;
    return 0;
}

/* REX.W prefix: 0x48 for 64-bit */
#define REX_W 0x48

/* Encode mov reg, imm64 */
int encode_mov_imm64(uint8_t *code, size_t code_size, size_t *off,
                            KyX64Reg dst, int64_t imm) {
    uint8_t buf[10];
    uint8_t enc = ky_x64_enc[dst & 15];
    uint8_t rex = REX_W;
    if (enc >= 8) rex |= 0x01;
    buf[0] = rex;
    buf[1] = 0xB8 + (enc & 7);
    memcpy(buf + 2, &imm, 8);
    return emit_bytes(code, code_size, off, buf, 10);
}

/* Encode add dst, src */
int encode_add_reg_reg(uint8_t *code, size_t code_size, size_t *off,
                              KyX64Reg dst, KyX64Reg src) {
    uint8_t buf[3];
    uint8_t e_dst = ky_x64_enc[dst & 15];
    uint8_t e_src = ky_x64_enc[src & 15];
    uint8_t rex = REX_W;
    if (e_src >= 8) rex |= 0x04;
    if (e_dst >= 8) rex |= 0x01;
    buf[0] = rex;
    buf[1] = 0x01;
    buf[2] = 0xC0 | ((e_src & 7) << 3) | (e_dst & 7);
    return emit_bytes(code, code_size, off, buf, 3);
}

int encode_sub_reg_reg(uint8_t *code, size_t code_size, size_t *off,
                              KyX64Reg dst, KyX64Reg src) {
    uint8_t buf[3];
    uint8_t e_dst = ky_x64_enc[dst & 15];
    uint8_t e_src = ky_x64_enc[src & 15];
    uint8_t rex = REX_W;
    if (e_src >= 8) rex |= 0x04;
    if (e_dst >= 8) rex |= 0x01;
    buf[0] = rex;
    buf[1] = 0x29;
    buf[2] = 0xC0 | ((e_src & 7) << 3) | (e_dst & 7);
    return emit_bytes(code, code_size, off, buf, 3);
}

int encode_imul_reg_reg(uint8_t *code, size_t code_size, size_t *off,
                               KyX64Reg dst, KyX64Reg src) {
    uint8_t buf[4];
    uint8_t e_dst = ky_x64_enc[dst & 15];
    uint8_t e_src = ky_x64_enc[src & 15];
    uint8_t rex = REX_W;
    if (e_dst >= 8) rex |= 0x04;
    if (e_src >= 8) rex |= 0x01;
    buf[0] = rex;
    buf[1] = 0x0F;
    buf[2] = 0xAF;
    buf[3] = 0xC0 | ((e_dst & 7) << 3) | (e_src & 7);
    return emit_bytes(code, code_size, off, buf, 4);
}

int encode_mov_reg_reg(uint8_t *code, size_t code_size, size_t *off,
                              KyX64Reg dst, KyX64Reg src) {
    uint8_t buf[3];
    uint8_t e_dst = ky_x64_enc[dst & 15];
    uint8_t e_src = ky_x64_enc[src & 15];
    uint8_t rex = REX_W;
    if (e_src >= 8) rex |= 0x04;
    if (e_dst >= 8) rex |= 0x01;
    buf[0] = rex;
    buf[1] = 0x89;
    buf[2] = 0xC0 | ((e_src & 7) << 3) | (e_dst & 7);
    return emit_bytes(code, code_size, off, buf, 3);
}

int kyx64_emit(KyX64Backend *b, uint8_t *code, size_t code_size, size_t *code_len) {
    if (!b || !code || !code_len) return -1;

    size_t off = 0;

    for (uint32_t i = 0; i < b->num_insns; i++) {
        KyX64Ins *ins = b->insns[i];
        if (!ins) continue;

        int rc = 0;
        switch (ins->op) {
            case X64_MOV_REG_IMM: {
                if (ins->dst && ins->dst->phys != X64_REG_NONE) {
                    rc = encode_mov_imm64(code, code_size, &off,
                                          ins->dst->phys, ins->imm);
                }
                break;
            }

            case X64_MOV_REG_REG: {
                if (ins->imm >= 0 && ins->imm < X64_REG_COUNT) {
                    /* Physical target */
                    if (ins->src1 && ins->src1->phys != X64_REG_NONE) {
                        rc = encode_mov_reg_reg(code, code_size, &off,
                                                (KyX64Reg)ins->imm,
                                                ins->src1->phys);
                    }
                } else if (ins->dst && ins->src1 &&
                          ins->dst->phys != X64_REG_NONE &&
                          ins->src1->phys != X64_REG_NONE) {
                    rc = encode_mov_reg_reg(code, code_size, &off,
                                            ins->dst->phys, ins->src1->phys);
                }
                break;
            }

            case X64_ADD_REG_REG: {
                if (ins->dst && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    /* mov dst, src1; add dst, src2 */
                    if (ins->src1 && ins->src1->phys != X64_REG_NONE &&
                        ins->src1->phys != ins->dst->phys) {
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    }
                    rc = encode_add_reg_reg(code, code_size, &off,
                                            ins->dst->phys, ins->src2->phys);
                }
                break;
            }

            case X64_SUB_REG_REG: {
                if (ins->dst && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    if (ins->src1 && ins->src1->phys != X64_REG_NONE &&
                        ins->src1->phys != ins->dst->phys) {
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    }
                    rc = encode_sub_reg_reg(code, code_size, &off,
                                            ins->dst->phys, ins->src2->phys);
                }
                break;
            }

            case X64_MUL_REG_REG: {
                if (ins->dst && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    if (ins->src1 && ins->src1->phys != X64_REG_NONE &&
                        ins->src1->phys != ins->dst->phys) {
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    }
                    rc = encode_imul_reg_reg(code, code_size, &off,
                                             ins->dst->phys, ins->src2->phys);
                }
                break;
            }

            case X64_RET: {
                uint8_t ret = 0xC3;
                rc = emit_bytes(code, code_size, &off, &ret, 1);
                break;
            }

            case X64_PUSH: {
                KyX64Reg reg = ins->src1 ? ins->src1->phys : (KyX64Reg)ins->imm;
                if (reg != X64_REG_NONE)
                    rc = encode_push(code, code_size, &off, reg);
                break;
            }

            case X64_POP: {
                KyX64Reg reg = ins->dst ? ins->dst->phys : (KyX64Reg)ins->imm;
                if (reg != X64_REG_NONE)
                    rc = encode_pop(code, code_size, &off, reg);
                break;
            }

            case X64_NOP:
            default:
                break;
        }

        if (rc < 0) return -1;
    }

    *code_len = off;
    return 0;
}

/* ============================================================
 * Convenience: full compile
 * ============================================================ */

/* ============================================================
 * Callee-saved register handling (SysV ABI)
 *
 * The register allocator may assign RBX, R12-R15 to vregs. Those
 * are callee-saved: our function must push them on entry and pop
 * them on exit, or we corrupt the caller's state.
 *
 * Strategy:
 *   1. After allocation, scan emitted insns for used callee-saved regs.
 *   2. Prepend push insns, append pop insns (reverse order).
 * ============================================================ */

static int is_callee_saved_reg(KyX64Reg r) {
    return r == X64_RBX || r == X64_R12 || r == X64_R13 ||
           r == X64_R14 || r == X64_R15;
}

static void scan_used_callee_saved(KyX64Backend *b) {
    b->frame.num_callee_saved = 0;
    for (uint32_t i = 0; i < b->num_insns; i++) {
        KyX64Ins *ins = b->insns[i];
        if (!ins) continue;

        if (ins->dst  && ins->dst->phys  != X64_REG_NONE &&
            is_callee_saved_reg(ins->dst->phys))
            kyx64_frame_add_callee_saved(&b->frame, ins->dst->phys);
        if (ins->src1 && ins->src1->phys != X64_REG_NONE &&
            is_callee_saved_reg(ins->src1->phys))
            kyx64_frame_add_callee_saved(&b->frame, ins->src1->phys);
        if (ins->src2 && ins->src2->phys != X64_REG_NONE &&
            is_callee_saved_reg(ins->src2->phys))
            kyx64_frame_add_callee_saved(&b->frame, ins->src2->phys);
    }
}

static void splice_prologue_epilogue(KyX64Backend *b) {
    uint32_t n_save = b->frame.num_callee_saved;
    if (n_save == 0) return;

    uint32_t old_n = b->num_insns;
    if (old_n == 0) return;

    /* Find the last X64_RET in the body. We insert pops BEFORE it,
     * not after — pops after ret execute in the caller's frame. */
    int32_t last_ret_idx = -1;
    for (int32_t i = (int32_t)old_n - 1; i >= 0; i--) {
        if (b->insns[i] && b->insns[i]->op == X64_RET) {
            last_ret_idx = i;
            break;
        }
    }
    if (last_ret_idx < 0) {
        /* No ret in body — bail out of the prologue too, to keep
         * push/pop balanced. */
        return;
    }

    uint32_t new_n = n_save + old_n + n_save;
    KyX64Ins **new_insns = (KyX64Ins **)calloc(new_n, sizeof(KyX64Ins *));
    if (!new_insns) return;
    uint32_t k = 0;

    /* Prologue: push each callee-saved reg */
    for (uint32_t i = 0; i < n_save; i++) {
        KyX64Ins *ins = (KyX64Ins *)calloc(1, sizeof(KyX64Ins));
        ins->op  = X64_PUSH;
        ins->imm = b->frame.callee_saved[i];
        new_insns[k++] = ins;
    }

    /* Body up to (but not including) the ret */
    for (int32_t i = 0; i < last_ret_idx; i++) new_insns[k++] = b->insns[i];

    /* Epilogue pops (reverse order) */
    for (int32_t i = (int32_t)n_save - 1; i >= 0; i--) {
        KyX64Ins *ins = (KyX64Ins *)calloc(1, sizeof(KyX64Ins));
        ins->op  = X64_POP;
        ins->imm = b->frame.callee_saved[i];
        new_insns[k++] = ins;
    }

    /* Now the ret (and anything after it, e.g. a trailing label) */
    for (uint32_t i = (uint32_t)last_ret_idx; i < old_n; i++)
        new_insns[k++] = b->insns[i];

    free(b->insns);
    b->insns = new_insns;
    b->num_insns = new_n;
    b->insn_capacity = new_n;
}

int kyx64_compile(KyGraph *g, uint8_t *code, size_t code_size, size_t *code_len) {
    if (!g || !code || !code_len) return -1;

    /* Build dominator tree */
    KyDomTree *dt = kyir_domtree_build(g);
    if (!dt) return -1;

    /* Build schedule */
    KySchedule *s = kyir_schedule_build(g, dt);
    if (!s) { kyir_domtree_destroy(dt); return -1; }

    /* Build backend */
    KyX64Backend *b = kyx64_backend_create(g, s, dt);
    if (!b) { kyir_schedule_destroy(s); kyir_domtree_destroy(dt); return -1; }

    /* Run pipeline */
    int rc = 0;
    if (kyx64_linearize(b) < 0) rc = -1;
    else if (kyx64_select(b) < 0) rc = -1;
    else if (kyx64_allocate(b) < 0) rc = -1;
    else {
        /* Insert ABI prologue/epilogue for any callee-saved regs used.
         * Must run after allocation (vreg->phys is now final) and
         * before emit. */
        scan_used_callee_saved(b);
        splice_prologue_epilogue(b);
        if (kyx64_emit(b, code, code_size, code_len) < 0) rc = -1;
    }

    kyx64_backend_destroy(b);
    kyir_schedule_destroy(s);
    kyir_domtree_destroy(dt);

    return rc;
}

void kyx64_dump(KyX64Backend *b) {
    if (!b) return;
    printf("x86-64 Backend: %u vregs, %u insns\n", b->num_vregs, b->num_insns);
    for (uint32_t i = 0; i < b->num_insns; i++) {
        KyX64Ins *ins = b->insns[i];
        if (!ins) continue;
        printf("  %-20s", kyx64_op_name(ins->op));
        if (ins->dst && ins->dst->phys != X64_REG_NONE) {
            printf(" %s", kyx64_reg_name(ins->dst->phys));
        } else if (ins->dst) {
            printf(" v%u", ins->dst->id);
        }
        if (ins->src1) {
            if (ins->src1->phys != X64_REG_NONE)
                printf(", %s", kyx64_reg_name(ins->src1->phys));
            else
                printf(", v%u", ins->src1->id);
        }
        if (ins->src2) {
            if (ins->src2->phys != X64_REG_NONE)
                printf(", %s", kyx64_reg_name(ins->src2->phys));
            else
                printf(", v%u", ins->src2->id);
        }
        if (ins->imm != 0) printf(", %lld", (long long)ins->imm);
        printf("\n");
    }
}


/* ============================================================
 * Extended x86-64 Backend — labels, branches, memory, calls
 * ============================================================ */

KyX64Label *kyx64_new_label(KyX64Backend *b) {
    if (!b) return NULL;

    if (b->label_capacity == 0) {
        b->label_capacity = 16;
        b->labels = (KyX64Label **)calloc(b->label_capacity, sizeof(KyX64Label *));
    }
    if (b->num_labels >= b->label_capacity) {
        b->label_capacity *= 2;
        b->labels = (KyX64Label **)realloc(b->labels, b->label_capacity * sizeof(KyX64Label *));
    }

    KyX64Label *l = (KyX64Label *)calloc(1, sizeof(KyX64Label));
    l->id = b->next_label++;
    l->byte_offset = 0xFFFFFFFF;  /* unset */
    l->patch_capacity = 4;
    l->patch_offsets = (uint32_t *)calloc(4, sizeof(uint32_t));

    b->labels[b->num_labels++] = l;
    return l;
}

void kyx64_emit_label(KyX64Backend *b, KyX64Label *label) {
    if (!b || !label) return;
    KyX64Ins *ins = add_insn(b, X64_LABEL);
    ins->label_id = label->id;
}

void kyx64_emit_jump(KyX64Backend *b, KyX64Op op, KyX64Label *target) {
    if (!b || !target) return;
    KyX64Ins *ins = add_insn(b, op);
    ins->label_id = target->id;
    ins->is_terminator = 1;
    ins->fixup_label = target->id;
    ins->fixup_offset = 0xFFFFFFFF;
}

void kyx64_emit_branch_zero(KyX64Backend *b, KyVReg *cond, KyX64Label *target) {
    if (!b) return;
    /* cmp cond, 0; jz target */
    KyX64Ins *cmp = add_insn(b, X64_CMP_REG_IMM);
    cmp->src1 = cond;
    cmp->imm = 0;
    kyx64_emit_jump(b, X64_JZ, target);
}

void kyx64_emit_load(KyX64Backend *b, KyVReg *dst, KyVReg *base, int32_t offset) {
    if (!b) return;
    KyX64Ins *ins = add_insn(b, X64_MOV_REG_MEM);
    ins->dst = dst;
    ins->src1 = base;
    ins->mem_offset = offset;
}

void kyx64_emit_store(KyX64Backend *b, KyVReg *base, int32_t offset, KyVReg *value) {
    if (!b) return;
    KyX64Ins *ins = add_insn(b, X64_MOV_MEM_REG);
    ins->dst = base;
    ins->src1 = value;
    ins->mem_offset = offset;
}

void kyx64_emit_call(KyX64Backend *b, void *target, KyVReg *result) {
    if (!b) return;
    KyX64Ins *ins = add_insn(b, X64_CALL);
    ins->imm = (int64_t)(uintptr_t)target;
    ins->dst = result;
}

/* ============================================================
 * Encoding helpers
 * ============================================================ */

/* mov reg, [base + offset] */
static int encode_load(uint8_t *code, size_t code_size, size_t *off,
                       KyX64Reg dst, KyX64Reg base, int32_t offset) {
    if ((unsigned)dst >= X64_REG_COUNT) return -1;
    if ((unsigned)base >= X64_REG_COUNT) return -1;
    if (base == X64_RSP) {
        /* rsp as base requires SIB byte — not supported here. */
        return -1;
    }
    uint8_t e_dst  = ky_x64_enc[dst];
    uint8_t e_base = ky_x64_enc[base];

    /* REX.W, plus REX.R if dst is extended, REX.B if base is extended. */
    uint8_t rex = REX_W;
    if (e_dst  >= 8) rex |= 0x04;  /* REX.R */
    if (e_base >= 8) rex |= 0x01;  /* REX.B */

    uint8_t buf[8];
    size_t  n = 0;
    buf[n++] = rex;
    buf[n++] = 0x8B;  /* mov r64, r/m64 */
    /* ModRM: mod=10 (disp32), reg=dst&7, rm=base&7 */
    buf[n++] = 0x80 | ((e_dst & 7) << 3) | (e_base & 7);
    memcpy(buf + n, &offset, 4); n += 4;
    return emit_bytes(code, code_size, off, buf, n);
}

/* mov [base + offset], src */
static int encode_store(uint8_t *code, size_t code_size, size_t *off,
                        KyX64Reg base, int32_t offset, KyX64Reg src) {
    if ((unsigned)src  >= X64_REG_COUNT) return -1;
    if ((unsigned)base >= X64_REG_COUNT) return -1;
    if (base == X64_RSP) return -1;

    uint8_t e_src  = ky_x64_enc[src];
    uint8_t e_base = ky_x64_enc[base];

    uint8_t rex = REX_W;
    if (e_src  >= 8) rex |= 0x04;  /* REX.R */
    if (e_base >= 8) rex |= 0x01;  /* REX.B */

    uint8_t buf[8];
    size_t  n = 0;
    buf[n++] = rex;
    buf[n++] = 0x89;  /* mov r/m64, r64 */
    buf[n++] = 0x80 | ((e_src & 7) << 3) | (e_base & 7);
    memcpy(buf + n, &offset, 4); n += 4;
    return emit_bytes(code, code_size, off, buf, n);
}

/* cmp reg, imm32 */
static int encode_cmp_imm(uint8_t *code, size_t code_size, size_t *off,
                          KyX64Reg reg, int32_t imm) {
    uint8_t buf[7];
    buf[0] = REX_W;
    buf[1] = 0x81;  /* cmp r/m64, imm32 */
    buf[2] = 0xF8 | (reg & 7);  /* /7 for cmp */
    memcpy(buf + 3, &imm, 4);
    return emit_bytes(code, code_size, off, buf, 7);
}

/* cmp reg, reg */
static int encode_cmp_reg(uint8_t *code, size_t code_size, size_t *off,
                          KyX64Reg a, KyX64Reg b) {
    uint8_t buf[3];
    buf[0] = REX_W;
    buf[1] = 0x39;  /* cmp r/m64, r64 */
    buf[2] = 0xC0 | ((b & 7) << 3) | (a & 7);
    return emit_bytes(code, code_size, off, buf, 3);
}

/* and reg, reg */
static int encode_and_reg(uint8_t *code, size_t code_size, size_t *off,
                          KyX64Reg dst, KyX64Reg src) {
    uint8_t buf[3];
    buf[0] = REX_W;
    buf[1] = 0x21;  /* and r/m64, r64 */
    buf[2] = 0xC0 | ((src & 7) << 3) | (dst & 7);
    return emit_bytes(code, code_size, off, buf, 3);
}

/* or reg, reg */
static int encode_or_reg(uint8_t *code, size_t code_size, size_t *off,
                         KyX64Reg dst, KyX64Reg src) {
    uint8_t buf[3];
    buf[0] = REX_W;
    buf[1] = 0x09;  /* or r/m64, r64 */
    buf[2] = 0xC0 | ((src & 7) << 3) | (dst & 7);
    return emit_bytes(code, code_size, off, buf, 3);
}

/* xor reg, reg */
static int encode_xor_reg(uint8_t *code, size_t code_size, size_t *off,
                          KyX64Reg dst, KyX64Reg src) {
    uint8_t buf[3];
    buf[0] = REX_W;
    buf[1] = 0x31;  /* xor r/m64, r64 */
    buf[2] = 0xC0 | ((src & 7) << 3) | (dst & 7);
    return emit_bytes(code, code_size, off, buf, 3);
}

/* shl reg, imm8 */
static int encode_shl_imm(uint8_t *code, size_t code_size, size_t *off,
                          KyX64Reg dst, uint8_t imm) {
    uint8_t buf[4];
    buf[0] = REX_W;
    buf[1] = 0xC1;  /* shl r/m64, imm8 */
    buf[2] = 0xE0 | (dst & 7);  /* /4 for shl */
    buf[3] = imm;
    return emit_bytes(code, code_size, off, buf, 4);
}

/* shr reg, imm8 */
static int encode_shr_imm(uint8_t *code, size_t code_size, size_t *off,
                          KyX64Reg dst, uint8_t imm) {
    uint8_t buf[4];
    buf[0] = REX_W;
    buf[1] = 0xC1;  /* shr r/m64, imm8 */
    buf[2] = 0xE8 | (dst & 7);  /* /5 for shr */
    buf[3] = imm;
    return emit_bytes(code, code_size, off, buf, 4);
}

/* Jcc rel32 */
static int encode_jcc(uint8_t *code, size_t code_size, size_t *off,
                      KyX64Op op, int32_t rel32) {
    uint8_t buf[6];
    uint8_t cc = 0;
    switch (op) {
        case X64_JZ:  case X64_JE:  cc = 0x84; break;  /* jz / je */
        case X64_JNZ: case X64_JNE: cc = 0x85; break;  /* jnz / jne */
        case X64_JL:  cc = 0x8C; break;
        case X64_JLE: cc = 0x8E; break;
        case X64_JG:  cc = 0x8F; break;
        case X64_JGE: cc = 0x8D; break;
        default: return -1;
    }
    buf[0] = 0x0F;
    buf[1] = cc;
    memcpy(buf + 2, &rel32, 4);
    return emit_bytes(code, code_size, off, buf, 6);
}

/* JMP rel32 */
static int encode_jmp(uint8_t *code, size_t code_size, size_t *off, int32_t rel32) {
    uint8_t buf[5];
    buf[0] = 0xE9;
    memcpy(buf + 1, &rel32, 4);
    return emit_bytes(code, code_size, off, buf, 5);
}

/* CALL rel32 */
static int encode_call(uint8_t *code, size_t code_size, size_t *off, int32_t rel32) {
    uint8_t buf[5];
    buf[0] = 0xE8;
    memcpy(buf + 1, &rel32, 4);
    return emit_bytes(code, code_size, off, buf, 5);
}

/* LEA reg, [base + offset] */
static int encode_lea(uint8_t *code, size_t code_size, size_t *off,
                      KyX64Reg dst, KyX64Reg base, int32_t offset) {
    uint8_t buf[7];
    buf[0] = REX_W;
    buf[1] = 0x8D;
    buf[2] = 0x80 | ((dst & 7) << 3) | (base & 7);
    memcpy(buf + 3, &offset, 4);
    return emit_bytes(code, code_size, off, buf, 7);
}

/* ============================================================
 * Extended emitter — handles all new opcodes
 * ============================================================ */

int kyx64_emit_extended(KyX64Backend *b, uint8_t *code, size_t code_size, size_t *code_len) {
    if (!b || !code || !code_len) return -1;

    size_t off = 0;

    for (uint32_t i = 0; i < b->num_insns; i++) {
        KyX64Ins *ins = b->insns[i];
        if (!ins) continue;

        int rc = 0;
        switch (ins->op) {
            case X64_MOV_REG_IMM:
                if (ins->dst && ins->dst->phys != X64_REG_NONE)
                    rc = encode_mov_imm64(code, code_size, &off, ins->dst->phys, ins->imm);
                break;

            case X64_MOV_REG_REG:
                if (ins->dst && ins->src1 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src1->phys != X64_REG_NONE)
                    rc = encode_mov_reg_reg(code, code_size, &off,
                                            ins->dst->phys, ins->src1->phys);
                break;

            case X64_ADD_REG_REG:
                if (ins->dst && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    if (ins->src1 && ins->src1->phys != X64_REG_NONE &&
                        ins->src1->phys != ins->dst->phys)
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    rc = encode_add_reg_reg(code, code_size, &off,
                                            ins->dst->phys, ins->src2->phys);
                }
                break;

            case X64_SUB_REG_REG:
                if (ins->dst && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    if (ins->src1 && ins->src1->phys != X64_REG_NONE &&
                        ins->src1->phys != ins->dst->phys)
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    rc = encode_sub_reg_reg(code, code_size, &off,
                                            ins->dst->phys, ins->src2->phys);
                }
                break;

            case X64_MUL_REG_REG:
                if (ins->dst && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    if (ins->src1 && ins->src1->phys != X64_REG_NONE &&
                        ins->src1->phys != ins->dst->phys)
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    rc = encode_imul_reg_reg(code, code_size, &off,
                                             ins->dst->phys, ins->src2->phys);
                }
                break;

            case X64_AND_REG_REG:
                if (ins->dst && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE && ins->src2->phys != X64_REG_NONE) {
                    if (ins->src1 && ins->src1->phys != ins->dst->phys)
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    rc = encode_and_reg(code, code_size, &off,
                                        ins->dst->phys, ins->src2->phys);
                }
                break;

            case X64_OR_REG_REG:
                if (ins->dst && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE && ins->src2->phys != X64_REG_NONE) {
                    if (ins->src1 && ins->src1->phys != ins->dst->phys)
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    rc = encode_or_reg(code, code_size, &off,
                                       ins->dst->phys, ins->src2->phys);
                }
                break;

            case X64_XOR_REG_REG:
                if (ins->dst && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE && ins->src2->phys != X64_REG_NONE) {
                    if (ins->src1 && ins->src1->phys != ins->dst->phys)
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    rc = encode_xor_reg(code, code_size, &off,
                                        ins->dst->phys, ins->src2->phys);
                }
                break;

            case X64_SHL_REG_IMM:
                if (ins->dst && ins->dst->phys != X64_REG_NONE)
                    rc = encode_shl_imm(code, code_size, &off,
                                        ins->dst->phys, (uint8_t)ins->imm);
                break;

            case X64_SHR_REG_IMM:
                if (ins->dst && ins->dst->phys != X64_REG_NONE)
                    rc = encode_shr_imm(code, code_size, &off,
                                        ins->dst->phys, (uint8_t)ins->imm);
                break;

            case X64_CMP_REG_IMM:
                if (ins->src1 && ins->src1->phys != X64_REG_NONE)
                    rc = encode_cmp_imm(code, code_size, &off,
                                        ins->src1->phys, (int32_t)ins->imm);
                break;

            case X64_CMP_REG_REG:
                if (ins->src1 && ins->src2 &&
                    ins->src1->phys != X64_REG_NONE && ins->src2->phys != X64_REG_NONE)
                    rc = encode_cmp_reg(code, code_size, &off,
                                        ins->src1->phys, ins->src2->phys);
                break;

            case X64_MOV_REG_MEM:
                if (ins->dst && ins->src1 &&
                    ins->dst->phys != X64_REG_NONE && ins->src1->phys != X64_REG_NONE)
                    rc = encode_load(code, code_size, &off,
                                    ins->dst->phys, ins->src1->phys, ins->mem_offset);
                break;

            case X64_MOV_MEM_REG:
                if (ins->dst && ins->src1 &&
                    ins->dst->phys != X64_REG_NONE && ins->src1->phys != X64_REG_NONE)
                    rc = encode_store(code, code_size, &off,
                                     ins->dst->phys, ins->mem_offset, ins->src1->phys);
                break;

            case X64_LEA:
                if (ins->dst && ins->src1 &&
                    ins->dst->phys != X64_REG_NONE && ins->src1->phys != X64_REG_NONE)
                    rc = encode_lea(code, code_size, &off,
                                   ins->dst->phys, ins->src1->phys, ins->mem_offset);
                break;

            case X64_JMP:
            case X64_JZ: case X64_JNZ:
            case X64_JE: case X64_JNE:
            case X64_JL: case X64_JLE:
            case X64_JG: case X64_JGE: {
                /* The rel32 operand goes at:
                 *   JMP: off + 1 (after 0xE9)
                 *   Jcc: off + 2 (after 0x0F 0x8x)
                 */
                uint32_t fixup_pos = (ins->op == X64_JMP)
                                     ? (uint32_t)off + 1
                                     : (uint32_t)off + 2;
                ins->fixup_offset = fixup_pos;

                if (ins->op == X64_JMP)
                    rc = encode_jmp(code, code_size, &off, 0);
                else
                    rc = encode_jcc(code, code_size, &off, ins->op, 0);

                /* Register fixup with target label */
                for (uint32_t k = 0; k < b->num_labels; k++) {
                    if (b->labels[k]->id == ins->label_id) {
                        KyX64Label *l = b->labels[k];
                        if (l->num_patches >= l->patch_capacity) {
                            l->patch_capacity *= 2;
                            l->patch_offsets = (uint32_t *)realloc(
                                l->patch_offsets, l->patch_capacity * sizeof(uint32_t));
                        }
                        l->patch_offsets[l->num_patches++] = fixup_pos;
                        break;
                    }
                }
                break;
            }

            case X64_LABEL: {
                /* Record current offset in label */
                for (uint32_t k = 0; k < b->num_labels; k++) {
                    if (b->labels[k]->id == ins->label_id) {
                        b->labels[k]->byte_offset = (uint32_t)off;
                        break;
                    }
                }
                break;
            }

            case X64_CALL: {
                int32_t rel = 0;  /* placeholder for now */
                (void)rel;
                uint8_t buf[5];
                buf[0] = 0xE8;
                memcpy(buf + 1, &ins->imm, 4);
                rc = emit_bytes(code, code_size, &off, buf, 5);
                break;
            }

            case X64_RET: {
                uint8_t ret = 0xC3;
                rc = emit_bytes(code, code_size, &off, &ret, 1);
                break;
            }

            case X64_NOP:
            default:
                break;
        }

        if (rc < 0) return -1;
    }

    *code_len = off;
    return 0;
}

/* Patch jump targets after all code is emitted */
void kyx64_patch_labels(KyX64Backend *b, uint8_t *code, size_t code_size) {
    if (!b || !code) return;

    for (uint32_t i = 0; i < b->num_labels; i++) {
        KyX64Label *l = b->labels[i];
        if (l->byte_offset == 0xFFFFFFFF) continue;  /* label never emitted */

        for (uint32_t j = 0; j < l->num_patches; j++) {
            uint32_t patch_off = l->patch_offsets[j];
            if (patch_off + 4 > code_size) continue;

            /* Compute relative offset: target - (patch_off + 4) */
            int32_t rel = (int32_t)l->byte_offset - (int32_t)(patch_off + 4);
            memcpy(code + patch_off, &rel, 4);
        }
    }
}


/* ============================================================
 * Layer 14: Chaitin-Briggs Register Allocation
 * ============================================================ */

KyRegAlloc *kyregalloc_create(KyX64Backend *b) {
    if (!b) return NULL;

    KyRegAlloc *ra = (KyRegAlloc *)calloc(1, sizeof(KyRegAlloc));
    if (!ra) return NULL;

    ra->backend = b;

    /* Available physical registers (exclude rsp, rbp) */
    KyX64Reg avail[] = {
        X64_RAX, X64_RCX, X64_RDX,
        X64_RSI, X64_RDI,
        X64_R8, X64_R9, X64_R10, X64_R11
    };
    ra->num_regs = sizeof(avail) / sizeof(avail[0]);
    for (uint32_t i = 0; i < ra->num_regs; i++) ra->regs[i] = avail[i];

    /* Allocate nodes array (one per vreg) */
    ra->num_nodes = b->num_vregs;
    ra->nodes = (KyRegNode **)calloc(ra->num_nodes + 1, sizeof(KyRegNode *));

    for (uint32_t i = 0; i < ra->num_nodes; i++) {
        KyRegNode *n = (KyRegNode *)calloc(1, sizeof(KyRegNode));
        n->vreg_id = i;
        n->color = KYREG_UNASSIGNED;
        n->neighbor_capacity = 4;
        n->neighbors = (uint32_t *)calloc(4, sizeof(uint32_t));
        ra->nodes[i] = n;

        /* Pre-color physical vregs */
        if (i < b->num_vregs && b->vregs[i] &&
            b->vregs[i]->kind == VREG_PHYSICAL) {
            n->color = b->vregs[i]->phys;
            n->removed = 1;  /* don't process in simplify/select */
        }
    }

    ra->stack_capacity = ra->num_nodes + 1;
    ra->stack = (uint32_t *)calloc(ra->stack_capacity, sizeof(uint32_t));

    ra->spill_capacity = 16;
    ra->spilled = (uint32_t *)calloc(ra->spill_capacity, sizeof(uint32_t));

    return ra;
}

void kyregalloc_destroy(KyRegAlloc *ra) {
    if (!ra) return;
    for (uint32_t i = 0; i < ra->num_nodes; i++) {
        if (ra->nodes[i]) {
            free(ra->nodes[i]->neighbors);
            free(ra->nodes[i]);
        }
    }
    free(ra->nodes);
    free(ra->stack);
    free(ra->spilled);
    free(ra);
}

/* ---------- Live interval computation ---------- */

static void compute_live_intervals(KyRegAlloc *ra) {
    KyX64Backend *b = ra->backend;

    /* Initialize intervals to empty */
    for (uint32_t i = 0; i < ra->num_nodes; i++) {
        ra->nodes[i]->live_start = UINT32_MAX;
        ra->nodes[i]->live_end = 0;
    }

    /* Map vreg id → node index */
    for (uint32_t i = 0; i < b->num_insns; i++) {
        KyX64Ins *ins = b->insns[i];
        if (!ins) continue;

        uint32_t pos = i;  /* instruction position is the "time" unit */

        /* Each use/def extends the live interval */
        KyVReg *vregs[3] = { ins->dst, ins->src1, ins->src2 };
        for (int j = 0; j < 3; j++) {
            KyVReg *vr = vregs[j];
            if (!vr) continue;
            if (vr->id >= ra->num_nodes) continue;

            KyRegNode *node = ra->nodes[vr->id];
            if (pos < node->live_start) node->live_start = pos;
            if (pos > node->live_end) node->live_end = pos;
        }
    }
}

/* ---------- Interference graph ---------- */

static void add_interference(KyRegAlloc *ra, uint32_t a, uint32_t b) {
    if (a == b) return;
    if (a >= ra->num_nodes || b >= ra->num_nodes) return;

    KyRegNode *na = ra->nodes[a];
    KyRegNode *nb = ra->nodes[b];

    /* Check if already exists */
    for (uint32_t i = 0; i < na->num_neighbors; i++) {
        if (na->neighbors[i] == b) return;
    }

    /* Add b to a's neighbors */
    if (na->num_neighbors >= na->neighbor_capacity) {
        na->neighbor_capacity *= 2;
        na->neighbors = (uint32_t *)realloc(na->neighbors,
                                             na->neighbor_capacity * sizeof(uint32_t));
    }
    na->neighbors[na->num_neighbors++] = b;

    /* Add a to b's neighbors */
    if (nb->num_neighbors >= nb->neighbor_capacity) {
        nb->neighbor_capacity *= 2;
        nb->neighbors = (uint32_t *)realloc(nb->neighbors,
                                             nb->neighbor_capacity * sizeof(uint32_t));
    }
    nb->neighbors[nb->num_neighbors++] = a;

    na->degree++;
    nb->degree++;
}

static void build_interference_graph(KyRegAlloc *ra) {
    uint32_t n = ra->num_nodes;

    /* O(n²) — check each pair of overlapping intervals */
    for (uint32_t i = 0; i < n; i++) {
        KyRegNode *a = ra->nodes[i];
        if (a->live_start == UINT32_MAX) continue;  /* unused vreg */

        for (uint32_t j = i + 1; j < n; j++) {
            KyRegNode *b = ra->nodes[j];
            if (b->live_start == UINT32_MAX) continue;

            /* Interfere if intervals overlap */
            if (a->live_start <= b->live_end && b->live_start <= a->live_end) {
                add_interference(ra, i, j);
            }
        }
    }
}

/* ---------- Simplify phase ---------- */

static void push_stack(KyRegAlloc *ra, uint32_t node_id) {
    if (ra->stack_top >= ra->stack_capacity) {
        ra->stack_capacity *= 2;
        ra->stack = (uint32_t *)realloc(ra->stack,
                                         ra->stack_capacity * sizeof(uint32_t));
    }
    ra->stack[ra->stack_top++] = node_id;
}

static void mark_for_spill(KyRegAlloc *ra, uint32_t node_id) {
    if (ra->num_spills >= ra->spill_capacity) {
        ra->spill_capacity *= 2;
        ra->spilled = (uint32_t *)realloc(ra->spilled,
                                           ra->spill_capacity * sizeof(uint32_t));
    }
    ra->spilled[ra->num_spills++] = node_id;
    ra->nodes[node_id]->spilled = 1;
}

static void simplify(KyRegAlloc *ra) {
    uint32_t K = ra->num_regs;

    /* Worklist of all nodes */
    uint32_t *worklist = (uint32_t *)calloc(ra->num_nodes, sizeof(uint32_t));
    uint32_t work_count = 0;
    for (uint32_t i = 0; i < ra->num_nodes; i++) {
        if (ra->nodes[i]->live_start != UINT32_MAX) {
            worklist[work_count++] = i;
        }
    }

    int changed = 1;
    while (changed) {
        changed = 0;

        for (uint32_t i = 0; i < work_count; i++) {
            uint32_t id = worklist[i];
            KyRegNode *n = ra->nodes[id];
            if (n->removed) continue;

            if (n->degree < K) {
                /* Push to stack, mark removed */
                push_stack(ra, id);
                n->removed = 1;
                changed = 1;

                /* Decrement degree of neighbors */
                for (uint32_t j = 0; j < n->num_neighbors; j++) {
                    KyRegNode *nb = ra->nodes[n->neighbors[j]];
                    if (!nb->removed && nb->degree > 0) {
                        nb->degree--;
                    }
                }
            }
        }

        /* If no progress, spill the highest-degree node */
        if (!changed) {
            uint32_t max_deg = 0;
            int32_t spill_id = -1;
            for (uint32_t i = 0; i < work_count; i++) {
                KyRegNode *n = ra->nodes[worklist[i]];
                if (n->removed) continue;
                if (n->degree > max_deg) {
                    max_deg = n->degree;
                    spill_id = (int32_t)worklist[i];
                }
            }
            if (spill_id >= 0) {
                uint32_t id = (uint32_t)spill_id;
                mark_for_spill(ra, id);
                push_stack(ra, id);
                ra->nodes[id]->removed = 1;
                changed = 1;

                for (uint32_t j = 0; j < ra->nodes[id]->num_neighbors; j++) {
                    KyRegNode *nb = ra->nodes[ra->nodes[id]->neighbors[j]];
                    if (!nb->removed && nb->degree > 0) {
                        nb->degree--;
                    }
                }
            }
        }
    }

    free(worklist);
}

/* ---------- Select phase ---------- */

static void select_colors(KyRegAlloc *ra) {
    uint32_t K = ra->num_regs;

    /* Pop from stack in reverse order */
    while (ra->stack_top > 0) {
        uint32_t id = ra->stack[--ra->stack_top];
        KyRegNode *n = ra->nodes[id];

        if (n->spilled) {
            n->color = KYREG_UNASSIGNED;
            continue;
        }

        /* Bitmap of colors used by neighbors */
        uint8_t used[X64_REG_COUNT];
        memset(used, 0, sizeof(used));

        for (uint32_t j = 0; j < n->num_neighbors; j++) {
            KyRegNode *nb = ra->nodes[n->neighbors[j]];
            if (nb->color != KYREG_UNASSIGNED && nb->color < K) {
                used[nb->color] = 1;
            }
        }

        /* Assign the lowest available color */
        uint32_t color = KYREG_UNASSIGNED;
        for (uint32_t c = 0; c < K; c++) {
            if (!used[c]) {
                color = c;
                break;
            }
        }

        if (color == KYREG_UNASSIGNED) {
            /* Should have been spilled in simplify */
            n->spilled = 1;
            mark_for_spill(ra, id);
        }
        n->color = color;
    }
}

/* ---------- Apply colors to backend vregs ---------- */

static void apply_colors(KyRegAlloc *ra) {
    KyX64Backend *b = ra->backend;

    for (uint32_t i = 0; i < ra->num_nodes; i++) {
        KyRegNode *n = ra->nodes[i];
        if (i >= b->num_vregs) break;

        KyVReg *vr = b->vregs[i];
        if (!vr) continue;
        if (vr->kind == VREG_PHYSICAL) continue;  /* skip physical */

        if (n->spilled) {
            vr->spilled = 1;
            vr->spill_slot = (int32_t)ra->num_spills;
            vr->phys = X64_REG_NONE;
        } else if (n->color != KYREG_UNASSIGNED && n->color < ra->num_regs) {
            vr->phys = ra->regs[n->color];
            b->vreg_phys[vr->id] = vr->phys;
        }
    }
}

/* ---------- Main entry point ---------- */

int kyregalloc_run(KyX64Backend *b) {
    if (!b) return -1;

    KyRegAlloc *ra = kyregalloc_create(b);
    if (!ra) return -1;

    compute_live_intervals(ra);
    build_interference_graph(ra);
    simplify(ra);
    select_colors(ra);
    apply_colors(ra);

    kyregalloc_destroy(ra);
    return 0;
}

void kyregalloc_print(KyRegAlloc *ra) {
    if (!ra) return;
    printf("Register Allocator: %u nodes, %u physical regs\n",
           ra->num_nodes, ra->num_regs);
    for (uint32_t i = 0; i < ra->num_nodes; i++) {
        KyRegNode *n = ra->nodes[i];
        if (n->live_start == UINT32_MAX) continue;
        printf("  v%-4u interval [%u, %u] degree=%u",
               n->vreg_id, n->live_start, n->live_end, n->degree);
        if (n->spilled) printf(" SPILLED");
        else if (n->color != KYREG_UNASSIGNED && n->color < ra->num_regs)
            printf(" color=%s", kyx64_reg_name(ra->regs[n->color]));
        printf("\n");
    }
}


/* ============================================================
 * Layer 15: Function Calls (SysV x86-64 ABI)
 * ============================================================ */

/* Add a callee-saved register to the frame */
void kyx64_frame_add_callee_saved(KyFuncFrame *frame, KyX64Reg reg) {
    if (!frame) return;
    for (uint32_t i = 0; i < frame->num_callee_saved; i++) {
        if (frame->callee_saved[i] == reg) return;
    }
    if (frame->num_callee_saved < 6) {
        frame->callee_saved[frame->num_callee_saved++] = reg;
    }
}

/* Emit function prologue:
 *   push rbp
 *   mov rbp, rsp
 *   sub rsp, frame_size
 *   push callee-saved regs
 */
KyX64Ins *kyx64_emit_prologue(KyX64Backend *b, KyFuncFrame *frame) {
    if (!b || !frame) return NULL;

    /* push rbp */
    KyX64Ins *ins = add_insn(b, X64_PUSH);
    ins->imm = X64_RBP;
    ins->is_terminator = 0;

    /* mov rbp, rsp */
    ins = add_insn(b, X64_MOV_REG_REG);
    ins->imm = (X64_RBP << 8) | X64_RSP;  /* custom encoding: dst<<8 | src */
    ins->is_terminator = 0;

    /* push callee-saved registers used */
    for (uint32_t i = 0; i < frame->num_callee_saved; i++) {
        ins = add_insn(b, X64_PUSH);
        ins->imm = frame->callee_saved[i];
    }

    /* sub rsp, frame_size (if nonzero) */
    if (frame->frame_size > 0) {
        ins = add_insn(b, X64_SUB_REG_IMM);
        ins->imm = frame->frame_size;
        /* dst is rsp implicitly */
    }

    return ins;
}

/* Emit function epilogue:
 *   add rsp, frame_size
 *   pop callee-saved regs (reverse order)
 *   pop rbp
 *   ret
 */
KyX64Ins *kyx64_emit_epilogue(KyX64Backend *b, KyFuncFrame *frame) {
    if (!b || !frame) return NULL;

    /* add rsp, frame_size (if nonzero) */
    if (frame->frame_size > 0) {
        KyX64Ins *ins = add_insn(b, X64_ADD_REG_IMM);
        ins->imm = frame->frame_size;
    }

    /* pop callee-saved registers in reverse order */
    for (int32_t i = (int32_t)frame->num_callee_saved - 1; i >= 0; i--) {
        KyX64Ins *ins = add_insn(b, X64_POP);
        ins->imm = frame->callee_saved[i];
    }

    /* pop rbp */
    KyX64Ins *ins = add_insn(b, X64_POP);
    ins->imm = X64_RBP;

    /* ret */
    ins = add_insn(b, X64_RET);
    return ins;
}

/* Emit a push */
KyX64Ins *kyx64_emit_push(KyX64Backend *b, KyVReg *reg) {
    if (!b || !reg) return NULL;
    KyX64Ins *ins = add_insn(b, X64_PUSH);
    ins->src1 = reg;
    return ins;
}

/* Emit a pop */
KyX64Ins *kyx64_emit_pop(KyX64Backend *b, KyVReg *reg) {
    if (!b || !reg) return NULL;
    KyX64Ins *ins = add_insn(b, X64_POP);
    ins->dst = reg;
    return ins;
}

/* Emit an indirect call through a register */
KyX64Ins *kyx64_emit_call_reg(KyX64Backend *b, KyVReg *target_reg,
                               KyVReg **args, uint32_t num_args,
                               KyVReg *result) {
    if (!b || !target_reg) return NULL;

    /* Move args to ABI registers rdi..r9 (in reverse to avoid clobber) */
    for (int32_t i = (int32_t)num_args - 1; i >= 0; i--) {
        KyX64Reg arg_reg;
        switch (i) {
            case 0: arg_reg = KYFUNC_ARG0; break;
            case 1: arg_reg = KYFUNC_ARG1; break;
            case 2: arg_reg = KYFUNC_ARG2; break;
            case 3: arg_reg = KYFUNC_ARG3; break;
            case 4: arg_reg = KYFUNC_ARG4; break;
            case 5: arg_reg = KYFUNC_ARG5; break;
            default: return NULL;
        }
        KyX64Ins *mov = add_insn(b, X64_MOV_REG_REG);
        mov->imm = (arg_reg << 8) | 0;  /* dst = phys, src = vreg */
        mov->src1 = args[i];
    }

    /* call *reg */
    KyX64Ins *call = add_insn(b, X64_CALL);
    call->src1 = target_reg;
    call->dst = result;  /* result captured from rax */
    call->is_terminator = 0;
    return call;
}

/* Emit a direct call to a known address */
KyX64Ins *kyx64_emit_call_direct(KyX64Backend *b, void *target,
                                  KyVReg **args, uint32_t num_args,
                                  KyVReg *result) {

    /* Move args to ABI registers */
    for (uint32_t i = 0; i < num_args && i < 6; i++) {
        KyX64Reg arg_reg = X64_RDI;
        switch (i) {
            case 0: arg_reg = X64_RDI; break;
            case 1: arg_reg = X64_RSI; break;
            case 2: arg_reg = X64_RDX; break;
            case 3: arg_reg = X64_RCX; break;
            case 4: arg_reg = X64_R8; break;
            case 5: arg_reg = X64_R9; break;
        }
        KyVReg *dst_phys = get_phys_vreg(b, arg_reg);
        KyX64Ins *mov = add_insn(b, X64_MOV_REG_REG);
        mov->dst = dst_phys;
        mov->src1 = args[i];
    }

    /* call target */
    KyX64Ins *call = add_insn(b, X64_CALL);
    call->imm = (int64_t)(uintptr_t)target;
    call->is_terminator = 0;

    /* Move rax to result vreg */
    if (result) {
        KyVReg *rax_phys = get_phys_vreg(b, X64_RAX);
        KyX64Ins *mv = add_insn(b, X64_MOV_REG_REG);
        mv->dst = result;
        mv->src1 = rax_phys;
    }
    return call;
}

/* ============================================================
 * Extended encoding for new instructions
 * ============================================================ */

/* Encode push reg */
static int encode_push(uint8_t *code, size_t code_size, size_t *off, KyX64Reg reg) {
    uint8_t buf[2];
    /* Convert our enum order to x86 encoding order (RAX=0, RCX=1, ...).
     * Our enum has RBX=1 but x86 encoding 1 is RCX; without this table
     * push rbx emits push rcx. */
    if ((unsigned)reg >= X64_REG_COUNT) return -1;
    uint8_t enc = ky_x64_enc[reg];
    if (enc >= 8) {
        buf[0] = 0x41;  /* REX.B */
        buf[1] = 0x50 + (enc & 7);
        return emit_bytes(code, code_size, off, buf, 2);
    }
    buf[0] = 0x50 + enc;
    return emit_bytes(code, code_size, off, buf, 1);
}

/* Encode pop reg */
static int encode_pop(uint8_t *code, size_t code_size, size_t *off, KyX64Reg reg) {
    uint8_t buf[2];
    if ((unsigned)reg >= X64_REG_COUNT) return -1;
    uint8_t enc = ky_x64_enc[reg];
    if (enc >= 8) {
        buf[0] = 0x41;  /* REX.B */
        buf[1] = 0x58 + (enc & 7);
        return emit_bytes(code, code_size, off, buf, 2);
    }
    buf[0] = 0x58 + enc;
    return emit_bytes(code, code_size, off, buf, 1);
}

/* Encode mov r/m64, r64 with REX.B for extended regs */
static int encode_mov_reg_reg_ext(uint8_t *code, size_t code_size, size_t *off,
                                   KyX64Reg dst, KyX64Reg src) {
    uint8_t buf[3];
    uint8_t rex = REX_W;
    if (dst >= 8) rex |= 0x01;  /* REX.B */
    if (src >= 8) rex |= 0x04;  /* REX.R */
    buf[0] = rex;
    buf[1] = 0x89;  /* mov r/m64, r64 */
    buf[2] = 0xC0 | ((src & 7) << 3) | (dst & 7);
    return emit_bytes(code, code_size, off, buf, 3);
}

/* Encode call rel32 */
static int encode_call_rel32(uint8_t *code, size_t code_size, size_t *off,
                              int32_t rel32) {
    uint8_t buf[5];
    buf[0] = 0xE8;
    memcpy(buf + 1, &rel32, 4);
    return emit_bytes(code, code_size, off, buf, 5);
}

/* ============================================================
 * Enhanced emitter — handles push/pop/call
 * ============================================================ */

int kyx64_emit_with_calls(KyX64Backend *b, uint8_t *code, size_t code_size, size_t *code_len) {
    if (!b || !code || !code_len) return -1;

    size_t off = 0;

    for (uint32_t i = 0; i < b->num_insns; i++) {
        KyX64Ins *ins = b->insns[i];
        if (!ins) continue;

        int rc = 0;
        switch (ins->op) {
            case X64_MOV_REG_IMM:
                if (ins->dst && ins->dst->phys != X64_REG_NONE)
                    rc = encode_mov_imm64(code, code_size, &off, ins->dst->phys, ins->imm);
                break;

            case X64_MOV_REG_REG:
                if (ins->dst && ins->src1 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src1->phys != X64_REG_NONE)
                    rc = encode_mov_reg_reg(code, code_size, &off,
                                            ins->dst->phys, ins->src1->phys);
                break;

            case X64_ADD_REG_REG:
                if (ins->dst && ins->src1 && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src1->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    if (ins->dst->phys != ins->src1->phys) {
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    }
                    rc = encode_add_reg_reg(code, code_size, &off,
                                            ins->dst->phys, ins->src2->phys);
                }
                break;

            case X64_SUB_REG_REG:
                if (ins->dst && ins->src1 && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src1->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    if (ins->dst->phys != ins->src1->phys) {
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    }
                    rc = encode_sub_reg_reg(code, code_size, &off,
                                            ins->dst->phys, ins->src2->phys);
                }
                break;

            case X64_MUL_REG_REG:
                if (ins->dst && ins->src1 && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src1->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    if (ins->dst->phys != ins->src1->phys) {
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    }
                    rc = encode_imul_reg_reg(code, code_size, &off,
                                             ins->dst->phys, ins->src2->phys);
                }
                break;

            case X64_AND_REG_REG:
            case X64_OR_REG_REG:
            case X64_XOR_REG_REG: {
                if (ins->dst && ins->src1 && ins->src2 &&
                    ins->dst->phys != X64_REG_NONE &&
                    ins->src1->phys != X64_REG_NONE &&
                    ins->src2->phys != X64_REG_NONE) {
                    if (ins->dst->phys != ins->src1->phys) {
                        encode_mov_reg_reg(code, code_size, &off,
                                          ins->dst->phys, ins->src1->phys);
                    }
                    if (ins->op == X64_AND_REG_REG)
                        rc = encode_and_reg(code, code_size, &off, ins->dst->phys, ins->src2->phys);
                    else if (ins->op == X64_OR_REG_REG)
                        rc = encode_or_reg(code, code_size, &off, ins->dst->phys, ins->src2->phys);
                    else
                        rc = encode_xor_reg(code, code_size, &off, ins->dst->phys, ins->src2->phys);
                }
                break;
            }

            case X64_SHL_REG_IMM:
                if (ins->dst && ins->dst->phys != X64_REG_NONE)
                    rc = encode_shl_imm(code, code_size, &off, ins->dst->phys, (uint8_t)ins->imm);
                break;

            case X64_SHR_REG_IMM:
                if (ins->dst && ins->dst->phys != X64_REG_NONE)
                    rc = encode_shr_imm(code, code_size, &off, ins->dst->phys, (uint8_t)ins->imm);
                break;

            case X64_CMP_REG_IMM:
                if (ins->src1 && ins->src1->phys != X64_REG_NONE)
                    rc = encode_cmp_imm(code, code_size, &off, ins->src1->phys, (int32_t)ins->imm);
                break;

            case X64_CMP_REG_REG:
                if (ins->src1 && ins->src2 &&
                    ins->src1->phys != X64_REG_NONE && ins->src2->phys != X64_REG_NONE)
                    rc = encode_cmp_reg(code, code_size, &off, ins->src1->phys, ins->src2->phys);
                break;

            case X64_MOV_REG_MEM:
                if (ins->dst && ins->src1 &&
                    ins->dst->phys != X64_REG_NONE && ins->src1->phys != X64_REG_NONE)
                    rc = encode_load(code, code_size, &off,
                                    ins->dst->phys, ins->src1->phys, ins->mem_offset);
                break;

            case X64_MOV_MEM_REG:
                if (ins->dst && ins->src1 &&
                    ins->dst->phys != X64_REG_NONE && ins->src1->phys != X64_REG_NONE)
                    rc = encode_store(code, code_size, &off,
                                     ins->dst->phys, ins->mem_offset, ins->src1->phys);
                break;

            case X64_LEA:
                if (ins->dst && ins->src1 &&
                    ins->dst->phys != X64_REG_NONE && ins->src1->phys != X64_REG_NONE)
                    rc = encode_lea(code, code_size, &off,
                                   ins->dst->phys, ins->src1->phys, ins->mem_offset);
                break;

            case X64_JMP:
            case X64_JZ: case X64_JNZ:
            case X64_JE: case X64_JNE:
            case X64_JL: case X64_JLE:
            case X64_JG: case X64_JGE: {
                uint32_t fixup_pos = (ins->op == X64_JMP)
                                     ? (uint32_t)off + 1
                                     : (uint32_t)off + 2;
                if (ins->op == X64_JMP)
                    rc = encode_jmp(code, code_size, &off, 0);
                else
                    rc = encode_jcc(code, code_size, &off, ins->op, 0);
                for (uint32_t k = 0; k < b->num_labels; k++) {
                    if (b->labels[k]->id == ins->label_id) {
                        KyX64Label *l = b->labels[k];
                        if (l->num_patches >= l->patch_capacity) {
                            l->patch_capacity *= 2;
                            l->patch_offsets = (uint32_t *)realloc(
                                l->patch_offsets, l->patch_capacity * sizeof(uint32_t));
                        }
                        l->patch_offsets[l->num_patches++] = fixup_pos;
                        break;
                    }
                }
                break;
            }

            case X64_LABEL: {
                for (uint32_t k = 0; k < b->num_labels; k++) {
                    if (b->labels[k]->id == ins->label_id) {
                        b->labels[k]->byte_offset = (uint32_t)off;
                        break;
                    }
                }
                break;
            }

            case X64_PUSH: {
                KyX64Reg reg = ins->src1 ? ins->src1->phys : (KyX64Reg)ins->imm;
                if (reg != X64_REG_NONE)
                    rc = encode_push(code, code_size, &off, reg);
                break;
            }

            case X64_POP: {
                KyX64Reg reg = ins->dst ? ins->dst->phys : (KyX64Reg)ins->imm;
                if (reg != X64_REG_NONE)
                    rc = encode_pop(code, code_size, &off, reg);
                break;
            }

            case X64_CALL: {
                if (ins->src1 && ins->src1->phys != X64_REG_NONE) {
                    /* Indirect call through register: call *reg */
                    uint8_t buf[3];
                    uint8_t rex = 0x40;
                    if (ins->src1->phys >= 8) rex |= 0x01;
                    buf[0] = rex;
                    buf[1] = 0xFF;
                    buf[2] = 0xD0 | (ins->src1->phys & 7);
                    rc = emit_bytes(code, code_size, &off, buf, 3);
                } else if (ins->imm != 0) {
                    /* Direct call: mov rax, target; call rax */
                    uint8_t buf[12];
                    buf[0] = 0x48; buf[1] = 0xB8;
                    int64_t target = ins->imm;
                    memcpy(buf + 2, &target, 8);
                    buf[10] = 0xFF; buf[11] = 0xD0;
                    rc = emit_bytes(code, code_size, &off, buf, 12);
                }
                break;
            }

            case X64_RET: {
                uint8_t ret = 0xC3;
                rc = emit_bytes(code, code_size, &off, &ret, 1);
                break;
            }

            case X64_NOP:
            default:
                break;
        }
        if (rc < 0) return -1;
    }

    *code_len = off;
    return 0;
}

