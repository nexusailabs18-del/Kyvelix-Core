/*
 * bench/bench_uop.c — μOp cache benchmark
 *
 * Measures:
 *   - Lookup latency (cached hit)
 *   - Compile latency
 *   - Execute latency (native block)
 *   - Interpreter baseline
 *   - Speedup
 *
 * Build:
 *   gcc -O3 -march=native -mfma -mavx2 -I./include \
 *       bench/bench_uop.c src/kyjit_uop_cache.c -o bench/bench_uop
 *
 * Run:
 *   taskset -c 2 ./bench/bench_uop
 */

#define _GNU_SOURCE
#include "kyjit_uop_cache.h"
#include <stdlib.h>
#include <stdio.h>
#include <stdint.h>
#include <time.h>
#include <string.h>

static inline uint64_t ns_now(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
}

#define ITERS     100000000ULL
#define WARMUP    1000000ULL
#define RUNS      5

static int cmp_double(const void *a, const void *b) {
    double x = *(const double *)a, y = *(const double *)b;
    return (x > y) - (x < y);
}

/* ---------- 1. Lookup latency (cache hit) ---------- */

static double bench_lookup(void) {
    KyUopCache *cache = kyuop_create();
    const uint8_t bc[] = { UOP_ADD_I64, UOP_RETURN };
    uint64_t h = kyuop_hash_pattern(bc, 2);
    kyuop_compile(cache, h, bc, 2);

    double samples[RUNS];
    for (int r = 0; r < RUNS; r++) {
        volatile uint64_t sink = 0;
        for (uint64_t i = 0; i < WARMUP; i++) {
            KyUopBlock *b = kyuop_lookup(cache, h);
            sink += (uint64_t)b;
        }
        uint64_t t0 = ns_now();
        for (uint64_t i = 0; i < ITERS; i++) {
            KyUopBlock *b = kyuop_lookup(cache, h);
            sink += (uint64_t)b;
        }
        uint64_t t1 = ns_now();
        samples[r] = (double)(t1 - t0) / (double)ITERS;
        (void)sink;
    }

    kyuop_destroy(cache);
    qsort(samples, RUNS, sizeof(double), cmp_double);
    return samples[RUNS / 2];
}

/* ---------- 2. Execute latency (native block) ---------- */

static double bench_execute(void) {
    KyUopCache *cache = kyuop_create();
    const uint8_t bc[] = { UOP_ADD_I64, UOP_RETURN };
    uint64_t h = kyuop_hash_pattern(bc, 2);
    kyuop_compile(cache, h, bc, 2);

    double samples[RUNS];
    for (int r = 0; r < RUNS; r++) {
        volatile int64_t sink = 0;
        for (uint64_t i = 0; i < WARMUP; i++) {
            sink += kyuop_execute(cache, h, 5, 7);
        }
        uint64_t t0 = ns_now();
        for (uint64_t i = 0; i < ITERS; i++) {
            sink += kyuop_execute(cache, h, 5, 7);
        }
        uint64_t t1 = ns_now();
        samples[r] = (double)(t1 - t0) / (double)ITERS;
        (void)sink;
    }

    kyuop_destroy(cache);
    qsort(samples, RUNS, sizeof(double), cmp_double);
    return samples[RUNS / 2];
}

/* ---------- 3. Interpreter baseline (for comparison) ---------- */

/* Simple interpreter that handles ADD via switch */
static int64_t interp_execute(const uint8_t *bc, size_t len, int64_t a, int64_t b) {
    int64_t result = 0;
    for (size_t i = 0; i < len; ) {
        uint8_t op = bc[i];
        switch (op) {
            case UOP_ADD_I64: result = a + b; i++; break;
            case UOP_SUB_I64: result = a - b; i++; break;
            case UOP_MUL_I64: result = a * b; i++; break;
            case UOP_RETURN:  return result;
            default: i++;
        }
    }
    return result;
}

static double bench_interpreter(void) {
    const uint8_t bc[] = { UOP_ADD_I64, UOP_RETURN };

    double samples[RUNS];
    for (int r = 0; r < RUNS; r++) {
        volatile int64_t sink = 0;
        for (uint64_t i = 0; i < WARMUP; i++) {
            sink += interp_execute(bc, 2, 5, 7);
        }
        uint64_t t0 = ns_now();
        for (uint64_t i = 0; i < ITERS; i++) {
            sink += interp_execute(bc, 2, 5, 7);
        }
        uint64_t t1 = ns_now();
        samples[r] = (double)(t1 - t0) / (double)ITERS;
        (void)sink;
    }

    qsort(samples, RUNS, sizeof(double), cmp_double);
    return samples[RUNS / 2];
}

/* ---------- 4. Compile latency ---------- */

static double bench_compile(void) {
    const int N = 10000;
    double samples[RUNS];

    for (int r = 0; r < RUNS; r++) {
        KyUopCache *cache = kyuop_create();
        uint64_t t0 = ns_now();
        for (int i = 0; i < N; i++) {
            uint8_t bc[16];
            bc[0] = UOP_ADD_I64;
            bc[1] = UOP_LOAD_CONST;
            int64_t val = i;
            memcpy(bc + 2, &val, 8);
            bc[10] = UOP_RETURN;
            uint64_t h = kyuop_hash_pattern(bc, 11);
            kyuop_compile(cache, h, bc, 11);
        }
        uint64_t t1 = ns_now();
        samples[r] = (double)(t1 - t0) / (double)N;
        kyuop_destroy(cache);
    }

    qsort(samples, RUNS, sizeof(double), cmp_double);
    return samples[RUNS / 2];
}

/* ---------- main ---------- */

int main(void) {
    printf("{\n");
    printf("  \"benchmark\": \"kyjit_uop_cache\",\n");
    printf("  \"hardware\": \"Intel i5-1240P\",\n");
    printf("  \"iters\": %llu,\n", (unsigned long long)ITERS);

    double lookup_ns = bench_lookup();
    double execute_ns = bench_execute();
    double interp_ns = bench_interpreter();
    double compile_ns = bench_compile();

    printf("  \"results_ns_per_op\": {\n");
    printf("    \"lookup\":        %.4f,\n", lookup_ns);
    printf("    \"execute\":       %.4f,\n", execute_ns);
    printf("    \"interpreter\":   %.4f,\n", interp_ns);
    printf("    \"compile\":       %.4f\n", compile_ns);
    printf("  },\n");

    printf("  \"speedup_vs_interpreter\": %.2f,\n", interp_ns / execute_ns);
    printf("  \"date\": \"2026-09-19\"\n");
    printf("}\n");

    return 0;
}
