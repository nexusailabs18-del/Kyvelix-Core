/* Dead code elimination */
int kyir_opt_dce(KyGraph *g);

/* Global value numbering (basic) */
int kyir_opt_gvn(KyGraph *g);

/* Run all optimizations until fixed point */
int kyir_optimize(KyGraph *g);

/* ============================================================
 * Layer 7: Graph Verifier
 * ============================================================ */

typedef struct KyVerifyResult {
    int ok;
    uint32_t errors;
    char messages[16][128];
} KyVerifyResult;

KyVerifyResult kyir_graph_verify(KyGraph *g);

/* ============================================================
 * Utility
 * ============================================================ */

uint32_t kyir_node_use_count(const KyNode *n);
void     kyir_node_remove_use(KyNode *n, KyNode *use);
void     kyir_node_replace_uses(KyGraph *g, KyNode *old_node, KyNode *new_node);
int      kyir_node_is_constant(const KyNode *n);
int64_t  kyir_node_const_i64(const KyNode *n);

/* ============================================================
 * Layer 8: SSA Construction
 *
 * Braun et al. algorithm:
 *   1. Compute dominance frontiers
 *   2. Insert phi nodes at dominance frontiers
 *   3. Rename variables via dominator tree DFS
 * ============================================================ */

typedef struct KyDominanceFrontier {
    KyBlock **frontier;
    uint32_t  num_blocks;
    uint32_t  capacity;
} KyDominanceFrontier;

typedef struct KySSAContext {
    KyGraph    *graph;
    KyDomTree  *domtree;
    KyBlock   **blocks;       /* RPO order */

    /* Dominance frontiers per block */
    KyDominanceFrontier *df;

    /* Current variable definitions (stack of versions) */
    struct {
        KyNode **defs;        /* stack of definitions */
        uint32_t depth;
        uint32_t capacity;
    } *var_defs;
    uint32_t num_vars;

    /* Phi nodes inserted */
    KyNode **phis;
    uint32_t num_phis;
    uint32_t phi_capacity;
} KySSAContext;

/* Compute dominance frontiers */
KyDominanceFrontier *kyir_domfrontier_build(KyGraph *g, KyDomTree *dt);
void kyir_domfrontier_destroy(KyDominanceFrontier *df);

/* SSA construction */
KySSAContext *kyir_ssa_create(KyGraph *g, KyDomTree *dt);
void          kyir_ssa_destroy(KySSAContext *ssa);

/* Main SSA construction entry point */
int kyir_ssa_construct_full(KyGraph *g);

/* Phi node creation */
KyNode *kyir_phi_create(KyGraph *g, uint32_t num_inputs);

/* SSA print */
void kyir_ssa_print(KySSAContext *ssa);

#endif /* KYJIT_IR_H */
