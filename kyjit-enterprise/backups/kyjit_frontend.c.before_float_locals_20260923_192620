/*
 * kyjit_frontend.c — lexer + recursive-descent parser for .ky.
 *
 * Parses source text and drives KyIRBuilder directly (no AST).
 * Every parse_* function returns a KyNode* for expressions or
 * emits statements into the current block.
 *
 * Error handling: on any error, sets ctx->err (a char buffer),
 * sets ctx->err_flagged, and returns NULL / does nothing. The
 * caller checks err_flagged after parse_program.
 */

#define _GNU_SOURCE
#include "kyjit_frontend.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <stdint.h>
#include <stdarg.h>

/* ============================================================
 * Tokens
 * ============================================================ */

typedef enum {
    TK_EOF = 0,
    TK_INT,          /* integer literal */
    TK_STRING,       /* string literal */
    TK_FLOAT,        /* floating-point literal */
    TK_IDENT,        /* identifier */
    TK_KW_INT,       /* 'int' keyword */
    TK_IF, TK_ELSE, TK_RETURN, TK_WRITE,
    TK_LPAREN, TK_RPAREN,
    TK_LBRACE, TK_RBRACE,
    TK_LBRACKET, TK_RBRACKET,
    TK_COLON, TK_DOT,
    TK_SEMI, TK_COMMA,
    TK_PLUS, TK_MINUS, TK_STAR, TK_SLASH, TK_PERCENT,
    TK_AMP, TK_PIPE, TK_CARET, TK_TILDE,
    TK_SHL, TK_SHR,
    TK_EQ, TK_NE, TK_LT, TK_LE, TK_GT, TK_GE,
    TK_ASSIGN,
    TK_UNKNOWN
} TokKind;

typedef struct {
    TokKind  kind;
    int64_t  ival;      /* for TK_INT */
    double   fval;      /* for TK_FLOAT */
    char    *sval;      /* for TK_STRING (heap; caller frees) */
    size_t   slen;      /* decoded length of sval */
    int      line;
    int      col;
} Token;

typedef struct {
    char     name[64];
    int32_t  offset;
    uint32_t shape_id;    /* 0xFFFFFFFF if unknown/not-object */
    int      is_array;    /* 1 if this local holds an array */
} LocalVar;

typedef struct {
    const char *src;
    const char *filename;
    size_t      pos;
    int         line;
    int         col;

    Token       cur;
    Token       peeked;   /* one-token lookahead buffer */
    int         have_peek;

    KyGraph    *graph;
    KyIRBuilder*b;
    KyBlock    *entry_block;
    int         parsed_return;   /* set after first top-level return */

    char       *errbuf;
    size_t      errlen;
    int         err_flagged;

    LocalVar    locals[64];
    int         num_locals;
    int32_t     next_local_offset;

    /* Tracks the most recent identifier name seen by parse_primary.
     * Used by parse_postfix to resolve obj.field shape lookups. */
    char        last_ident[64];

    /* Tracks the shape of the most recent object literal seen by
     * parse_primary. Used when the left-hand side of `.field` is an
     * object literal rather than a variable. 0xFFFFFFFF = unknown. */
    uint32_t    last_shape;
} ParseCtx;

/* Forward declarations for parser helpers used before their
 * definitions. */
static int   find_local(ParseCtx *ctx, const char *name);
static int32_t alloc_local(ParseCtx *ctx, const char *name);
static void  parse_stmt(ParseCtx *ctx);
static KyNode *parse_postfix(ParseCtx *ctx);
static uint32_t find_local_shape(ParseCtx *ctx, const char *name, int *is_array);

/* ============================================================
 * Errors
 * ============================================================ */

static void set_err(ParseCtx *ctx, int line, int col, const char *fmt, ...) {
    if (!ctx || ctx->err_flagged) return;
    ctx->err_flagged = 1;
    if (!ctx->errbuf || ctx->errlen == 0) return;

    char msg[256];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(msg, sizeof(msg), fmt, ap);
    va_end(ap);

    snprintf(ctx->errbuf, ctx->errlen, "%s:%d:%d: %s",
             ctx->filename ? ctx->filename : "<source>",
             line, col, msg);
}

/* ============================================================
 * Lexer
 * ============================================================ */

static int is_ident_start(int c) { return isalpha(c) || c == '_'; }
static int is_ident_cont(int c)  { return isalnum(c) || c == '_'; }

static void skip_ws_and_comments(ParseCtx *ctx) {
    for (;;) {
        char c = ctx->src[ctx->pos];
        if (c == '\0') return;

        if (c == '\n') { ctx->line++; ctx->col = 1; ctx->pos++; continue; }
        if (c == ' ' || c == '\t' || c == '\r') { ctx->pos++; ctx->col++; continue; }

        /* // line comment */
        if (c == '/' && ctx->src[ctx->pos + 1] == '/') {
            while (ctx->src[ctx->pos] && ctx->src[ctx->pos] != '\n') {
                ctx->pos++; ctx->col++;
            }
            continue;
        }
        /* /* block comment * / */
        if (c == '/' && ctx->src[ctx->pos + 1] == '*') {
            ctx->pos += 2; ctx->col += 2;
            while (ctx->src[ctx->pos]) {
                if (ctx->src[ctx->pos] == '*' && ctx->src[ctx->pos + 1] == '/') {
                    ctx->pos += 2; ctx->col += 2;
                    break;
                }
                if (ctx->src[ctx->pos] == '\n') { ctx->line++; ctx->col = 1; }
                else ctx->col++;
                ctx->pos++;
            }
            continue;
        }
        return;
    }
}

static Token lex_one(ParseCtx *ctx) {
    skip_ws_and_comments(ctx);

    Token t;
    memset(&t, 0, sizeof(t));
    t.line = ctx->line;
    t.col  = ctx->col;

    char c = ctx->src[ctx->pos];

    if (c == '\0') { t.kind = TK_EOF; return t; }

    /* Numeric literal: integer or float */
    if (isdigit((unsigned char)c)) {        /* Look ahead: could be "3", "3.14", "1e5", "2.5e-1"
         * Rule: if we see a '.' followed by a digit, OR an 'e'/'E'
         * exponent, it's a float. */
        size_t scan = ctx->pos;
        int is_float = 0;
        while (isdigit((unsigned char)ctx->src[scan])) scan++;
        if (ctx->src[scan] == '.' && isdigit((unsigned char)ctx->src[scan + 1])) {
            is_float = 1;
        }
        if (!is_float && (ctx->src[scan] == 'e' || ctx->src[scan] == 'E')) {
            size_t s2 = scan + 1;
            if (ctx->src[s2] == '+' || ctx->src[s2] == '-') s2++;
            if (isdigit((unsigned char)ctx->src[s2])) is_float = 1;
        }

        if (is_float) {
            /* Consume the float literal */
            size_t start = ctx->pos;
            while (isdigit((unsigned char)ctx->src[ctx->pos])) { ctx->pos++; ctx->col++; }
            if (ctx->src[ctx->pos] == '.') {
                ctx->pos++; ctx->col++;
                while (isdigit((unsigned char)ctx->src[ctx->pos])) { ctx->pos++; ctx->col++; }
            }
            if (ctx->src[ctx->pos] == 'e' || ctx->src[ctx->pos] == 'E') {
                ctx->pos++; ctx->col++;
                if (ctx->src[ctx->pos] == '+' || ctx->src[ctx->pos] == '-') { ctx->pos++; ctx->col++; }
                while (isdigit((unsigned char)ctx->src[ctx->pos])) { ctx->pos++; ctx->col++; }
            }
            char buf[64];
            size_t len = ctx->pos - start;
            if (len >= sizeof(buf)) len = sizeof(buf) - 1;
            memcpy(buf, ctx->src + start, len);
            buf[len] = 0;
            t.kind = TK_FLOAT;
            t.fval = strtod(buf, NULL);            return t;
        }

        t.kind = TK_INT;
        if (c == '0' && (ctx->src[ctx->pos + 1] == 'x' || ctx->src[ctx->pos + 1] == 'X')) {
            ctx->pos += 2; ctx->col += 2;
            int64_t v = 0;
            while (isxdigit((unsigned char)ctx->src[ctx->pos])) {
                char h = ctx->src[ctx->pos];
                int d = (h >= '0' && h <= '9') ? (h - '0')
                      : (h >= 'a' && h <= 'f') ? (h - 'a' + 10)
                      : (h - 'A' + 10);
                v = v * 16 + d;
                ctx->pos++; ctx->col++;
            }
            t.ival = v;
        } else {
            int64_t v = 0;
            while (isdigit((unsigned char)ctx->src[ctx->pos])) {
                v = v * 10 + (ctx->src[ctx->pos] - '0');
                ctx->pos++; ctx->col++;
            }
            t.ival = v;
        }
        return t;
    }

    /* String literal (double-quoted). Processes standard escapes:
     *   \n \t \r \\ \" \0 \xNN
     * The token's slen holds the decoded length. */
    if (c == '"') {
        ctx->pos++; ctx->col++;

        /* Upper bound: one output byte per input byte. */
        size_t cap = 64;
        char  *buf = (char *)malloc(cap);
        if (!buf) { set_err(ctx, t.line, t.col, "oom"); t.kind = TK_UNKNOWN; return t; }
        size_t  n = 0;

        while (ctx->src[ctx->pos] && ctx->src[ctx->pos] != '"' &&
               ctx->src[ctx->pos] != '\n') {
            char ch = ctx->src[ctx->pos];

            if (n + 1 >= cap) {
                cap *= 2;
                char *nb = (char *)realloc(buf, cap);
                if (!nb) { free(buf); set_err(ctx, t.line, t.col, "oom"); t.kind = TK_UNKNOWN; return t; }
                buf = nb;
            }

            if (ch == '\\') {
                ctx->pos++; ctx->col++;
                char esc = ctx->src[ctx->pos];
                switch (esc) {
                    case 'n': buf[n++] = '\n'; break;
                    case 't': buf[n++] = '\t'; break;
                    case 'r': buf[n++] = '\r'; break;
                    case '\\': buf[n++] = '\\'; break;
                    case '"': buf[n++] = '"'; break;
                    case '0': buf[n++] = '\0'; break;
                    case 'x': {
                        ctx->pos++; ctx->col++;
                        int v = 0, k = 0;
                        while (k < 2 && isxdigit((unsigned char)ctx->src[ctx->pos])) {
                            char h = ctx->src[ctx->pos];
                            int d = (h >= '0' && h <= '9') ? (h - '0')
                                  : (h >= 'a' && h <= 'f') ? (h - 'a' + 10)
                                  : (h - 'A' + 10);
                            v = v * 16 + d;
                            ctx->pos++; ctx->col++; k++;
                        }
                        buf[n++] = (char)v;
                        continue;   /* pos already advanced */
                    }
                    default:
                        /* Unknown escape: emit the char verbatim. */
                        buf[n++] = esc;
                        break;
                }
                ctx->pos++; ctx->col++;
                continue;
            }

            buf[n++] = ch;
            ctx->pos++; ctx->col++;
        }

        if (ctx->src[ctx->pos] != '"') {
            free(buf);
            set_err(ctx, t.line, t.col, "unterminated string literal");
            t.kind = TK_UNKNOWN;
            return t;
        }
        buf[n] = '\0';
        t.kind = TK_STRING;
        t.sval = buf;
        t.slen = n;
        ctx->pos++; ctx->col++;
        return t;
    }

    /* Identifier or keyword */
    if (is_ident_start(c)) {
        size_t start = ctx->pos;
        while (is_ident_cont(ctx->src[ctx->pos])) {
            ctx->pos++; ctx->col++;
        }
        size_t len = ctx->pos - start;
        char buf[32];
        if (len >= sizeof(buf)) len = sizeof(buf) - 1;
        memcpy(buf, ctx->src + start, len);
        buf[len] = '\0';

        if      (!strcmp(buf, "if"))     t.kind = TK_IF;
        else if (!strcmp(buf, "else"))   t.kind = TK_ELSE;
        else if (!strcmp(buf, "return")) t.kind = TK_RETURN;
        else if (!strcmp(buf, "write"))  t.kind = TK_WRITE;
        else if (!strcmp(buf, "int"))    t.kind = TK_KW_INT;
        else {
            t.kind = TK_IDENT;
            t.sval = (char *)malloc(len + 1);
            if (t.sval) { memcpy(t.sval, buf, len); t.sval[len] = 0; }
            t.slen = len;
        }
        return t;
    }

    /* Two-char operators */
    char c1 = ctx->src[ctx->pos + 1];
    if (c == '<' && c1 == '<') { ctx->pos += 2; ctx->col += 2; t.kind = TK_SHL; return t; }
    if (c == '>' && c1 == '>') { ctx->pos += 2; ctx->col += 2; t.kind = TK_SHR; return t; }
    if (c == '=' && c1 == '=') { ctx->pos += 2; ctx->col += 2; t.kind = TK_EQ;  return t; }
    if (c == '!' && c1 == '=') { ctx->pos += 2; ctx->col += 2; t.kind = TK_NE;  return t; }
    if (c == '<' && c1 == '=') { ctx->pos += 2; ctx->col += 2; t.kind = TK_LE;  return t; }
    if (c == '>' && c1 == '=') { ctx->pos += 2; ctx->col += 2; t.kind = TK_GE;  return t; }

    /* Single-char */
    ctx->pos++; ctx->col++;
    switch (c) {
        case '(': t.kind = TK_LPAREN;  return t;
        case ')': t.kind = TK_RPAREN;  return t;
        case '{': t.kind = TK_LBRACE;  return t;
        case '}': t.kind = TK_RBRACE;  return t;
        case '[': t.kind = TK_LBRACKET; return t;
        case ']': t.kind = TK_RBRACKET; return t;
        case ':': t.kind = TK_COLON;    return t;
        case '.': t.kind = TK_DOT;      return t;
        case ';': t.kind = TK_SEMI;    return t;
        case ',': t.kind = TK_COMMA;   return t;
        case '+': t.kind = TK_PLUS;    return t;
        case '-': t.kind = TK_MINUS;   return t;
        case '*': t.kind = TK_STAR;    return t;
        case '/': t.kind = TK_SLASH;   return t;
        case '%': t.kind = TK_PERCENT; return t;
        case '&': t.kind = TK_AMP;     return t;
        case '|': t.kind = TK_PIPE;    return t;
        case '^': t.kind = TK_CARET;   return t;
        case '~': t.kind = TK_TILDE;   return t;
        case '<': t.kind = TK_LT;      return t;
        case '>': t.kind = TK_GT;      return t;
        case '=': t.kind = TK_ASSIGN;  return t;
    }

    set_err(ctx, t.line, t.col, "unexpected character '%c' (0x%02x)",
            (c >= 32 && c < 127) ? c : '?', (unsigned char)c);
    t.kind = TK_UNKNOWN;
    return t;
}

/* Advance to next token. Frees any heap string in the old cur. */
static void next_tok(ParseCtx *ctx) {
    if (ctx->cur.sval) { free(ctx->cur.sval); ctx->cur.sval = NULL; }
    if (ctx->have_peek) {
        ctx->cur = ctx->peeked;
        ctx->have_peek = 0;
        ctx->peeked.sval = NULL;
    } else {
        ctx->cur = lex_one(ctx);
    }
}

/* One-token lookahead. */
static Token *peek_tok(ParseCtx *ctx) {
    if (!ctx->have_peek) {
        ctx->peeked = lex_one(ctx);
        ctx->have_peek = 1;
    }
    return &ctx->peeked;
}

/* ============================================================
 * Parser — expression grammar (precedence climbing)
 * ============================================================ */

static KyNode *parse_expr(ParseCtx *ctx);

static KyNode *parse_primary(ParseCtx *ctx) {
    if (ctx->err_flagged) return NULL;

    ctx->last_ident[0] = '\0';
    ctx->last_shape = 0xFFFFFFFFu;

    if (ctx->cur.kind == TK_INT) {
        KyNode *n = kyir_build_const(ctx->b, ctx->cur.ival);
        next_tok(ctx);
        return n;
    }
    if (ctx->cur.kind == TK_FLOAT) {
        KyNode *n = kyir_build_const_f64(ctx->b, ctx->cur.fval);
        next_tok(ctx);
        return n;
    }

    /* Array literal: [e1, e2, e3] */
    if (ctx->cur.kind == TK_LBRACKET) {
        next_tok(ctx);
        KyNode *elements[64];
        int count = 0;
        if (ctx->cur.kind != TK_RBRACKET) {
            for (;;) {
                if (count >= 64) {
                    set_err(ctx, ctx->cur.line, ctx->cur.col,
                            "array literal too large (max 64)");
                    return NULL;
                }
                elements[count] = parse_expr(ctx);
                if (!elements[count]) return NULL;
                count++;
                if (ctx->cur.kind == TK_COMMA) { next_tok(ctx); continue; }
                break;
            }
        }
        if (ctx->cur.kind != TK_RBRACKET) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ']'");
            return NULL;
        }
        next_tok(ctx);

        KyNode *len = kyir_build_const(ctx->b, count);
        if (!len) return NULL;
        KyNode *arr = kyir_build_new_array(ctx->b, len);
        if (!arr) return NULL;
        for (int k = 0; k < count; k++) {
            KyNode *idx = kyir_build_const(ctx->b, k);
            if (!idx) return NULL;
            kyir_build_array_store(ctx->b, arr, idx, elements[k]);
        }
        return arr;
    }

    /* Object literal: {a: e1, b: e2} */
    if (ctx->cur.kind == TK_LBRACE) {
        next_tok(ctx);
        char         name_storage[64][64];
        const char  *names[64];
        KyNode      *values[64];
        int          count = 0;
        if (ctx->cur.kind != TK_RBRACE) {
            for (;;) {
                if (count >= 64) {
                    set_err(ctx, ctx->cur.line, ctx->cur.col,
                            "object literal too large (max 64)");
                    return NULL;
                }
                if (ctx->cur.kind != TK_IDENT) {
                    set_err(ctx, ctx->cur.line, ctx->cur.col,
                            "expected field name");
                    return NULL;
                }
                strncpy(name_storage[count], ctx->cur.sval, 63);
                name_storage[count][63] = 0;
                names[count] = name_storage[count];
                next_tok(ctx);
                if (ctx->cur.kind != TK_COLON) {
                    set_err(ctx, ctx->cur.line, ctx->cur.col,
                            "expected ':' after field name");
                    return NULL;
                }
                next_tok(ctx);
                values[count] = parse_expr(ctx);
                if (!values[count]) return NULL;
                count++;
                if (ctx->cur.kind == TK_COMMA) { next_tok(ctx); continue; }
                break;
            }
        }
        if (ctx->cur.kind != TK_RBRACE) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected '}'");
            return NULL;
        }
        next_tok(ctx);

        uint32_t shape_id = kyir_intern_shape(ctx->graph, names, (uint32_t)count);
        KyNode *obj = kyir_build_new_object(ctx->b, shape_id);
        if (!obj) return NULL;
        for (int k = 0; k < count; k++) {
            int32_t off = kyir_shape_field_offset(ctx->graph, shape_id, names[k]);
            if (off < 0) continue;
            kyir_build_object_store(ctx->b, obj, off, values[k]);
        }
        /* Remember this shape so `.field` on the literal resolves. */
        ctx->last_shape = shape_id;
        return obj;
    }

    if (ctx->cur.kind == TK_IDENT &&
        (strcmp(ctx->cur.sval, "f64") == 0 || strcmp(ctx->cur.sval, "i64") == 0)) {
        char cast_name[8];
        strncpy(cast_name, ctx->cur.sval, 7); cast_name[7] = 0;
        next_tok(ctx);
        if (ctx->cur.kind != TK_LPAREN) {
            set_err(ctx, ctx->cur.line, ctx->cur.col,
                    "expected '(' after '%s'", cast_name);
            return NULL;
        }
        next_tok(ctx);
        KyNode *arg = parse_expr(ctx);
        if (!arg) return NULL;
        if (ctx->cur.kind != TK_RPAREN) {
            set_err(ctx, ctx->cur.line, ctx->cur.col,
                    "expected ')' after cast argument");
            return NULL;
        }
        next_tok(ctx);
        int arg_is_float = (arg->type == KYIR_TYPE_FLOAT64);
        if (strcmp(cast_name, "f64") == 0) {
            return arg_is_float ? arg : kyir_build_sitofp(ctx->b, arg);
        } else {
            return !arg_is_float ? arg : kyir_build_fptosi(ctx->b, arg);
        }
    }

    if (ctx->cur.kind == TK_IDENT) {
        int idx = find_local(ctx, ctx->cur.sval);
        if (idx < 0) {
            set_err(ctx, ctx->cur.line, ctx->cur.col,
                    "undefined variable: %s", ctx->cur.sval);
            return NULL;
        }
        /* Remember the name for postfix .field resolution. */
        strncpy(ctx->last_ident, ctx->cur.sval, 63);
        ctx->last_ident[63] = 0;
        int32_t offset = ctx->locals[idx].offset;
        next_tok(ctx);
        return kyir_build_load_local(ctx->b, offset);
    }

    if (ctx->cur.kind == TK_LPAREN) {
        next_tok(ctx);

        /* Intercept (i64) / (f64) followed by '(' as a cast.
         * Supports both `i64(x)` and `(i64)(x)`. */
        if (ctx->cur.kind == TK_IDENT &&
            (strcmp(ctx->cur.sval, "i64") == 0 ||
             strcmp(ctx->cur.sval, "f64") == 0)) {
            char cast_name[8];
            strncpy(cast_name, ctx->cur.sval, 7);
            cast_name[7] = 0;
            next_tok(ctx);
            if (ctx->cur.kind == TK_RPAREN) {
                next_tok(ctx);
                /* Accept both (i64)(expr) and (i64)expr. */
                int had_paren = 0;
                if (ctx->cur.kind == TK_LPAREN) {
                    next_tok(ctx);
                    had_paren = 1;
                }
                KyNode *arg = parse_expr(ctx);
                if (!arg) return NULL;
                if (had_paren) {
                    if (ctx->cur.kind != TK_RPAREN) {
                        set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ')'");
                        return NULL;
                    }
                    next_tok(ctx);
                }
                int arg_is_float = (arg->type == KYIR_TYPE_FLOAT64);
                if (strcmp(cast_name, "f64") == 0)
                    return arg_is_float ? arg : kyir_build_sitofp(ctx->b, arg);
                else
                    return !arg_is_float ? arg : kyir_build_fptosi(ctx->b, arg);
            }
            /* Fall through if it's not a cast after all */
            set_err(ctx, ctx->cur.line, ctx->cur.col,
                    "unexpected identifier inside parentheses");
            return NULL;
        }

        KyNode *n = parse_expr(ctx);
        if (ctx->cur.kind != TK_RPAREN) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ')'");
            return NULL;
        }
        next_tok(ctx);
        return n;
    }

    set_err(ctx, ctx->cur.line, ctx->cur.col,
            "expected expression, got token kind %d", ctx->cur.kind);
    return NULL;
}

/* Forward decl for parse_primary (defined above parse_postfix
 * in this file; parse_postfix needs to call it). */
static KyNode *parse_primary(ParseCtx *ctx);

/* Postfix: primary { '[' expr ']' | '.' IDENT | '.' 'length' } */
static KyNode *parse_postfix(ParseCtx *ctx) {
    if (ctx->err_flagged) return NULL;

    KyNode *node = parse_primary(ctx);
    if (!node) return NULL;

    for (;;) {
        if (ctx->cur.kind == TK_LBRACKET) {
            next_tok(ctx);
            KyNode *index = parse_expr(ctx);
            if (!index) return NULL;
            if (ctx->cur.kind != TK_RBRACKET) {
                set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ']'");
                return NULL;
            }
            next_tok(ctx);
            node = kyir_build_array_load(ctx->b, node, index);
            if (!node) return NULL;
        } else if (ctx->cur.kind == TK_DOT) {
            next_tok(ctx);
            if (ctx->cur.kind != TK_IDENT) {
                set_err(ctx, ctx->cur.line, ctx->cur.col,
                        "expected field name after '.'");
                return NULL;
            }
            char field[64];
            strncpy(field, ctx->cur.sval, 63); field[63] = 0;
            next_tok(ctx);

            if (strcmp(field, "length") == 0) {
                node = kyir_build_array_length(ctx->b, node);
                if (!node) return NULL;
                continue;
            }

            /* Resolve shape: prefer the last identifier's shape (for
             * named variables); fall back to the last literal's shape
             * (for object literals). */
            uint32_t shape_id = 0xFFFFFFFFu;
            if (ctx->last_ident[0] != 0) {
                shape_id = find_local_shape(ctx, ctx->last_ident, NULL);
            }
            if (shape_id == 0xFFFFFFFFu && ctx->last_shape != 0xFFFFFFFFu) {
                shape_id = ctx->last_shape;
            }
            if (shape_id == 0xFFFFFFFFu) {
                set_err(ctx, ctx->cur.line, ctx->cur.col,
                        "cannot resolve property '%s' on this expression", field);
                return NULL;
            }
            int32_t off = kyir_shape_field_offset(ctx->graph, shape_id, field);
            if (off < 0) {
                set_err(ctx, ctx->cur.line, ctx->cur.col,
                        "unknown field '%s' on '%s'", field, ctx->last_ident);
                return NULL;
            }
            node = kyir_build_object_load(ctx->b, node, off);
            if (!node) return NULL;
        } else {
            break;
        }
    }
    return node;
}

static KyNode *parse_unary(ParseCtx *ctx) {
    if (ctx->err_flagged) return NULL;

    if (ctx->cur.kind == TK_MINUS) {
        next_tok(ctx);
        KyNode *a = parse_unary(ctx);
        if (!a) return NULL;
        if (a->type == KYIR_TYPE_FLOAT64)
            return kyir_build_neg_f64(ctx->b, a);
        return kyir_build_neg(ctx->b, a);
    }
    if (ctx->cur.kind == TK_TILDE) {
        next_tok(ctx);
        KyNode *a = parse_unary(ctx);
        if (!a) return NULL;
        return kyir_build_not(ctx->b, a);
    }
    return parse_postfix(ctx);
}

static KyNode *parse_mul(ParseCtx *ctx) {
    KyNode *lhs = parse_unary(ctx);
    if (!lhs) return NULL;
    while (ctx->cur.kind == TK_STAR || ctx->cur.kind == TK_SLASH ||
           ctx->cur.kind == TK_PERCENT) {
        TokKind op = ctx->cur.kind;
        next_tok(ctx);
        KyNode *rhs = parse_unary(ctx);
        if (!rhs) return NULL;
        int lf = (lhs->type == KYIR_TYPE_FLOAT64);
        int rf = (rhs->type == KYIR_TYPE_FLOAT64);
        if (op == TK_PERCENT) {
            /* Modulo is integer-only */
            lhs = kyir_build_mod(ctx->b, lhs, rhs);
        } else if (lf || rf) {
            KyNode *la = lf ? lhs : kyir_build_sitofp(ctx->b, lhs);
            KyNode *ra = rf ? rhs : kyir_build_sitofp(ctx->b, rhs);
            if (op == TK_STAR)      lhs = kyir_build_mul_f64(ctx->b, la, ra);
            else                    lhs = kyir_build_div_f64(ctx->b, la, ra);
        } else {
            if (op == TK_STAR)      lhs = kyir_build_mul(ctx->b, lhs, rhs);
            else                    lhs = kyir_build_div(ctx->b, lhs, rhs);
        }
    }
    return lhs;
}

static KyNode *parse_add(ParseCtx *ctx) {
    KyNode *lhs = parse_mul(ctx);
    if (!lhs) return NULL;
    while (ctx->cur.kind == TK_PLUS || ctx->cur.kind == TK_MINUS) {
        TokKind op = ctx->cur.kind;
        next_tok(ctx);
        KyNode *rhs = parse_mul(ctx);
        if (!rhs) return NULL;
        int lf = (lhs->type == KYIR_TYPE_FLOAT64);
        int rf = (rhs->type == KYIR_TYPE_FLOAT64);
        if (lf || rf) {
            KyNode *la = lf ? lhs : kyir_build_sitofp(ctx->b, lhs);
            KyNode *ra = rf ? rhs : kyir_build_sitofp(ctx->b, rhs);
            lhs = (op == TK_PLUS)
                  ? kyir_build_add_f64(ctx->b, la, ra)
                  : kyir_build_sub_f64(ctx->b, la, ra);
        } else {
            lhs = (op == TK_PLUS)
                  ? kyir_build_add(ctx->b, lhs, rhs)
                  : kyir_build_sub(ctx->b, lhs, rhs);
        }
    }
    return lhs;
}

static KyNode *parse_shift(ParseCtx *ctx) {
    KyNode *lhs = parse_add(ctx);
    if (!lhs) return NULL;
    while (ctx->cur.kind == TK_SHL || ctx->cur.kind == TK_SHR) {
        TokKind op = ctx->cur.kind;
        next_tok(ctx);
        KyNode *rhs = parse_add(ctx);
        if (!rhs) return NULL;
        lhs = (op == TK_SHL)
              ? kyir_build_shl(ctx->b, lhs, rhs)
              : kyir_build_shr(ctx->b, lhs, rhs);
    }
    return lhs;
}

static KyNode *parse_and(ParseCtx *ctx) {
    KyNode *lhs = parse_shift(ctx);
    if (!lhs) return NULL;
    while (ctx->cur.kind == TK_AMP) {
        next_tok(ctx);
        KyNode *rhs = parse_shift(ctx);
        if (!rhs) return NULL;
        lhs = kyir_build_and(ctx->b, lhs, rhs);
    }
    return lhs;
}

static KyNode *parse_xor(ParseCtx *ctx) {
    KyNode *lhs = parse_and(ctx);
    if (!lhs) return NULL;
    while (ctx->cur.kind == TK_CARET) {
        next_tok(ctx);
        KyNode *rhs = parse_and(ctx);
        if (!rhs) return NULL;
        lhs = kyir_build_xor(ctx->b, lhs, rhs);
    }
    return lhs;
}

static KyNode *parse_or(ParseCtx *ctx) {
    KyNode *lhs = parse_xor(ctx);
    if (!lhs) return NULL;
    while (ctx->cur.kind == TK_PIPE) {
        next_tok(ctx);
        KyNode *rhs = parse_xor(ctx);
        if (!rhs) return NULL;
        lhs = kyir_build_or(ctx->b, lhs, rhs);
    }
    return lhs;
}

/* Comparison: lowest precedence above assignment. Non-associative:
 * "a < b < c" parses as "(a < b) < c" — which the IR handles
 * naturally (a bool-as-int vs c). Acceptable for this language. */
static KyNode *parse_expr(ParseCtx *ctx) {
    KyNode *lhs = parse_or(ctx);
    if (!lhs) return NULL;
    while (ctx->cur.kind == TK_EQ || ctx->cur.kind == TK_NE ||
           ctx->cur.kind == TK_LT || ctx->cur.kind == TK_LE ||
           ctx->cur.kind == TK_GT || ctx->cur.kind == TK_GE) {
        TokKind op = ctx->cur.kind;
        next_tok(ctx);
        KyNode *rhs = parse_or(ctx);
        if (!rhs) return NULL;
        switch (op) {
            case TK_EQ: lhs = kyir_build_cmp_eq(ctx->b, lhs, rhs); break;
            case TK_NE: lhs = kyir_build_cmp_ne(ctx->b, lhs, rhs); break;
            case TK_LT: lhs = kyir_build_cmp_lt(ctx->b, lhs, rhs); break;
            case TK_LE: lhs = kyir_build_cmp_le(ctx->b, lhs, rhs); break;
            case TK_GT: lhs = kyir_build_cmp_gt(ctx->b, lhs, rhs); break;
            case TK_GE: lhs = kyir_build_cmp_ge(ctx->b, lhs, rhs); break;
            default: break;
        }
    }
    return lhs;
}

/* ============================================================
 * Parser — statements
 * ============================================================ */

static int find_local(ParseCtx *ctx, const char *name) {
    for (int i = 0; i < ctx->num_locals; i++) {
        if (strcmp(ctx->locals[i].name, name) == 0) return i;
    }
    return -1;
}

/* Look up a variable's shape id. Returns 0xFFFFFFFF if unknown or
 * not found. Also sets *is_array if non-NULL. */
static uint32_t find_local_shape(ParseCtx *ctx, const char *name, int *is_array) {
    int idx = find_local(ctx, name);
    if (idx < 0) {
        if (is_array) *is_array = 0;
        return 0xFFFFFFFFu;
    }
    if (is_array) *is_array = ctx->locals[idx].is_array;
    return ctx->locals[idx].shape_id;
}

static int32_t alloc_local(ParseCtx *ctx, const char *name) {
    if (find_local(ctx, name) != -1) {
        set_err(ctx, ctx->cur.line, ctx->cur.col, "redeclaration of '%s'", name);
        return 0;
    }
    if (ctx->num_locals >= 64) {
        set_err(ctx, ctx->cur.line, ctx->cur.col, "too many locals");
        return 0;
    }
    strncpy(ctx->locals[ctx->num_locals].name, name, 63);
    ctx->locals[ctx->num_locals].name[63] = 0;
    ctx->locals[ctx->num_locals].offset = ctx->next_local_offset;
    ctx->locals[ctx->num_locals].shape_id = 0xFFFFFFFFu;
    ctx->locals[ctx->num_locals].is_array = 0;
    ctx->next_local_offset -= 8;
    ctx->num_locals++;
    return ctx->locals[ctx->num_locals - 1].offset;
}

static void parse_stmt(ParseCtx *ctx);

/* True if the current block has already been closed by a RETURN.
 * Used to stop parsing dead statements in a block. */
static int is_block_terminated(ParseCtx *ctx) {
    if (!ctx || !ctx->b) return 0;
    KyBlock *b = ctx->b->current_block;
    if (!b || !b->terminator) return 0;
    return b->terminator->opcode == IR_RETURN;
}

static void parse_block(ParseCtx *ctx) {
    /* cur is already past '{' */
    while (!ctx->err_flagged &&
           ctx->cur.kind != TK_RBRACE &&
           ctx->cur.kind != TK_EOF) {
        /* Skip statements after a return — they're unreachable. */
        if (is_block_terminated(ctx)) {
            /* Consume the rest of the block without emitting IR. */
            if (ctx->cur.kind == TK_RBRACE) break;
            next_tok(ctx);
            continue;
        }
        parse_stmt(ctx);
    }
    if (ctx->cur.kind != TK_RBRACE) {
        set_err(ctx, ctx->cur.line, ctx->cur.col, "expected '}'");
        return;
    }
    next_tok(ctx);
}

static void parse_stmt(ParseCtx *ctx) {
    if (ctx->err_flagged) return;

    /* if ( cond ) stmt [ else stmt ] */
    if (ctx->cur.kind == TK_IF) {
        next_tok(ctx);
        if (ctx->cur.kind != TK_LPAREN) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected '(' after 'if'");
            return;
        }
        next_tok(ctx);
        KyNode *cond = parse_expr(ctx);
        if (!cond) return;
        if (ctx->cur.kind != TK_RPAREN) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ')' after if condition");
            return;
        }
        next_tok(ctx);

        /* Build then/else labels. */
        KyNode *then_lbl = kyir_node_create(ctx->graph, IR_LABEL);
        KyNode *else_lbl = kyir_node_create(ctx->graph, IR_LABEL);
        kyir_build_if(ctx->b, cond, then_lbl, else_lbl);

        /* Then branch: current block is the then block. */
        KyBlock *then_blk = ctx->b->current_block;
        kyir_block_add_node(then_blk, then_lbl);
        parse_stmt(ctx);

        /* After then body, we need a join label UNLESS the then body
         * already terminates with RETURN (no fall-through). */
        KyNode *join_lbl = kyir_node_create(ctx->graph, IR_LABEL);
        /* Save current block before any jump. */
        KyBlock *then_end = ctx->b->current_block;
        int then_terminated = (then_end->terminator != NULL &&
                               then_end->terminator->opcode == IR_RETURN);

        if (!then_terminated) {
            /* Emit a jump to join. Use _no_open because we'll enter
             * the else block next. */
            kyir_build_jump_no_open(ctx->b, join_lbl);
        }

        /* Else branch. */
        KyBlock *else_blk = kyir_builder_enter_block(ctx->b, else_lbl);
        kyir_block_add_node(else_blk, else_lbl);

        if (ctx->cur.kind == TK_ELSE) {
            next_tok(ctx);
            parse_stmt(ctx);
        }
        /* else: empty else block — falls through to whatever comes next */

        KyBlock *else_end = ctx->b->current_block;
        int else_terminated = (else_end->terminator != NULL &&
                               else_end->terminator->opcode == IR_RETURN);

        if (!else_terminated) {
            kyir_build_jump_no_open(ctx->b, join_lbl);
        }

        /* Join block. Only enter it if at least one arm falls through. */
        if (!then_terminated || !else_terminated) {
            KyBlock *join_blk = kyir_builder_enter_block(ctx->b, join_lbl);
            kyir_block_add_node(join_blk, join_lbl);
        }
        return;
    }

    /* { stmts } */
    if (ctx->cur.kind == TK_LBRACE) {
        next_tok(ctx);
        parse_block(ctx);
        return;
    }

    /* return expr ; */
    if (ctx->cur.kind == TK_RETURN) {
        next_tok(ctx);
        KyNode *v = parse_expr(ctx);
        if (!v) return;
        if (ctx->cur.kind != TK_SEMI) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ';' after return");
            return;
        }
        next_tok(ctx);
        kyir_build_return(ctx->b, v);
        /* Block is now closed; parse_stmt may be called again. */
        return;
    }

    /* write(fd, "string", len) ; — emitted as IR_SYSCALL nr=1 (SYS_write).
     * We support only a numeric integer in the middle (pointer cast),
     * so this is really "write raw bytes at an address". Real string
     * literals come later when we have a data section. */
    if (ctx->cur.kind == TK_WRITE) {
        next_tok(ctx);
        if (ctx->cur.kind != TK_LPAREN) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected '(' after 'write'");
            return;
        }
        next_tok(ctx);

        KyNode *fd = parse_expr(ctx);
        if (!fd) return;
        if (ctx->cur.kind != TK_COMMA) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ',' in write(...)");
            return;
        }
        next_tok(ctx);

        /* String literal in the buffer slot: intern it and emit a
         * string-ptr const node. The ELF writer resolves the address. */
        KyNode *buf;
        if (ctx->cur.kind == TK_STRING) {
            const char *s = ctx->cur.sval ? ctx->cur.sval : "";
            uint32_t slen = (uint32_t)ctx->cur.slen;
            uint32_t idx = kyir_intern_string(ctx->graph, s, slen);
            if (idx == 0xFFFFFFFFu) {
                set_err(ctx, ctx->cur.line, ctx->cur.col,
                        "string pool exhausted");
                return;
            }
            buf = kyir_const_string_ptr(ctx->graph, idx);
            if (!buf) return;
            if (ctx->b->current_block)
                kyir_block_add_node(ctx->b->current_block, buf);
            next_tok(ctx);
        } else {
            buf = parse_expr(ctx);
            if (!buf) return;
        }

        if (ctx->cur.kind != TK_COMMA) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ',' in write(...)");
            return;
        }
        next_tok(ctx);
        KyNode *len = parse_expr(ctx);
        if (!len) return;
        if (ctx->cur.kind != TK_RPAREN) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ')' in write(...)");
            return;
        }
        next_tok(ctx);
        if (ctx->cur.kind != TK_SEMI) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ';' after write(...)");
            return;
        }
        next_tok(ctx);

        KyNode *nr = kyir_build_const(ctx->b, 1);   /* SYS_write */
        kyir_build_syscall(ctx->b, nr, fd, buf, len, NULL, NULL, NULL);
        return;
    }

    /* Local declaration: int x = expr; */
    if (ctx->cur.kind == TK_KW_INT) {
        next_tok(ctx);
        if (ctx->cur.kind != TK_IDENT) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected identifier after 'int'");
            return;
        }
        char name[64];
        strncpy(name, ctx->cur.sval, 63); name[63] = 0;
        next_tok(ctx);
        if (ctx->cur.kind != TK_ASSIGN) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected '=' in local declaration");
            return;
        }
        next_tok(ctx);
        KyNode *val = parse_expr(ctx);
        if (!val) return;
        if (ctx->cur.kind != TK_SEMI) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ';' after local declaration");
            return;
        }
        next_tok(ctx);
        int32_t offset = alloc_local(ctx, name);
        if (ctx->err_flagged) return;

        /* If the RHS is an array or object literal, remember the shape. */
        int idx = find_local(ctx, name);
        if (idx >= 0) {
            if (val->opcode == IR_NEW_ARRAY_DYN) {
                ctx->locals[idx].is_array = 1;
            } else if (val->opcode == IR_NEW_OBJECT_DYN) {
                ctx->locals[idx].shape_id = (uint32_t)val->constant.i64;
            }
        }
        kyir_build_store_local(ctx->b, offset, val);
        return;
    }

    /* Assignment to array element or object field:
     *   arr[i] = expr;
     *   obj.field = expr;
     * Parse a postfix expression; if the next token is '=', emit the
     * correct store instead of the load the postfix parser produced. */
    if (ctx->cur.kind == TK_IDENT) {
        /* Try parse_postfix path only if there's a '[' or '.' coming */
        Token *pk2 = peek_tok(ctx);
        if (pk2->kind == TK_LBRACKET || pk2->kind == TK_DOT) {
            /* Save current position isn't easy; instead, parse the
               postfix expression, then check for '='. */
            char saved_name[64];
            strncpy(saved_name, ctx->cur.sval, 63); saved_name[63] = 0;

            KyNode *lhs = parse_postfix(ctx);
            if (!lhs) return;

            if (ctx->cur.kind == TK_ASSIGN) {
                next_tok(ctx);
                KyNode *rhs = parse_expr(ctx);
                if (!rhs) return;
                if (ctx->cur.kind != TK_SEMI) {
                    set_err(ctx, ctx->cur.line, ctx->cur.col,
                            "expected ';' after assignment");
                    return;
                }
                next_tok(ctx);

                if (lhs->opcode == IR_ARRAY_LOAD) {
                    KyNode *arr   = lhs->value_inputs[0];
                    KyNode *index = lhs->value_inputs[1];
                    kyir_build_array_store(ctx->b, arr, index, rhs);
                } else if (lhs->opcode == IR_OBJECT_LOAD) {
                    KyNode *obj = lhs->value_inputs[0];
                    int32_t off = (int32_t)lhs->constant.i64;
                    kyir_build_object_store(ctx->b, obj, off, rhs);
                } else {
                    set_err(ctx, ctx->cur.line, ctx->cur.col,
                            "invalid assignment target");
                    return;
                }
                return;
            }

            /* Not an assignment: it's an expression statement that
             * starts with a variable and continues with [ or . */
            if (ctx->cur.kind != TK_SEMI) {
                set_err(ctx, ctx->cur.line, ctx->cur.col,
                        "expected ';' after expression");
                return;
            }
            next_tok(ctx);
            return;
        }
    }

    /* Assignment: x = expr; */
    if (ctx->cur.kind == TK_IDENT) {
        Token *pk = peek_tok(ctx);
        if (pk->kind == TK_ASSIGN) {
            char name[64];
            strncpy(name, ctx->cur.sval, 63); name[63] = 0;
            next_tok(ctx);
            next_tok(ctx);
            KyNode *val = parse_expr(ctx);
            if (!val) return;
            if (ctx->cur.kind != TK_SEMI) {
                set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ';' after assignment");
                return;
            }
            next_tok(ctx);
            int idx = find_local(ctx, name);
            if (idx < 0) {
                /* Implicit declaration: first assignment creates the local. */
                int32_t offset = alloc_local(ctx, name);
                if (ctx->err_flagged) return;
                idx = find_local(ctx, name);
                (void)offset;
            }
            /* Track shape/array info if the RHS is a literal */
            if (idx >= 0) {
                if (val->opcode == IR_NEW_ARRAY_DYN) {
                    ctx->locals[idx].is_array = 1;
                } else if (val->opcode == IR_NEW_OBJECT_DYN) {
                    ctx->locals[idx].shape_id = (uint32_t)val->constant.i64;
                }
            }
            kyir_build_store_local(ctx->b, ctx->locals[idx].offset, val);
            return;
        }
    }

    /* Expression statement: parse and discard the value. */
    {
        KyNode *e = parse_expr(ctx);
        if (!e) return;
        if (ctx->cur.kind != TK_SEMI) {
            set_err(ctx, ctx->cur.line, ctx->cur.col, "expected ';' after expression");
            return;
        }
        next_tok(ctx);
        /* Discard value. DCE will clean up if unused. */
    }
}

/* ============================================================
 * Top-level entry
 * ============================================================ */

KyGraph *kyjit_parse_source(const char *src,
                            const char *filename,
                            char *errbuf,
                            size_t errlen) {
    if (!src) return NULL;

    ParseCtx ctx;
    memset(&ctx, 0, sizeof(ctx));
    ctx.src = src;
    ctx.filename = filename ? filename : "<source>";
    ctx.line = 1;
    ctx.col = 1;
    ctx.errbuf = errbuf;
    ctx.errlen = errlen;
    if (errbuf && errlen) errbuf[0] = '\0';
    ctx.num_locals = 0;
    ctx.next_local_offset = -8;
    ctx.last_shape = 0xFFFFFFFFu;

    ctx.graph = kyir_graph_create();
    if (!ctx.graph) return NULL;

    ctx.b = kyir_builder_create(ctx.graph);
    if (!ctx.b) { kyir_graph_destroy(ctx.graph); return NULL; }

    /* Entry block. */
    ctx.entry_block = kyir_builder_new_block(ctx.b);
    kyir_builder_set_block(ctx.b, ctx.entry_block);

    /* Prime the lexer. */
    ctx.cur.kind = TK_EOF;
    next_tok(&ctx);

    while (!ctx.err_flagged && ctx.cur.kind != TK_EOF) {
        /* Once the top-level block has a return, further statements
         * are unreachable. Consume tokens without emitting IR. */
        if (is_block_terminated(&ctx)) {
            next_tok(&ctx);
            continue;
        }
        parse_stmt(&ctx);
    }

    if (ctx.cur.sval) free(ctx.cur.sval);
    if (ctx.peeked.sval) free(ctx.peeked.sval);

    if (ctx.err_flagged) {
        kyir_builder_destroy(ctx.b);
        kyir_graph_destroy(ctx.graph);
        return NULL;
    }

    kyir_builder_destroy(ctx.b);
    return ctx.graph;
}
