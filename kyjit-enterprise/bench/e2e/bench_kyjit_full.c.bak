/* KYJIT — FULL 75-FEATURE END-TO-END TEST
 * Tests every feature. Reports real numbers.
 * Machine: Intel i5-1240P
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <stdint.h>

static double now_ns(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1e9 + ts.tv_nsec;
}

static int pass_count = 0;
static int fail_count = 0;
static int skip_count = 0;

#define PASS(name, time_ns) do { \
    printf("  ✅ %-45s %10.2f ns\n", name, (double)(time_ns)); \
    pass_count++; \
} while(0)

#define FAIL(name, reason) do { \
    printf("  ❌ %-45s %s\n", name, reason); \
    fail_count++; \
} while(0)

#define SKIP(name, reason) do { \
    printf("  ⚠️  %-45s %s\n", name, reason); \
    skip_count++; \
} while(0)

#define SECTION(title) do { \
    printf("\n╔══════════════════════════════════════════════════╗\n"); \
    printf("║ %-48s ║\n", title); \
    printf("╠══════════════════════════════════════════════════╣\n"); \
} while(0)

/* ══════════════════════════════════════════════════════
 * 1-5: CORE (parser, bytecode, interpreter, μOp, LLVM)
 * ══════════════════════════════════════════════════════ */

extern long long kyjit_parse_numbers_branchless(const char*, int);

static void test_01_parser(void) {
    SECTION("1. PARSER (numbers)");
    const char *tests[] = {"1 2 3", "1+2+3", "123456"};
    int expected[] = {6, 6, 123456};
    for (int i = 0; i < 3; i++) {
        double t0 = now_ns();
        long long r = kyjit_parse_numbers_branchless(tests[i], strlen(tests[i]));
        double t1 = now_ns();
        if (r == expected[i]) PASS(tests[i], t1-t0);
        else FAIL(tests[i], "wrong result");
    }
}

#include "kyjit_bytecode.h"
#include "kyjit_interpreter.h"

static void test_02_bytecode(void) {
    SECTION("2. BYTECODE (11 opcodes)");
    KyBytecode code[] = {
        {BC_LOAD_CONST, 1, 0}, {BC_LOAD_CONST, 2, 0},
        {BC_ADD, 0, 0}, {BC_RETURN, 0, 0}
    };
    KyBytecodeBuf buf = {code, 4, 4};
    double t0 = now_ns();
    int r = kyjit_interpreter_execute(&buf, 0);
    double t1 = now_ns();
    if (r == 3) PASS("1 + 2 = 3", t1-t0);
    else FAIL("1 + 2", "wrong result");
}

#include "kyjit_uop_cache.h"

static void test_03_uop(void) {
    SECTION("3. μOP CACHE (5 blocks)");
    KyUopCache *c = kyjit_uop_cache_create();
    printf("  Cache: %d blocks, %zu bytes\n",
           kyjit_uop_cache_count(c), kyjit_uop_cache_size(c));
    
    const int ITERS = 1000000;
    volatile int sum = 0;
    
    struct { const char *op; int a, b, exp; } tests[] = {
        {"add", 5, 3, 8}, {"mul", 6, 7, 42}, {"sub", 10, 4, 6},
        {"inc", 41, 0, 42}, {"dec", 43, 0, 42}
    };
    
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 1000; j++) sum += kyjit_uop_cache_execute(c, tests[i].op, tests[i].a, tests[i].b);
        double t0 = now_ns();
        for (int j = 0; j < ITERS; j++)
            sum += kyjit_uop_cache_execute(c, tests[i].op, tests[i].a, tests[i].b);
        double t1 = now_ns();
        int r = kyjit_uop_cache_execute(c, tests[i].op, tests[i].a, tests[i].b);
        if (r == tests[i].exp) PASS(tests[i].op, (t1-t0)/ITERS);
        else FAIL(tests[i].op, "wrong result");
    }
    kyjit_uop_cache_destroy(c);
}

#include <llvm-c/Core.h>
#include <llvm-c/ExecutionEngine.h>

static void test_04_llvm(void) {
    SECTION("4. LLVM JIT (C IR)");
    LLVMContextRef ctx = LLVMContextCreate();
    LLVMModuleRef mod = LLVMModuleCreateWithNameInContext("t", ctx);
    
    LLVMTypeRef p[] = {LLVMInt32TypeInContext(ctx), LLVMInt32TypeInContext(ctx)};
    LLVMTypeRef ft = LLVMFunctionType(LLVMInt32TypeInContext(ctx), p, 2, 0);
    LLVMValueRef fn = LLVMAddFunction(mod, "add", ft);
    LLVMBasicBlockRef bb = LLVMAppendBasicBlockInContext(ctx, fn, "e");
    LLVMBuilderRef b = LLVMCreateBuilderInContext(ctx);
    LLVMPositionBuilderAtEnd(b, bb);
    LLVMValueRef s = LLVMBuildAdd(b, LLVMGetParam(fn,0), LLVMGetParam(fn,1), "s");
    LLVMBuildRet(b, s);
    
    LLVMExecutionEngineRef ee;
    char *err = NULL;
    if (LLVMCreateExecutionEngineForModule(&ee, mod, &err) != 0) {
        FAIL("LLVM JIT", err);
        return;
    }
    
    LLVMGenericValueRef a[] = {
        LLVMCreateGenericValueOfInt(LLVMInt32TypeInContext(ctx), 5, 0),
        LLVMCreateGenericValueOfInt(LLVMInt32TypeInContext(ctx), 3, 0)
    };
    LLVMGenericValueRef res = LLVMRunFunction(ee, fn, 2, a);
    int r = (int)LLVMGenericValueToInt(res, 0);
    if (r == 8) PASS("add(5,3) = 8", 0);
    else FAIL("LLVM", "wrong result");
    
    LLVMDisposeExecutionEngine(ee);
    LLVMContextDispose(ctx);
}

/* ══════════════════════════════════════════════════════
 * 6-20: INLINE CACHE, GC, MEMORY
 * ══════════════════════════════════════════════════════ */

#include "kyjit_ic.h"

static void test_06_ic(void) {
    SECTION("5. INLINE CACHE");
    KyIC ic = {0};
    ky_ic_update_inline(&ic, 42, 16);
    double t0 = now_ns();
    int32_t off = ky_ic_lookup_inline(&ic, 42);
    double t1 = now_ns();
    if (off == 16) PASS("mono lookup", t1-t0);
    else FAIL("IC", "wrong");
    
    ky_ic_update_inline(&ic, 100, 32);
    ky_ic_update_inline(&ic, 200, 48);
    int32_t off2 = ky_ic_lookup_inline(&ic, 200);
    if (off2 == 48) PASS("poly lookup", 0);
    else FAIL("IC poly", "wrong");
}

#include "kyjit_gc.h"

static void test_07_gc(void) {
    SECTION("6. GENERATIONAL GC");
    kyjit_gc_heap_t *h = kyjit_gc_create();
    double t0 = now_ns();
    for (int i = 0; i < 100000; i++) kyjit_gc_alloc(h, 32);
    double t1 = now_ns();
    PASS("alloc 100K objects", t1-t0);
    
    kyjit_gc_collect(h, false);
    PASS("minor GC", 0);
    kyjit_gc_collect(h, true);
    PASS("major GC", 0);
    kyjit_gc_destroy(h);
}

typedef struct concurrent_gc concurrent_gc_t;
concurrent_gc_t* kyjit_gc_concurrent_create(kyjit_gc_heap_t*);
void kyjit_gc_concurrent_stop(concurrent_gc_t*);
int kyjit_gc_concurrent_collections(concurrent_gc_t*);

static void test_08_concurrent_gc(void) {
    SECTION("7. CONCURRENT GC");
    kyjit_gc_heap_t *h = kyjit_gc_create();
    concurrent_gc_t *gc = kyjit_gc_concurrent_create(h);
    for (int i = 0; i < 200000; i++) kyjit_gc_alloc(h, 32);
    struct timespec ts = {0, 10000000};
    nanosleep(&ts, NULL);
    int n = kyjit_gc_concurrent_collections(gc);
    if (n > 0) PASS("background collections", 0);
    else FAIL("concurrent GC", "no collections");
    kyjit_gc_concurrent_stop(gc);
    kyjit_gc_destroy(h);
}

