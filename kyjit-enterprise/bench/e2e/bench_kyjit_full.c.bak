#include "kyjit_wasm_exec.h"

static void test_20_wasm(void) {
    SECTION("19. WASM EXEC");
    uint8_t wasm[] = {
        0x00,0x61,0x73,0x6d,0x01,0x00,0x00,0x00,
        0x01,0x07,0x01,0x60,0x02,0x7f,0x7f,0x01,0x7f,
        0x03,0x02,0x01,0x00,
        0x07,0x07,0x01,0x03,0x61,0x64,0x64,0x00,0x00,
        0x0a,0x09,0x01,0x07,0x00,0x20,0x00,0x20,0x01,0x6a,0x0b
    };
    KyjitWasmExec *e = kyjit_wasm_exec_create();
    if (!e) { SKIP("wasm", "not linked"); return; }
    int rc = kyjit_wasm_exec_compile(e, wasm, sizeof(wasm));
    if (rc == 0) {
        PASS("wasm compile", 0);
        int32_t args[] = {5, 3};
        int32_t result = 0;
        kyjit_wasm_exec_call(e, "add", args, 2, &result);
        if (result == 8) PASS("wasm add(5,3)=8", 0);
    }
    kyjit_wasm_exec_free(e);
}

