#include "kyjit_blas_jit.h"

static void test_38_blas(void) {
    SECTION("37. BLAS JIT (OpenBLAS)");
    int N = 512;
    float *A = aligned_alloc(64, N*N*4);
    float *B = aligned_alloc(64, N*N*4);
    float *C = aligned_alloc(64, N*N*4);
    if (!A || !B || !C) { FAIL("blas", "alloc failed"); return; }
    for (int i = 0; i < N*N; i++) { A[i] = i%100; B[i] = (i+1)%100; }
    double t0 = now_ns();
    int rc = kyjit_blas_matmul_jit(A, B, C, N);
    double t1 = now_ns();
    if (rc == 0) PASS("matrix 512x512", t1-t0);
    else FAIL("blas", "failed");
    free(A); free(B); free(C);
}

#include "kyjit_mfr.h"

static void test_39_mfr(void) {
    SECTION("38. MFR (Map/Filter/Reduce)");
    int32_t *data = malloc(1000000 * 4);
    for (int i = 0; i < 1000000; i++) data[i] = i;
    double t0 = now_ns();
    long long r = kyjit_mfr_exec(data, 1000000);
    double t1 = now_ns();
    if (r != 0) PASS("MFR 1M", t1-t0);
    else FAIL("MFR", "wrong result");
    free(data);
}

