#include "kyjit_cpu_detect.h"

static void test_61_cpu(void) {
    SECTION("60. CPU DETECTION");
    const char *name = kyjit_cpu_name();
    int cores = kyjit_cpu_count();
    int avx2 = kyjit_cpu_has_avx2();
    if (name && cores > 0 && avx2) PASS("cpu detect", 0);
    else FAIL("cpu detect", "wrong");
}

