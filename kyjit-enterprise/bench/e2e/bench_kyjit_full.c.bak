}

#include "kyjit_cublas.h"

static void test_63_cublas(void) {
    SECTION("62. CUBLAS (CPU fallback)");
    int N = 256;
    float *A = aligned_alloc(64, N*N*4);
    float *B = aligned_alloc(64, N*N*4);
    float *C = aligned_alloc(64, N*N*4);
    for (int i = 0; i < N*N; i++) { A[i] = i%100; B[i] = (i+1)%100; }
    double t0 = now_ns();
    int rc = kyjit_cublas_matmul(A, B, C, N);
    double t1 = now_ns();
    if (rc == 0) PASS("cublas (fallback)", t1-t0);
    else FAIL("cublas", "failed");
    free(A); free(B); free(C);
}

